package render

import "oi/skills/convert-oi/internal/model"

func TypeToken(value model.ValueType) text {
    switch value {
    case model.ValueType.Text:
        return "text"
    case model.ValueType.Path:
        return "fs.Path"
    default:
        return "unit"
    }
}

func AuthorityToken(value model.Authority) text {
    switch value {
    case model.Authority.CallerReply:
        return "caller.reply"
    case model.Authority.WorkspaceRead:
        return "workspace.read"
    default:
        return "workspace.write"
    }
}

func Quote(value text) text {
    return "\"" + value + "\""
}

func ReferenceToken(value model.ValueReference) text {
    if value.Kind == model.ReferenceKind.Literal {
        return Quote(value.Literal.Value)
    }
    return value.Name.Value
}

func HasFilesystem(steps []model.Step) bool {
    for step in steps {
        if step.Action == model.ActionKind.Read || step.Action == model.ActionKind.Write {
            return true
        }
    }
    return false
}

func IncludesAuthority(authorities []model.Authority, wanted model.Authority) bool {
    for authority in authorities {
        if authority == wanted {
            return true
        }
    }
    return false
}

func StepByName(steps []model.Step, name model.Identifier) model.Step {
    for step in steps {
        if step.Name == name {
            return step
        }
    }
    return steps[0]
}

func TriggerByOrdinal(triggers []model.Predicate, ordinal int) model.Predicate {
    for trigger in triggers {
        if trigger.Ordinal == ordinal {
            return trigger
        }
    }
    return triggers[0]
}

func StepDefinition(step model.Step) text {
    if step.Action == model.ActionKind.Pass {
        return "func " + step.Name.Value + "(value " + TypeToken(step.Value.Type) + ") " + TypeToken(step.Result.Type) + " {\n" +
            "    return value\n}\n"
    }
    if step.Action == model.ActionKind.Read {
        return "func " + step.Name.Value + "(path fs.Path) text {\n    return fs.Read(path)\n}\n"
    }
    if step.Action == model.ActionKind.Write {
        return "func " + step.Name.Value + "(path fs.Path, content text) {\n    fs.Write(path, content)\n}\n"
    }
    if step.Action == model.ActionKind.Reply {
        return "func " + step.Name.Value + "(value text) {\n    Reply(Result(value))\n}\n"
    }
    return "func " + step.Name.Value + "() {\n    stop(" + Quote(step.Stop.Category.Value) + ", " + Quote(step.Stop.Detail.Value) + ")\n}\n"
}

func StepInvocation(step model.Step) text {
    call := step.Name.Value + "("
    if step.Action == model.ActionKind.Pass || step.Action == model.ActionKind.Reply {
        call = call + ReferenceToken(step.Value)
    }
    if step.Action == model.ActionKind.Read {
        call = call + ReferenceToken(step.Path)
    }
    if step.Action == model.ActionKind.Write {
        call = call + ReferenceToken(step.Path) + ", " + ReferenceToken(step.Content)
    }
    call = call + ")"
    if step.Result.Present {
        return step.Result.Name.Value + " := " + call
    }
    return call
}

func PredicateToken(predicate model.Predicate) text {
    return ReferenceToken(predicate.Left) + " == " + ReferenceToken(predicate.Right)
}

func Entry(behavior model.BehaviorModel) text {
    source := "package main\n"
    if HasFilesystem(behavior.Steps) {
        source = source + "\nimport \"std/fs\"\n"
    }
    source = source + "\ntype Result text [" + behavior.OutputContract.Value + "]\n\n"
    source = source + "effect Reply(value Result) unit {\n    uses caller.reply\n    contract [deliver {value} exactly once to the caller]\n}\n"
    for step in behavior.Steps {
        source = source + "\n" + StepDefinition(step)
    }
    source = source + "\nfunc main("
    inputIndex := 0
    for input in behavior.Inputs {
        if inputIndex != 0 {
            source = source + ", "
        }
        source = source + input.Name.Value + " " + TypeToken(input.Type)
        inputIndex = inputIndex + 1
    }
    source = source + ") {\n"
    for stepName in behavior.Unconditional {
        step := StepByName(behavior.Steps, stepName)
        source = source + "    " + StepInvocation(step) + "\n"
    }
    for branch in behavior.Branches {
        trigger := TriggerByOrdinal(behavior.Triggers, branch.Trigger)
        source = source + "    if " + PredicateToken(trigger) + " {\n"
        for stepName in branch.Steps {
            step := StepByName(behavior.Steps, stepName)
            source = source + "        " + StepInvocation(step) + "\n"
        }
        lastStep := StepByName(behavior.Steps, branch.Steps[len(branch.Steps) - 1])
        if lastStep.Action == model.ActionKind.Reply {
            source = source + "        return\n"
        }
        source = source + "    }\n"
    }
    source = source + "    stop(" + Quote(behavior.NoMatch.Category.Value) + ", " + Quote(behavior.NoMatch.Detail.Value) + ")\n}\n"
    return source
}

func Module(module model.SafeText) text {
    return "module " + module.Value + "\noi 0.0.1\n"
}

func Adapter(sourceSkill model.SourceSkill, behavior model.BehaviorModel) text {
    source := "---\nname: " + Quote(sourceSkill.Name.Value) + "\ndescription: " + Quote(sourceSkill.Description.Value) + "\n---\n\n# Converted Oi Skill\n\n"
    source = source + "Triggers:\n"
    for trigger in behavior.Triggers {
        source = source + "- `" + PredicateToken(trigger) + "`\n"
    }
    source = source + "\nLoad the local `using-oi` adapter with this directory's `oi.mod` and `main.oi`.\n"
    source = source + "Bind typed caller inputs in order:"
    for input in behavior.Inputs {
        source = source + " `" + input.Name.Value + " " + TypeToken(input.Type) + "`"
    }
    source = source + ".\nMap reachable effects:"
    effectCount := 0
    if IncludesAuthority(behavior.Authorities, model.Authority.CallerReply) {
        source = source + " concrete `Reply(Result)`"
        effectCount = effectCount + 1
    }
    for authority in behavior.Authorities {
        if authority != model.Authority.CallerReply {
            if effectCount != 0 {
                source = source + ","
            }
            source = source + " `" + AuthorityToken(authority) + "`"
            effectCount = effectCount + 1
        }
    }
    if effectCount == 0 {
        source = source + " none"
    }
    source = source + ".\nHost-invoke lowercase `main` and expose its single captured `Result` payload unchanged.\n"
    return source
}

func Recover(bundle model.Bundle) model.BundleRecovery {
    return [independently parse the exact UTF-8 LF bytes of {bundle.MainSource} under the loaded Oi 0.0.1 grammar and type rules without invoking Entry, Module, Adapter, or any source Skill;
        accept only package main; an std/fs import exactly when a recovered Read or Write exists; one named Result text contract; the exact concrete Reply uses caller.reply effect;
        then zero or more uniquely named helper functions in source order whose AST is exactly one of Pass returning its value,
        Read returning fs.Read(path), Write calling fs.Write(path, content), Reply calling Reply(Result(value)),
        or Stop calling stop with two quoted Safe literals;
        reject the exact Oi 0.0.1 keyword and intrinsic-call sets and the exact renderer-reserved identifiers
        underscore, main, Result, Reply, fs, caller, reply, value, path, and content for every recovered caller, helper, and result name;
        require one final lowercase resultless main with globally unique non-keyword, non-reserved typed text-or-fs.Path parameters,
        an ordered unconditional helper-call prefix, and ordered if branches whose predicates are input equals quoted Safe literal,
        whose bodies are ordered helper invocations with arguments that resolve only to parameters, earlier helper results, or quoted literals of the required type;
        derive authorities from reachable Reply, fs.Read, and fs.Write call ASTs; reject every other declaration, statement, expression,
        import, comment, blank-line position, unresolved reference, implicit conversion, or byte;
        require each branch operand to resolve only from caller inputs, the unconditional prefix, or a producer earlier in that branch;
        require each branch to contain exactly one final Reply followed only by renderer return, or one final Stop with no following statement;
        require declared authorities to equal the caller.reply, workspace.read, workspace.write UTF-8 ordered deduplicated union of reachable actions;
        recover exact caller inputs, predicates, step names, action kinds, structured operands and results,
        unconditional targets, branch targets, authorities, no-match stop, and output contract into one model.LoweredProgram
        with Identifier and SafeText Value wrappers;
        independently parse {bundle.ModuleSource} as exactly module SP validated-module-path LF oi SP 0.0.1 LF and no other byte;
        independently parse {bundle.AdapterSource} as the exact four-line frontmatter, Converted Oi Skill heading,
        ordered trigger bullets, fixed using-oi routing sentence,
        ordered typed-input bindings, exact reachable-effect mappings, and lowercase main dispatch sentence,
        all with the exact punctuation and LF layout shown by that closed adapter grammar;
        recover module, version, adapter name, description, ordered inputs, triggers, and authorities into typed Value wrappers without comparing text produced by any renderer;
        on any grammar, type, reference, order, artifact, or adapter mismatch return Valid false with ordered GENERATED_ARTIFACT_INVALID diagnostics and a zero program;
        otherwise return Valid true with recovered typed values and no diagnostics]
}
