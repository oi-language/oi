package convert

import "std/diagnostic"
import "std/fs"
import "oi/skills/convert-oi/internal/inspect"
import "oi/skills/convert-oi/internal/model"
import "oi/skills/convert-oi/internal/proof"
import "oi/skills/convert-oi/internal/publish"
import "oi/skills/convert-oi/internal/render"
import "oi/skills/convert-oi/internal/report"

type Mode enum {
    Preview
    Apply
}

func ValidTargetVersion(value text) bool {
    return value == "0.0.1" || value == "0.0.2"
}

func Target(value text) model.TargetVersion {
    if value == "0.0.1" {
        return model.TargetVersion.V001
    }
    return model.TargetVersion.V002
}

func ValidModule(module text, target model.TargetVersion) bool {
    return [whether {module} for {target} is one or more nonempty slash-separated Oi module path segments with no slash edge, empty segment, backslash,
        dot segment, or dot-dot segment; V001 permits only ASCII alphanumeric, underscore, or hyphen in each segment;
        V002 also permits dot but never at a segment edge or repeated]
}

func ModuleValue(module text) model.SafeText {
    return model.SafeText{Value: module}
}

func Issue(category text, phase text, location text, detail text) diagnostic.Diagnostic {
    return diagnostic.New(category, phase, location, detail)
}

func Failed(
    behavior model.BehaviorModel?,
    bundle model.Bundle?,
    exactProof text?,
    diagnostics []diagnostic.Diagnostic,
) report.ConversionReport {
    return report.Failed(
        behavior, bundle, exactProof, 0, 0, []fs.Path{}, []fs.Path{}, true, none, diagnostics,
    )
}

func CreateBundle(
    sourceSkill model.SourceSkill,
    behavior model.BehaviorModel,
    module model.SafeText,
    target model.TargetVersion,
) model.Bundle {
    return model.Bundle{
        MainSource: render.Entry(behavior),
        ModuleSource: render.Module(module, target),
        AdapterSource: render.Adapter(sourceSkill, behavior),
    }
}

func Convert(
    source fs.Path,
    destination fs.Path,
    module text,
    targetVersion text,
    mode Mode,
    suppliedProof text?,
) report.ConversionReport {
    if !ValidTargetVersion(targetVersion) {
        return Failed(none, none, none, []diagnostic.Diagnostic{Issue(
            "CONVERSION_TARGET_VERSION",
            "input binding",
            "main.oi:12:6",
            "target version must be exactly 0.0.1 or 0.0.2",
        )})
    }
    target := Target(targetVersion)
    if !ValidModule(module, target) {
        return Failed(none, none, none, []diagnostic.Diagnostic{
            Issue("CONVERSION_INVALID_MODULE", "conversion", "oi.mod:1:1", module),
        })
    }
    sourceRead := inspect.ReadSource(source)
    if len(sourceRead.Diagnostics) != 0 {
        return Failed(none, none, none, sourceRead.Diagnostics)
    }
    destinationRead := publish.ReadDestination(destination)
    if len(destinationRead.Diagnostics) != 0 {
        return Failed(none, none, none, destinationRead.Diagnostics)
    }
    sourceSkill := inspect.ParseSkill(sourceRead.Content)
    if len(sourceSkill.Diagnostics) != 0 {
        return Failed(none, none, none, sourceSkill.Diagnostics)
    }
    inspection := inspect.Extract(sourceSkill)
    behavior := inspection.Behavior
    if len(behavior.Diagnostics) != 0 {
        return Failed(behavior, none, none, behavior.Diagnostics)
    }
    hiddenDiagnostics := proof.HiddenDiagnostics(inspection.Findings)
    if len(hiddenDiagnostics) != 0 {
        return Failed(behavior, none, none, hiddenDiagnostics)
    }
    diagnostics := proof.Validate(behavior, target)
    if len(diagnostics) != 0 {
        return Failed(behavior, none, none, diagnostics)
    }
    typedModule := ModuleValue(module)
    bundle := CreateBundle(sourceSkill, behavior, typedModule, target)
    preservation := proof.PreservationDiagnostics(sourceSkill, behavior, typedModule, target, bundle)
    if len(preservation) != 0 {
        return Failed(behavior, bundle, none, preservation)
    }
    exactProof := proof.Build(source, sourceRead.Content, destinationRead.Observation, module, target, bundle)
    if mode == Mode.Preview {
        return report.Passed(
            behavior, bundle, exactProof, 0, 0, []fs.Path{}, []fs.Path{}, true, none,
        )
    }
    if !publish.ExactProof(suppliedProof, exactProof) {
        return Failed(behavior, bundle, exactProof, []diagnostic.Diagnostic{Issue(
            "CONVERSION_CONFIRMATION_MISMATCH",
            "conversion",
            publish.PathText(destination),
            "proof does not match current preview",
        )})
    }
    return publish.Publish(source, sourceRead.Content, destinationRead.Observation, behavior, bundle, exactProof)
}
