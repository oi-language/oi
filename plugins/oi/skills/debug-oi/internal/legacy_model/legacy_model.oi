package legacy_model

import "std/diagnostic"
import "oi/skills/debug-oi/internal/model"
import "oi/skills/debug-oi/internal/report"

type Value struct {
    TypeID int
    Canonical text
    NamedIdentity model.TypeIdentity?
}

type ValueResult struct {
    Value Value?
    Failure diagnostic.Diagnostic?
}

type SlotValue struct {
    SlotID int
    Value Value?
}

type Counter struct {
    Key text
    Next int
}

type TaskStatus enum {
    Runnable
    Running
    Blocked
    Completed
    Failed
    Cancelled
}

type BlockKind enum {
    None
    Await
    Join
    Send
    Receive
    Select
}

type Activation struct {
    TaskID text
    ID text
    FunctionID int
    PC int
    Slots []SlotValue
    EffectEncounter int
    ChannelCreation int
    SelectEncounter int
    LaunchedTaskIDs []text
}

type Frame struct {
    Activation Activation
    ReturnSlot int?
    Completion model.Completion?
    CallLocation text?
}

type TaskState struct {
    ID text
    ParentTaskID text
    SourceIndex int
    OwnerActivationID text
    LaunchLocation text
    Status TaskStatus
    Frames []Frame
    InitialArguments []Value
    Started bool
    BlockKind BlockKind
    BlockLocation text
    BlockChannelID text?
    BlockTaskID text?
    BlockSequence int
    ReadySequence int
    TerminalSequence int
    Value Value?
    Failure diagnostic.Diagnostic?
    Observed bool
}

type Message struct {
    ID text
    Value Value
    ReadySequence int
}

type ChannelState struct {
    ID text
    Capacity int
    Messages []Message
    SenderCopy int
    SenderIDs []text
    MessageCommit int
    FreeSequence int
    ReceiverHolder text
}

type Machine struct {
    Events []report.Event
    RequiredTranscriptEntries []text
    UsedTranscriptIDs []text
    Tasks []TaskState
    Channels []ChannelState
    ActivationCounters []Counter
    JournalIndex int
    NextReadySequence int
    NextBlockSequence int
    NextStateSequence int
    LastSelectLocation text
}

type RunResult struct {
    Machine Machine
    Value Value?
    Failure diagnostic.Diagnostic?
    Incomplete bool
}

type Transition struct {
    Machine Machine
    Activation Activation
    Failure diagnostic.Diagnostic?
    Blocked bool
    BlockKind BlockKind
    BlockLocation text
    BlockChannelID text?
    BlockTaskID text?
}

type Selection struct {
    CaseIndex int
    RelatedIdentity text?
}

type SelectionDecode struct {
    Valid bool
    SelectID text
    CaseIndex int
    RelatedIdentity text?
}

type ArgumentCrossing struct {
    Machine Machine
    Values []Value
    SourceSlots []SlotValue
}
