package legacy_validate

import "std/diagnostic"
import "oi/skills/debug-oi/internal/model"

func Plan(program model.Program, initialSlots []model.InitialSlot, journal []text, transcript []model.LegacyEffectResult) diagnostic.Diagnostic? {
    return [none exactly when {program}, {initialSlots}, {journal}, and {transcript} form one closed released Oi 0.0.1 debugger input; otherwise the single deterministic first debug Diagnostic:
        IDs are unique nonnegative and references in range; there is one entry; ModuleIdentity ordinals are contiguous and path segments valid; NamedType identities are unique and match Named TypeRefs;
        primitive TypeRefs have all inactive fields empty; Named has Name, UnderlyingTypeID and NamedIdentity; unary containers have only ElementTypeID; Struct has paired unique fields; Enum has unique labels;
        every Slot/Function/Instruction/control-flow/owner/result edge is compatible and each instruction has exactly its matching payload with inactive optionals absent;
        InitialSlots cover entry parameters once in declaration order with exact SlotID/TypeID/canonical/named identity; no raw Binding or contract remains;
        literals, operands, selectors, completions, select cases, computes, stores, calls, effects, launches, awaits, joins, channels, sends, receives, returns and stops obey all frozen union/arity/type/affinity rules;
        every Function EntryLocation is its declaration first-token Location; every EffectSite StaticCallsiteID equals its exact frozen SourcePosition Location text;
        fixture locations retain the testdata/<fixture>/main.oi namespace despite local version manifests;
        Returned transcript entries have one LegacyEffectValue and no Failure; Failed entries have one Failure and no Value; OperationIDs are unique; journal records are canonical released channel records;
        choose the source-earliest invalid field and never invoke target code, an effect, user interaction, hidden dispatch, or ambient context]
}
