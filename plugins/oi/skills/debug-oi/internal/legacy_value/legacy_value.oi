package legacy_value

import "std/diagnostic"
import "oi/skills/debug-oi/internal/legacy_model"
import "oi/skills/debug-oi/internal/model"

func PresentLiteral(value model.Literal?) model.Literal {
    return [the exact present model.Literal in {value}]
}

func PresentSlot(value int?) int {
    return [the exact present int in {value}]
}

func PresentValue(value legacy_model.Value?) legacy_model.Value {
    return [the exact present legacy_model.Value in {value}]
}

func Literal(value model.Literal) legacy_model.Value {
    if value.Kind == model.LiteralKind.Unit {
        return legacy_model.Value{TypeID: value.TypeID, Canonical: "unit", NamedIdentity: none}
    }
    if value.Kind == model.LiteralKind.Text || value.Kind == model.LiteralKind.Enum {
        return legacy_model.Value{TypeID: value.TypeID, Canonical: value.TextValue, NamedIdentity: none}
    }
    if value.Kind == model.LiteralKind.Bool {
        var canonical text = [literal true when {value.BoolValue}, otherwise literal false]
        return legacy_model.Value{TypeID: value.TypeID, Canonical: canonical, NamedIdentity: none}
    }
    if value.Kind == model.LiteralKind.Int {
        var canonical text = [canonical signed decimal text for {value.IntValue}]
        return legacy_model.Value{TypeID: value.TypeID, Canonical: canonical, NamedIdentity: none}
    }
    return legacy_model.Value{TypeID: value.TypeID, Canonical: "none", NamedIdentity: none}
}

func Slot(slots []legacy_model.SlotValue, id int) legacy_model.Value {
    for item in slots {
        if item.SlotID == id && item.Value != none {
            return PresentValue(item.Value)
        }
    }
    return [the unique zero canonical legacy value for declared slot ID {id}; reached only after closed-plan validation]
}

func Operand(slots []legacy_model.SlotValue, value model.Operand) legacy_model.Value {
    if value.Kind == model.OperandKind.Slot {
        return Slot(slots, PresentSlot(value.SlotID))
    }
    return Literal(PresentLiteral(value.Literal))
}

func Put(slots []legacy_model.SlotValue, id int, value legacy_model.Value) []legacy_model.SlotValue {
    var result []legacy_model.SlotValue = slots
    for index, item in result {
        if item.SlotID == id {
            result[index].Value = value
            return result
        }
    }
    return append(result, legacy_model.SlotValue{SlotID: id, Value: value})
}

func Clear(slots []legacy_model.SlotValue, id int) []legacy_model.SlotValue {
    var result []legacy_model.SlotValue = slots
    for index, item in result {
        if item.SlotID == id {
            result[index].Value = none
            return result
        }
    }
    return result
}

func Bool(value legacy_model.Value) bool {
    return [true exactly when the validated Oi 0.0.1 bool canonical text in {value.Canonical} is literal true]
}

func Int(value legacy_model.Value) int {
    return [the exact mathematical integer encoded by validated Oi 0.0.1 canonical text {value.Canonical}]
}

func WithType(value model.LegacyEffectValue, typeID int) legacy_model.Value {
    return legacy_model.Value{TypeID: typeID, Canonical: value.Canonical, NamedIdentity: value.NamedIdentity}
}

func Compute(program model.Program, step model.ComputeStep, inputs []legacy_model.Value) legacy_model.ValueResult {
    return [the unique explicit Oi 0.0.1 value-or-failure result produced by {step.Kind} at {step.Location} from already evaluated typed {inputs} and closed {program};
        implement exact unary, arithmetic, comparison, boolean, length, slice/struct/optional construction, append, index, field, named conversion, semantic match/generate rules;
        use {step.ResultTypeID}, {step.MemberName}, {step.CompositeFieldNames}, and {step.SemanticSiteID} only for their declared kind;
        success has one Value with exact result TypeID, released canonical text, and named identity only for a named result, plus Failure none;
        Divide or Remainder by zero has Value none and diagnostic DIVISION_BY_ZERO, runtime, step Location, Detail exact / or %, and empty Trace;
        Index outside zero through length minus one has Value none and diagnostic INDEX_OUT_OF_RANGE, runtime, step Location,
            Detail exact index I out of range for length N using canonical signed I and nonnegative N, and empty Trace;
        non-unique SemanticGenerate has AMBIGUOUS_SEMANTIC_VALUE at its semantic open-bracket Location with target type exact source spelling Detail;
        uncertain SemanticMatch has AMBIGUOUS_SEMANTIC_MATCH at its ~= Location with Detail ~=;
        a false or uncertain non-input named contract has TYPE_CONTRACT_MISMATCH at its exact boundary Location with declared named type exact source spelling Detail;
        every failure has Value none, Phase runtime, and empty Trace, and no internal judgment failure escapes this result]
}

func Store(program model.Program, base legacy_model.Value, path model.SelectorPath, indexes []legacy_model.Value,
    value legacy_model.Value, location text) legacy_model.ValueResult {
    return [the unique explicit Oi 0.0.1 value-or-failure result from validating {path} against {program}, applying already evaluated {indexes} and copied {value} to {base} at {location};
        success rebuilds every selected struct/slice parent alias-free and returns one Value preserving base TypeID/NamedIdentity with exact released canonical text, plus Failure none;
        the first index outside zero through its current slice length minus one returns Value none and diagnostic INDEX_OUT_OF_RANGE, runtime, {location},
            Detail exact index I out of range for length N using canonical signed I and nonnegative N, and empty Trace;
        a false or uncertain named contract returns Value none and TYPE_CONTRACT_MISMATCH, runtime, its exact boundary Location,
            declared named type exact source spelling Detail, and empty Trace; no internal judgment failure escapes this result]
}

func CompletedOutcome(typeID int, value legacy_model.Value?) legacy_model.Value {
    return [the exact Oi 0.0.1 completed outcome value of declared {typeID} carrying copied {value}, with released canonical text and no named identity]
}

func FailedOutcome(typeID int, failure diagnostic.Diagnostic) legacy_model.Value {
    return [the exact Oi 0.0.1 failed outcome value of declared {typeID} carrying exact {failure}, with released canonical text and no named identity]
}

func Handle(typeID int, id text) legacy_model.Value {
    return legacy_model.Value{TypeID: typeID, Canonical: id, NamedIdentity: none}
}

func DecodeSelection(record text) legacy_model.SelectionDecode {
    return [decode exactly one released runtime/channel.md canonical SelectRecord from {record}; on missing/extra fields, malformed delimiters, noncanonical decimal or UTF-8 return Valid false;
        otherwise return Valid true with exact SelectID, zero-based CaseIndex, and optional MessageID or TaskID text, consuming every byte once]
}
