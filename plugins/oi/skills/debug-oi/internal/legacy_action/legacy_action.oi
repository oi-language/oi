package legacy_action

import "oi/skills/debug-oi/internal/legacy_channel"
import "oi/skills/debug-oi/internal/legacy_model"
import "oi/skills/debug-oi/internal/legacy_step"
import "oi/skills/debug-oi/internal/legacy_value"
import "oi/skills/debug-oi/internal/model"
import "oi/skills/debug-oi/internal/report"

func Values(slots []legacy_model.SlotValue, operands []model.Operand) []legacy_model.Value {
    var result []legacy_model.Value = []legacy_model.Value{}
    for operand in operands {
        result = append(result, legacy_value.Operand(slots, operand))
    }
    return result
}

func Type(program model.Program, typeID int) model.TypeRef {
    for item in program.Types {
        if item.ID == typeID {
            return item
        }
    }
    return [the unique validated TypeRef for {typeID}]
}

func Cross(program model.Program, machine legacy_model.Machine, slots []legacy_model.SlotValue,
    operands []model.Operand, destinationOwner text, destinationSlots []int) legacy_model.ArgumentCrossing {
    var values []legacy_model.Value = []legacy_model.Value{}
    var sourceSlots []legacy_model.SlotValue = slots
    for index, operand in operands {
        var value legacy_model.Value = legacy_value.Operand(slots, operand)
        if Type(program, value.TypeID).Kind == model.TypeKind.Sender {
            var copied legacy_model.ArgumentCrossing = legacy_channel.CopySender(machine, value)
            machine = copied.Machine
            value = copied.Values[0]
        } else if Type(program, value.TypeID).Kind == model.TypeKind.Receiver {
            sourceSlots = legacy_value.Clear(sourceSlots, legacy_step.PresentInt(operand.SlotID))
            machine = legacy_channel.MoveReceiver(machine, value,
                legacy_channel.ReceiverHolder(destinationOwner, destinationSlots[index]))
        }
        values = append(values, value)
    }
    return legacy_model.ArgumentCrossing{Machine: machine, Values: values, SourceSlots: sourceSlots}
}

func BranchLocation(program model.Program, condition model.Operand, function model.Function) text {
    if condition.Kind == model.OperandKind.Slot {
        return legacy_step.SlotLocation(program, legacy_step.PresentInt(condition.SlotID))
    }
    return function.EntryLocation
}

func Advance(program model.Program, function model.Function, machine legacy_model.Machine, activation legacy_model.Activation,
    instruction model.Instruction) legacy_model.Transition {
    if instruction.Kind == model.InstructionKind.Bind {
        var step model.BindStep = legacy_step.PresentBind(instruction.Bind)
        var value legacy_model.Value = legacy_value.Operand(activation.Slots, step.Source)
        if Type(program, value.TypeID).Kind == model.TypeKind.Sender {
            var copied legacy_model.ArgumentCrossing = legacy_channel.CopySender(machine, value)
            machine = copied.Machine
            value = copied.Values[0]
        } else if Type(program, value.TypeID).Kind == model.TypeKind.Receiver {
            activation.Slots = legacy_value.Clear(activation.Slots, legacy_step.PresentInt(step.Source.SlotID))
            machine = legacy_channel.MoveReceiver(machine, value,
                legacy_channel.ReceiverHolder(activation.ID, step.DestinationSlot))
        }
        activation.Slots = legacy_value.Put(activation.Slots, step.DestinationSlot, value)
        machine = legacy_step.AddEvent(machine, report.EventKind.Bind, legacy_step.SlotLocation(program, step.DestinationSlot), value.Canonical)
        activation.PC = step.Continuation
    } else if instruction.Kind == model.InstructionKind.Store {
        var step model.StoreStep = legacy_step.PresentStore(instruction.Store)
        var indexes []legacy_model.Value = []legacy_model.Value{}
        for selector in step.Path.Items {
            if selector.Kind == model.SelectorKind.Index {
                indexes = append(indexes, legacy_value.Operand(activation.Slots, legacy_step.PresentOperand(selector.Index)))
            }
        }
        var base legacy_model.Value = legacy_value.Slot(activation.Slots, step.BaseSlot)
        var stored legacy_model.ValueResult = legacy_value.Store(program, base, step.Path, indexes,
            legacy_value.Operand(activation.Slots, step.Value), step.Location)
        if stored.Failure != none {
            return legacy_model.Transition{Machine: machine, Activation: activation,
                Failure: stored.Failure, Fatal: none, Blocked: false, BlockKind: legacy_model.BlockKind.None,
                BlockLocation: "", BlockChannelID: none, BlockTaskID: none}
        }
        activation.Slots = legacy_value.Put(activation.Slots, step.BaseSlot, legacy_value.PresentValue(stored.Value))
        activation.PC = step.Continuation
    } else if instruction.Kind == model.InstructionKind.Compute {
        var step model.ComputeStep = legacy_step.PresentCompute(instruction.Compute)
        var value legacy_model.ValueResult = legacy_value.Compute(program, step, Values(activation.Slots, step.Inputs))
        if value.Failure != none {
            return legacy_model.Transition{Machine: machine, Activation: activation,
                Failure: value.Failure, Fatal: none, Blocked: false, BlockKind: legacy_model.BlockKind.None,
                BlockLocation: "", BlockChannelID: none, BlockTaskID: none}
        }
        activation.Slots = legacy_value.Put(activation.Slots, step.ResultSlot, legacy_value.PresentValue(value.Value))
        activation.PC = step.Continuation
    } else if instruction.Kind == model.InstructionKind.Branch {
        var step model.BranchStep = legacy_step.PresentBranch(instruction.Branch)
        var choice bool = legacy_value.Bool(legacy_value.Operand(activation.Slots, step.Condition))
        var detail text = [literal true when {choice}, otherwise literal false]
        machine = legacy_step.AddEvent(machine, report.EventKind.Branch, BranchLocation(program, step.Condition, function), detail)
        if choice {
            activation.PC = step.TrueTarget
        } else {
            activation.PC = step.FalseTarget
        }
    } else {
        activation.PC = legacy_step.PresentJump(instruction.Jump).Target
    }
    return legacy_model.Transition{Machine: machine, Activation: activation, Failure: none, Fatal: none, Blocked: false,
        BlockKind: legacy_model.BlockKind.None, BlockLocation: "", BlockChannelID: none, BlockTaskID: none}
}
