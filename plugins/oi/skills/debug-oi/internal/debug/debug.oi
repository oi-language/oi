effect CompileTarget(target fs.Path, bindings []Binding) LoadPlan {
    uses tool.compile
    contract [invoke the host shared exact Oi 0.0.1 compile and entry-binding oracle on {target} and complete {bindings}, without executing target entry or effects;
        compile, type-check, and then perform input count/name/type decoding and every named contract crossing under execution.md before returning one typed LoadPlan;
        lower every execution.md ordinary expression to Operand, Compute, or its dedicated call/runtime step and lower conditionals, switch, and loops to Branch and Jump;
        lower whole-slot assignment to Bind and every field or index lvalue assignment, including dynamic slice index, to Store with no opaque expression or text protocol;
        Invalid has BindingStatus NotRun, zero Program with empty Modules, NamedTypes, Types, Slots, Functions and EntryFunctionID zero, empty InitialSlots and BindingDiagnostics, plus ordered load Diagnostics;
        Valid with Crossed has one closed Program, exactly one typed InitialSlot per entry parameter, and empty Diagnostics and BindingDiagnostics;
        Valid with Rejected retains that same deterministic closed Program, has empty InitialSlots and Diagnostics, and has ordered exact input-binding or TYPE_CONTRACT_MISMATCH BindingDiagnostics;
        TypeIdentity never contains contract content; two source snapshots with the same identity but different contracts may return Crossed versus Rejected only by oracle evaluation;
        reject any invalid typed union, nonzero inactive payload, dangling type/instruction edge, unsupported expression, or inconsistent LoadPlan status]
}

func OperationID(identity OperationIdentity) text {
    return [the unique canonical concatenation of {identity.TaskID}, one vertical bar, {identity.ActivationID}, one vertical bar,
        {identity.StaticCallsiteID}, one vertical bar, and canonical positive decimal {identity.EncounterIndex};
        TaskID, ActivationID, and StaticCallsiteID never contain vertical bar;
        EncounterIndex is the one-based source-order dynamic encounter of any EffectStep within that activation, including repeated visits to one callsite]
}

func ChannelID(identity ChannelIdentity) text {
    return [the exact concatenation {identity.ActivationID}, literal /c, and canonical zero-based decimal {identity.CreationIndex} from runtime/channel.md]
}

func SenderID(identity SenderIdentity) text {
    return [the exact concatenation ChannelID({identity.Channel}), literal /s, and canonical nonnegative decimal {identity.CopyIndex} from runtime/channel.md]
}

func ReceiverID(identity ReceiverIdentity) text {
    return [the exact concatenation ChannelID({identity.Channel}) and literal /r0 from runtime/channel.md]
}

func MessageID(identity MessageIdentity) text {
    return [the exact concatenation ChannelID({identity.Channel}), literal /m, and canonical zero-based decimal {identity.CommitIndex} from runtime/channel.md]
}

func SelectID(identity SelectIdentity) text {
    return [the exact concatenation {identity.ActivationID}, literal /select, and canonical zero-based decimal {identity.EncounterIndex} from runtime/channel.md]
}

func SelectRecord(identity SelectIdentity, chosenCase int, relatedIdentity text?) text {
    return [the sole external text encoding of runtime/channel.md typed record \{SelectID, ChosenCase, MessageID|TaskID\}:
        literal open brace, SelectID({identity}), comma, canonical nonnegative decimal {chosenCase}, comma, exact {relatedIdentity} when present, then literal close brace;
        ChannelID, SelectID, MessageID, and TaskID contain no comma or brace, and default has no related identity between the final comma and close brace]
}

func EffectDiagnostic(cause failure) diagnostic.Diagnostic {
    return diagnostic.Diagnostic{
        Category: cause.Category,
        Phase: cause.Phase,
        Location: cause.Location,
        Detail: cause.Detail,
        Trace: cause.Trace,
    }
}

func AppendFrame(item diagnostic.Diagnostic, frame text) diagnostic.Diagnostic {
    return diagnostic.Diagnostic{
        Category: item.Category,
        Phase: item.Phase,
        Location: item.Location,
        Detail: item.Detail,
        Trace: append(item.Trace, frame),
    }
}

func CallFailure(item diagnostic.Diagnostic, location text) diagnostic.Diagnostic {
    var frame text = [the exact concatenation call@<location> with <location> replaced by {location}]
    return AppendFrame(item, frame)
}

func AwaitFailure(item diagnostic.Diagnostic, location text) diagnostic.Diagnostic {
    var frame text = [the exact concatenation await@<location> with <location> replaced by {location}]
    return AppendFrame(item, frame)
}

func JoinFailure(item diagnostic.Diagnostic, location text) diagnostic.Diagnostic {
    var frame text = [the exact concatenation implicit-join@<location> with <location> replaced by {location}]
    return AppendFrame(item, frame)
}

func Execute(program Program, initialSlots []InitialSlot, journal []text, transcript []EffectResult) Execution {
    return [validate and interpret only closed typed {program} with already-crossed {initialSlots}, supplied {journal}, and {transcript} under exact Oi 0.0.1 shards;
        first require unique nonnegative IDs, every reference in range, one entry, and compatible TypeRef, Slot, Function, Instruction, control-flow, owner, and result edges;
        a primitive TypeRef has empty Name, no UnderlyingTypeID, NamedIdentity, or ElementTypeID, and empty field/enum slices;
        Named has nonempty display Name plus exactly one UnderlyingTypeID and structured NamedIdentity; Slice, Optional, Task, Outcome, Channel, Sender, and Receiver have only ElementTypeID;
        Struct has only equal-length unique FieldNames and FieldTypeIDs; Enum has only nonempty unique EnumLabels; all TypeRef inactive payloads have deterministic zero values;
        ModuleIdentity ordinals are contiguous from zero with nonempty valid PathSegments; every NamedType identity is nonnegative, unique, and references its module ordinal;
        each NamedType NamedTypeID and UnderlyingTypeID match one Named TypeRef and its underlying edge; each NamedIdentity occurs exactly once in NamedTypes;
        TypeIdentity is only module and declaration identity and never contains or selects a semantic contract; Name and DeclarationLocation are non-authoritative display data;
        InitialSlots exactly cover entry ParameterSlots once in declaration order; each SlotID, TypeID, canonical value, and optional NamedIdentity already passed shared-oracle binding;
        a Named InitialSlot has its TypeRef NamedIdentity and every other InitialSlot has none; Execute never receives raw Binding.Value and never evaluates an entry contract;
        EffectResult exactly matches Kind: Returned has one Value and zero Failure, Failed has one Failure and zero Value; EffectValue NamedIdentity follows its result TypeRef;
        Literal Unit and None have empty TextValue, false BoolValue, and zero IntValue; Text and Enum use only TextValue, Bool only BoolValue, Int only IntValue;
        Operand Slot has only SlotID and Literal none while Operand Literal has only Literal and SlotID none; every inactive Operand payload is none;
        Field and Index exist only as ComputeKind, never as an alternate Operand path;
        Selector Field has nonempty FieldName and Index none while Selector Index has FieldName none and one typed Index Operand; every inactive Selector payload is none;
        Store has a mutable BaseSlot, nonempty SelectorPath, typed Value, exact Location and Continuation; each path hop is a valid struct field or current slice index;
        Completion Propagate has OutcomeSlot none while Capture has one correctly typed OutcomeSlot;
        SelectCase Send has channel, sender endpoint, and Value only; Receive has channel/receiver and optional ResultSlot only; Await has handle and optional ResultSlot only;
        each SelectCase has Location and Target, with every payload forbidden by its Kind set to none; Instruction likewise has exactly its Kind payload and deterministic zero inactive payloads;
        validate CallStep arguments and ReturnSlot against the callee, task owner and handle affinity, channel identity and endpoint ownership, and every referenced location;
        ComputeStep ResultSlot has ResultTypeID equal to that Slot's TypeRef; Inputs have exact arity and types for Kind and every non-applicable metadata field has its zero value;
        MemberName is present only for Field; CompositeFieldNames is nonempty only for nonempty StructConstruct; SemanticSiteID is present only for SemanticGenerate or SemanticMatch;
        unary, Length, Field, Convert, and SemanticMatch have one Input; binary, BooleanAnd, BooleanOr, Append, and Index have two; SemanticGenerate has none;
        SliceConstruct has any homogeneous input count, StructConstruct fields exactly match Inputs and result declaration, and OptionalConstruct has zero or one compatible Input;
        Jump has only its in-function Target; every Instruction has exactly one matching named optional payload, including Store, Compute, and Jump, and all other optional payloads none;
        invalid caller data or plan structure yields one deterministic Diagnostic before target events; never invoke target main, ordinary function, effect, subagent, handoff, user interaction, or host effect;
        root TaskID is root and each task entry ActivationID is TaskID/a0; later ordinary calls in that task receive TaskID/aN in statement/operand order with zero-based canonical N;
        a launch receives runtime/oi.md TaskID from OwnerFunctionID, owner activation, and SourceIndex; its entry activation is TaskID/a0 and its handle remains owned by the launching activation;
        evaluate Operand values through typed Slots and Literals; BindStep alone handles whole-slot definition/assignment and writes only DestinationSlot; Jump transfers only to Target;
        Store evaluates BaseSlot and selector index operands left-to-right, then Value; it range-checks against the current slice length and follows declared field types;
        Store then rebuilds the selected nested copied value, writes it once to BaseSlot, produces no expression result, and continues; failure leaves BaseSlot unchanged;
        Compute uniquely interprets UnaryNot and UnaryNegate; Multiply, Divide, Remainder, Add, and Subtract; Equal, NotEqual, Less, LessEqual, Greater, and GreaterEqual;
        Compute also interprets SemanticMatch, BooleanAnd, BooleanOr, Length, SliceConstruct, StructConstruct, OptionalConstruct, Append, Index, Field, Convert, and SemanticGenerate;
        use exact execution.md types, integer and UTF-8 rules, bounds/failure rules, left-to-right inputs, short-circuit lowering, composite field order, conversion identity, and canonical result value;
        literal/enum/none/unit and parentheses lower directly to Operand; calls, effects, capture, oi, await, channel, send, and receive lower to their dedicated typed steps;
        if, switch, and every loop lower only to Compute plus Branch and Jump control flow; no expression meaning remains in Name, Location, Event Detail, or free semantic text;
        CallStep evaluates Arguments left-to-right, runs the callee activation, writes its ReturnStep value to ReturnSlot, then continues;
        Propagate appends CallFailure at each ordinary call boundary; Capture writes one typed outcome to Completion.OutcomeSlot and resumes without propagating;
        for every reached EffectStep increment the activation-wide source-order dynamic encounter counter, build OperationIdentity, and use OperationID as the Event Detail and transcript key;
        require exactly one EffectResult for each reached dynamic OperationIdentity and reject duplicate or unused IDs; a missing ID is appended once in execution order to RequiredTranscriptEntries and stops dependent work;
        a supplied effect Failure begins at EffectSite.Location; ordinary call propagation uses CallFailure, explicit AwaitStep propagation uses AwaitFailure, and JoinStep uses JoinFailure at its exact Location;
        never propagate a supplied failure unchanged across call, await, or implicit join; a Capture completion preserves the diagnostic plus frames already added inside the captured expression as an outcome value;
        LaunchStep records exact owner activation and handle; AwaitStep accepts only that owner; JoinStep observes its unobserved handles by SourceIndex and cancels only greater-index siblings after selecting the first failure;
        successful ChannelStep creations receive zero-based ChannelIdentity CreationIndex within their activation; initial sender/receiver are s0/r0 and committed copies get SenderIdentity sN from one;
        each channel successful send commit receives zero-based MessageIdentity CommitIndex independent of sender; blocked, cancelled, or nonchosen sends allocate no ID;
        SendStep and ReceiveStep resolve their ChannelSlot and endpoint identity; one SenderID is FIFO while journal order decides cross-sender readiness and commit;
        each SelectStep dynamic encounter receives zero-based SelectIdentity EncounterIndex within its activation, evaluates handles once in source order, and consumes supplied readiness order;
        before its branch consume exactly the SelectRecord external encoding of typed \{SelectID, ChosenCase, MessageID|TaskID\}; reject any noncanonical or identity-mismatched text;
        default names none, send reserves MessageID, receive names MessageID, and await names TaskID; ChannelID, SenderID, MessageID, and SelectID never create a second identity;
        if the shared oracle reports the channel shard missing, LoadPlan is Invalid and no ChannelStep executes or journal schema is inferred;
        emit contiguous one-based report Events: Enter Detail is ActivationID, Bind and Return Detail is the canonical typed value, Branch Detail is true or false, Effect Detail is OperationID,
        Launch and Await Detail is TaskID, Send and Receive Detail is the canonical typed value, and Stop Detail is the exact category;
        Event Location comes only from the matching typed step; a unit Return Detail is unit;
        identical Program, initialSlots, journal, and transcript values produce structurally equal Events, Diagnostics, RequiredTranscriptEntries, activation identities, and missing operation IDs]
}

func Result(execution Execution) report.DebugTrace {
    if len(execution.RequiredTranscriptEntries) != 0 {
        return report.Waiting(execution.Events, execution.RequiredTranscriptEntries)
    }
    if len(execution.Diagnostics) != 0 {
        return report.Failed(execution.Events, execution.Diagnostics)
    }
    return report.Passed(execution.Events)
}

func Trace(target fs.Path, bindings []Binding, journal []text, transcript []EffectResult) report.DebugTrace {
    var compileResult outcome[LoadPlan] = capture(CompileTarget(target, bindings))
    if compileResult.Ok {
        var plan LoadPlan = compileResult.Value
        if plan.Status == LoadStatus.Invalid || len(plan.Diagnostics) != 0 {
            return report.Failed([]report.Event{}, plan.Diagnostics)
        }
        if plan.BindingStatus == BindingStatus.Rejected || len(plan.BindingDiagnostics) != 0 {
            return report.Failed([]report.Event{}, plan.BindingDiagnostics)
        }
        return Result(Execute(plan.Program, plan.InitialSlots, journal, transcript))
    } else {
        return report.Failed([]report.Event{}, []diagnostic.Diagnostic{EffectDiagnostic(compileResult.Failure)})
    }
}
