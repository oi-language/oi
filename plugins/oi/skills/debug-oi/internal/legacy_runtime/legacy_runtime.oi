package legacy_runtime

import "std/diagnostic"
import "oi/skills/debug-oi/internal/identity"
import "oi/skills/debug-oi/internal/legacy_action"
import "oi/skills/debug-oi/internal/legacy_channel"
import "oi/skills/debug-oi/internal/legacy_frame"
import "oi/skills/debug-oi/internal/legacy_model"
import "oi/skills/debug-oi/internal/legacy_scheduler"
import "oi/skills/debug-oi/internal/legacy_select"
import "oi/skills/debug-oi/internal/legacy_step"
import "oi/skills/debug-oi/internal/legacy_value"
import "oi/skills/debug-oi/internal/model"
import "oi/skills/debug-oi/internal/report"

func PresentCompletion(value model.Completion?) model.Completion {
    return legacy_frame.PresentCompletion(value)
}

func FramesWithoutLast(frames []legacy_model.Frame) []legacy_model.Frame {
    return legacy_frame.FramesWithoutLast(frames)
}

func PushCall(program model.Program, machine legacy_model.Machine, taskIndex int, step model.CallStep) legacy_model.Machine {
    return legacy_frame.PushCall(program, machine, taskIndex, step)
}

func CancelAttached(machine legacy_model.Machine, activationID text, requesterTaskID text) legacy_model.Machine {
    return legacy_frame.CancelAttached(machine, activationID, requesterTaskID)
}

func FailFrame(program model.Program, machine legacy_model.Machine, taskIndex int,
    failure diagnostic.Diagnostic) legacy_model.Machine {
    return legacy_frame.Fail(program, machine, taskIndex, failure)
}

func ReturnFrame(program model.Program, machine legacy_model.Machine, taskIndex int,
    location text, value legacy_model.Value) legacy_model.Machine {
    return legacy_frame.Return(program, machine, taskIndex, location, value)
}

func FailureCompletion(program model.Program, machine legacy_model.Machine, taskIndex int,
    activation legacy_model.Activation, completion model.Completion, failure diagnostic.Diagnostic) legacy_model.Machine {
    return legacy_frame.FailureCompletion(program, machine, taskIndex, activation, completion, failure)
}

func ObserveFailure(machine legacy_model.Machine, indexes []int, selected int, ownerActivationID text,
    requesterTaskID text) legacy_model.Machine {
    return legacy_frame.ObserveFailure(machine, indexes, selected, ownerActivationID, requesterTaskID)
}

func ImplicitJoin(program model.Program, machine legacy_model.Machine, taskIndex int,
    activation legacy_model.Activation, function model.Function) legacy_model.Machine {
    return legacy_frame.ImplicitJoin(program, machine, taskIndex, activation, function)
}

func ExplicitJoin(program model.Program, machine legacy_model.Machine, taskIndex int,
    activation legacy_model.Activation, step model.JoinStep) legacy_model.Machine {
    return legacy_frame.ExplicitJoin(program, machine, taskIndex, activation, step)
}

func RunTask(program model.Program, machine legacy_model.Machine, taskIndex int,
    transcript []model.LegacyEffectResult, journal []text) legacy_model.Machine {
    machine = legacy_scheduler.StartTask(program, machine, taskIndex)
    machine.Tasks[taskIndex].Status = legacy_model.TaskStatus.Running
    for {
        var activation legacy_model.Activation = legacy_scheduler.Current(machine, taskIndex)
        var function model.Function = legacy_step.Function(program, activation.FunctionID)
        var instruction model.Instruction = legacy_step.Instruction(function, activation.PC)
        if instruction.Kind == model.InstructionKind.Bind || instruction.Kind == model.InstructionKind.Store ||
            instruction.Kind == model.InstructionKind.Compute || instruction.Kind == model.InstructionKind.Branch ||
            instruction.Kind == model.InstructionKind.Jump {
            var transition legacy_model.Transition = legacy_action.Advance(program, function, machine, activation, instruction)
            machine = legacy_scheduler.PutCurrent(transition.Machine, taskIndex, transition.Activation)
            if transition.Failure != none {
                machine = FailFrame(program, machine, taskIndex, legacy_step.PresentDiagnostic(transition.Failure))
                if machine.Tasks[taskIndex].Status == legacy_model.TaskStatus.Running {
                    continue
                }
                return machine
            }
            continue
        }
        if instruction.Kind == model.InstructionKind.Call {
            machine = PushCall(program, machine, taskIndex, legacy_step.PresentCall(instruction.Call))
            continue
        }
        if instruction.Kind == model.InstructionKind.Effect {
            var step model.EffectStep = legacy_step.PresentEffectStep(instruction.Effect)
            var encounter int = legacy_step.NextEffect(activation)
            activation = legacy_step.AdvanceEffect(activation)
            var operationID text = identity.OperationID(model.OperationIdentity{TaskID: activation.TaskID, ActivationID: activation.ID,
                StaticCallsiteID: step.Site.StaticCallsiteID, EncounterIndex: encounter})
            machine = legacy_step.AddEvent(machine, report.EventKind.Effect, step.Site.Location, operationID)
            var found model.LegacyEffectResult? = legacy_step.Transcript(transcript, machine.UsedTranscriptIDs, operationID)
            if found == none {
                machine.RequiredTranscriptEntries = append(machine.RequiredTranscriptEntries, operationID)
                return legacy_scheduler.PutCurrent(machine, taskIndex, activation)
            }
            var effect model.LegacyEffectResult = legacy_step.PresentEffect(found)
            machine.UsedTranscriptIDs = append(machine.UsedTranscriptIDs, operationID)
            if !legacy_step.EffectReturned(effect) {
                machine = FailureCompletion(program, machine, taskIndex, activation, step.Completion,
                    legacy_step.PresentDiagnostic(effect.Failure))
                if machine.Tasks[taskIndex].Status == legacy_model.TaskStatus.Running {
                    continue
                }
                return machine
            }
            var effectValue model.LegacyEffectValue = legacy_step.PresentEffectValue(effect.Value)
            if step.Completion.Mode == model.FailureMode.Capture {
                var slotID int = legacy_step.PresentInt(step.Completion.OutcomeSlot)
                var raw legacy_model.Value = legacy_value.WithType(effectValue, legacy_step.SlotType(program, legacy_step.PresentInt(step.ResultSlot)))
                activation.Slots = legacy_value.Put(activation.Slots, slotID,
                    legacy_value.CompletedOutcome(legacy_step.SlotType(program, slotID), raw))
            } else if step.ResultSlot != none {
                var resultSlot int = legacy_step.PresentInt(step.ResultSlot)
                activation.Slots = legacy_value.Put(activation.Slots, resultSlot,
                    legacy_value.WithType(effectValue, legacy_step.SlotType(program, resultSlot)))
            }
            activation.PC = step.Completion.Continuation
            machine = legacy_scheduler.PutCurrent(machine, taskIndex, activation)
            continue
        }
        if instruction.Kind == model.InstructionKind.Launch {
            var step model.LaunchStep = legacy_step.PresentLaunch(instruction.Launch)
            var sourceIndex int = len(activation.LaunchedTaskIDs)
            var taskID text = activation.TaskID + "/" + [canonical nonnegative decimal text for {sourceIndex}]
            var childFunction model.Function = legacy_step.Function(program, step.CalleeFunctionID)
            var crossed legacy_model.ArgumentCrossing = legacy_action.Cross(program, machine, activation.Slots, step.Arguments,
                taskID + "/a0", childFunction.ParameterSlots)
            machine = crossed.Machine
            var arguments []legacy_model.Value = crossed.Values
            activation.Slots = crossed.SourceSlots
            activation.Slots = legacy_value.Put(activation.Slots, step.HandleSlot,
                legacy_value.Handle(legacy_step.SlotType(program, step.HandleSlot), taskID))
            activation.LaunchedTaskIDs = append(activation.LaunchedTaskIDs, taskID)
            activation.PC = step.Continuation
            machine = legacy_step.AddEvent(machine, report.EventKind.Launch, step.Location, taskID)
            machine = legacy_scheduler.PutCurrent(machine, taskIndex, activation)
            machine = legacy_scheduler.Register(program, machine, taskID, activation.TaskID, sourceIndex, activation.ID,
                step.Location, step.CalleeFunctionID, arguments)
            return legacy_scheduler.Queue(machine, taskIndex)
        }
        if instruction.Kind == model.InstructionKind.Await {
            var step model.AwaitStep = legacy_step.PresentAwait(instruction.Await)
            var taskID text = legacy_value.Slot(activation.Slots, step.HandleSlot).Canonical
            var childIndex int = legacy_scheduler.TaskIndex(machine, taskID)
            if !legacy_scheduler.Terminal(machine.Tasks[childIndex].Status) {
                return legacy_scheduler.Block(machine, taskIndex, legacy_model.BlockKind.Await, step.Location, none, taskID)
            }
            machine.Tasks[childIndex].Observed = true
            machine = legacy_step.AddEvent(machine, report.EventKind.Await, step.Location, taskID)
            if machine.Tasks[childIndex].Failure != none {
                if step.Completion.Mode == model.FailureMode.Propagate {
                    machine = legacy_scheduler.CancelOthers(machine, activation.ID, taskID, activation.TaskID)
                }
                machine = FailureCompletion(program, machine, taskIndex, activation, step.Completion,
                    legacy_step.Frame(legacy_step.PresentDiagnostic(machine.Tasks[childIndex].Failure), "await", step.Location))
                if machine.Tasks[taskIndex].Status == legacy_model.TaskStatus.Running {
                    continue
                }
                return machine
            }
            if step.Completion.Mode == model.FailureMode.Capture {
                var slotID int = legacy_step.PresentInt(step.Completion.OutcomeSlot)
                activation.Slots = legacy_value.Put(activation.Slots, slotID,
                    legacy_value.CompletedOutcome(legacy_step.SlotType(program, slotID), machine.Tasks[childIndex].Value))
            } else if step.ResultSlot != none {
                activation.Slots = legacy_value.Put(activation.Slots, legacy_step.PresentInt(step.ResultSlot),
                    legacy_value.PresentValue(machine.Tasks[childIndex].Value))
            }
            activation.PC = step.Completion.Continuation
            machine = legacy_scheduler.PutCurrent(machine, taskIndex, activation)
            continue
        }
        if instruction.Kind == model.InstructionKind.Join {
            machine = ExplicitJoin(program, machine, taskIndex, activation, legacy_step.PresentJoin(instruction.Join))
            if machine.Tasks[taskIndex].Status == legacy_model.TaskStatus.Blocked || legacy_scheduler.Terminal(machine.Tasks[taskIndex].Status) {
                return machine
            }
            continue
        }
        if instruction.Kind == model.InstructionKind.Channel || instruction.Kind == model.InstructionKind.Send ||
            instruction.Kind == model.InstructionKind.Receive || instruction.Kind == model.InstructionKind.Select {
            var transition legacy_model.Transition
            if instruction.Kind == model.InstructionKind.Select {
                transition = legacy_select.Advance(machine, activation, legacy_step.PresentSelect(instruction.Select), journal)
            } else {
                transition = legacy_channel.Advance(program, machine, activation, instruction)
            }
            machine = legacy_scheduler.PutCurrent(transition.Machine, taskIndex, transition.Activation)
            if transition.Failure != none {
                machine = FailFrame(program, machine, taskIndex, legacy_step.PresentDiagnostic(transition.Failure))
                if machine.Tasks[taskIndex].Status == legacy_model.TaskStatus.Running {
                    continue
                }
                return machine
            }
            if transition.Blocked {
                return legacy_scheduler.Block(machine, taskIndex, transition.BlockKind,
                    transition.BlockLocation, transition.BlockChannelID, transition.BlockTaskID)
            }
            continue
        }
        if instruction.Kind == model.InstructionKind.Return {
            machine = ImplicitJoin(program, machine, taskIndex, activation, function)
            if machine.Tasks[taskIndex].Status == legacy_model.TaskStatus.Blocked || legacy_scheduler.Terminal(machine.Tasks[taskIndex].Status) {
                return machine
            }
            continue
        }
        var step model.StopStep = legacy_step.PresentStop(instruction.Stop)
        var category legacy_model.Value = legacy_value.Operand(activation.Slots, step.Category)
        var detail legacy_model.Value = legacy_value.Operand(activation.Slots, step.Detail)
        machine = legacy_step.AddEvent(machine, report.EventKind.Stop, step.Location, category.Canonical)
        machine = legacy_scheduler.PutCurrent(machine, taskIndex, activation)
        machine = FailFrame(program, machine, taskIndex, legacy_step.Stop(category.Canonical, detail.Canonical, step.Location))
        if machine.Tasks[taskIndex].Status != legacy_model.TaskStatus.Running {
            return machine
        }
    }
}
