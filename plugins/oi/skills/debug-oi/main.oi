package main

import "std/fs"
import "oi/skills/debug-oi/internal/debug"
import "oi/skills/debug-oi/internal/report"

effect Reply(value report.DebugTrace) unit {
    uses caller.reply
    contract [deliver {value} exactly once to the caller]
}

func main(target fs.Path, bindings []debug.Binding, journal []text, transcript []debug.EffectResult) {
    Reply(debug.Trace(target, bindings, journal, transcript))
}
