package main

import "std/debug"
import "std/execution"
import "std/fs"
import "oi/skills/debug-oi/internal/replay"
import "oi/skills/debug-oi/internal/report"

effect Reply(value report.DebugTrace) unit {
    uses caller.reply
    contract [deliver {value} exactly once to the caller]
}

func main(target fs.Path, bindings []debug.Binding, journal execution.ExecutionJournal, receipt execution.ExecutionReceipt,
    transcript []debug.EffectResult) {
    Reply(replay.Trace(target, bindings, journal, receipt, transcript))
}
