package report

import "std/diagnostic"
import "oi/skills/compile-oi/internal/model"

type Status enum {
    Pass
    Fail
}

type CompileReport struct {
    Status Status
    LanguageVersion text?
    Module text?
    SourceCount int
    SourceCharacters int
    Sources []model.SourceIdentity
    Authorities []text
    Shards []text
    Diagnostics []diagnostic.Diagnostic
}

func Pass(
    languageVersion text?,
    module text?,
    sourceCount int,
    sourceCharacters int,
    sources []model.SourceIdentity,
    authorities []text,
    shards []text,
) CompileReport {
    return CompileReport{
        Status: Status.Pass,
        LanguageVersion: languageVersion,
        Module: module,
        SourceCount: sourceCount,
        SourceCharacters: sourceCharacters,
        Sources: sources,
        Authorities: authorities,
        Shards: shards,
        Diagnostics: []diagnostic.Diagnostic{},
    }
}

func Fail(
    languageVersion text?,
    module text?,
    sourceCount int,
    sourceCharacters int,
    sources []model.SourceIdentity,
    authorities []text,
    shards []text,
    diagnostics []diagnostic.Diagnostic,
) CompileReport {
    return CompileReport{
        Status: Status.Fail,
        LanguageVersion: languageVersion,
        Module: module,
        SourceCount: sourceCount,
        SourceCharacters: sourceCharacters,
        Sources: sources,
        Authorities: authorities,
        Shards: shards,
        Diagnostics: diagnostics,
    }
}
