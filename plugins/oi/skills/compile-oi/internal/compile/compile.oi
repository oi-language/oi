package compile

import "std/diagnostic"
import "std/fs"
import "oi/skills/compile-oi/internal/concurrency"
import "oi/skills/compile-oi/internal/declaration"
import "oi/skills/compile-oi/internal/diagnose"
import "oi/skills/compile-oi/internal/effect"
import "oi/skills/compile-oi/internal/load"
import "oi/skills/compile-oi/internal/model"
import "oi/skills/compile-oi/internal/report"
import "oi/skills/compile-oi/internal/typecheck"

func Validate(target fs.Path, available []text) report.CompileReport {
    var graph load.Graph = load.LoadGraph(target)
    var diagnostics []diagnostic.Diagnostic = graph.ModuleDiagnostics
    if len(diagnostics) == 0 {
        diagnostics = graph.ParseDiagnostics
    }
    if len(diagnostics) == 0 {
        diagnostics = graph.PackageDiagnostics
    }
    if len(diagnostics) == 0 {
        diagnostics = ValidateTypePhase(graph)
    }
    var reachable []text = declaration.Reachable(graph)
    var authorities []text = effect.Authorities(graph.Sources, reachable)
    var shards []text = Shards(graph.Sources, reachable)
    if len(diagnostics) == 0 {
        diagnostics = effect.Validate(graph, reachable, available)
    }
    if len(diagnostics) == 0 {
        diagnostics = ValidateShardUse(graph, reachable)
    }
    var languageVersion text? = LanguageVersionText(graph.Manifest)
    var module text? = ManifestModule(graph.Manifest)
    if len(diagnostics) == 0 {
        return report.Pass(
            languageVersion, module, ReportSourceCount(graph), graph.SourceCharacters,
            graph.SourceIdentities, authorities, shards)
    }
    return report.Fail(
        languageVersion, module, ReportSourceCount(graph), graph.SourceCharacters,
        graph.SourceIdentities, authorities, shards, diagnostics)
}

func ValidateTypePhase(graph load.Graph) []diagnostic.Diagnostic {
    var result []diagnostic.Diagnostic = diagnose.Local(graph.Sources, "type")
    result = diagnose.Append(result, typecheck.Validate(graph.Sources))
    result = diagnose.Append(result, declaration.Validate(graph))
    result = diagnose.Append(result, concurrency.Validate(graph))
    return diagnose.Order(result)
}

func ValidateShardUse(graph load.Graph, reachable []text) []diagnostic.Diagnostic {
    var result []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in graph.Sources {
        for use in source.ShardUses {
            var caller text = declaration.DeclarationKey(source.Package, use.Caller)
            if diagnose.ContainsText(reachable, caller) &&
                !diagnose.ContainsText(graph.ManifestClosure, use.Path) {
                result = append(result, diagnostic.New(
                    "MISSING_RUNTIME_SHARD", "module", use.Location, use.Path))
            }
        }
    }
    return diagnose.Order(result)
}

func Shards(sources []model.SourceFile, reachable []text) []text {
    return derive [the first-encounter distinct ShardUse.Path values from {sources} whose declaration
        keys are in {reachable}]
}

func LanguageVersionText(manifest model.ModuleManifest?) text? {
    return ["0.0.1" when {manifest} is present with Oi0_0_1, "0.0.2" when present with
        Oi0_0_2, otherwise none]
}

func ReportSourceCount(graph load.Graph) int {
    return [len of {graph.SourceIdentities} for a selected Oi0_0_2 manifest, otherwise len of
        {graph.Sources}]
}

func ManifestModule(manifest model.ModuleManifest?) text? {
    return [the exact Module field when {manifest} is present, otherwise none]
}
