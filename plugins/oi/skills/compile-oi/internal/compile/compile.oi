package compile

import "std/diagnostic"
import "std/fs"
import "oi/skills/compile-oi/internal/load"
import "oi/skills/compile-oi/internal/model"
import "oi/skills/compile-oi/internal/report"
import "oi/skills/compile-oi/internal/typecheck"

type ResolvedType struct {
    Found bool
    SourceIndex int
    Shape model.TypeShape
}

type TransformResult struct {
    Shape model.TypeShape
    Valid bool
    Diagnostics []diagnostic.Diagnostic
}

type SelectedType struct {
    Shape model.TypeShape
    Found bool
}

type RuntimeHandleSelection struct {
    Found bool
    Kind model.RuntimeHandleKind
    NodePath []int
    Origin model.TypeNodeOrigin
}

type ReceiverHolderState struct {
    Owner text
    Holder text
    ReceiverIdentity text
    Active bool
}

type ReceiverHolderSelection struct {
    Found bool
    Index int
    State ReceiverHolderState
}

type ReceiverViolation struct {
    Path text
    Line int
    Column int
    Diagnostic diagnostic.Diagnostic
}

type LocatedDiagnostic struct {
    Position model.SourcePosition
    Diagnostic diagnostic.Diagnostic
}

type OwnerSelection struct {
    Found bool
    Owner text
}

type CallableSelection struct {
    Found bool
    SourceIndex int
    Name text
    Kind model.DeclarationKind
}

type AuthorityRequirement struct {
    Caller text
    CallID text
    Authority text
    Optional bool
    Position model.SourcePosition
}

type AuthorityContext struct {
    Caller text
    Available []text
}

type AuthorityViolationKey struct {
    CallID text
    Authority text
}

func Validate(target fs.Path, available []text) report.CompileReport {
    var graph load.Graph = load.LoadGraph(target)
    var diagnostics []diagnostic.Diagnostic = graph.ModuleDiagnostics
    if len(diagnostics) == 0 {
        diagnostics = graph.ParseDiagnostics
    }
    if len(diagnostics) == 0 {
        diagnostics = graph.PackageDiagnostics
    }
    if len(diagnostics) == 0 {
        diagnostics = ValidateTypePhase(graph)
    }
    var reachable []text = ReachableCallers(graph)
    var authorities []text = Authorities(graph.Sources, reachable)
    var shards []text = Shards(graph.Sources, reachable)
    if len(diagnostics) == 0 {
        diagnostics = ValidateAuthorityUse(graph, reachable, available)
    }
    if len(diagnostics) == 0 {
        diagnostics = ValidateShardUse(graph, reachable)
    }
    var languageVersion text? = LanguageVersionText(graph.Manifest)
    var module text? = ManifestModule(graph.Manifest)
    if len(diagnostics) == 0 {
        return report.Pass(
            languageVersion,
            module,
            ReportSourceCount(graph),
            graph.SourceCharacters,
            graph.SourceIdentities,
            authorities,
            shards,
        )
    }
    return report.Fail(
        languageVersion,
        module,
        ReportSourceCount(graph),
        graph.SourceCharacters,
        graph.SourceIdentities,
        authorities,
        shards,
        diagnostics,
    )
}

func ValidateTypePhase(graph load.Graph) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = LocalDiagnostics(graph.Sources, "type")
    diagnostics = AppendDiagnostics(diagnostics, ValidateSemanticExpressions(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateCollections(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateDeclarations(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateTypeReferences(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateTransfers(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateTaskIntrinsics(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateCalls(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateConversions(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateChannels(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateReceiverMoves(graph))
    diagnostics = AppendDiagnostics(diagnostics, ValidateRuntimeHandles(graph.Sources))
    diagnostics = AppendDiagnostics(diagnostics, ValidateEntries(graph))
    return diagnostics
}

func ValidateSemanticExpressions(sources []model.SourceFile) []diagnostic.Diagnostic {
    var located []LocatedDiagnostic = []LocatedDiagnostic{}
    for source in sources {
        for judgment in source.Judgments {
            if judgment.HasTarget && !typecheck.BoundedSemanticResult(
                sources,
                source,
                judgment.Target,
            ) {
                located = InsertLocatedDiagnostic(
                    located,
                    LocatedDiagnostic{
                        Position: judgment.Position,
                        Diagnostic: diagnostic.New(
                            "UNBOUNDED_SEMANTIC_RESULT",
                            "type",
                            judgment.Position.Location,
                            judgment.TargetSource,
                        ),
                    },
                )
            }
        }
        for derivation in source.Derivations {
            located = AppendLocatedDiagnostics(
                located,
                ValidateDerivation(sources, source, derivation),
            )
        }
    }
    return LocatedDiagnostics(located)
}

func ValidateDerivation(
    sources []model.SourceFile,
    source model.SourceFile,
    derivation model.DerivationExpression,
) []LocatedDiagnostic {
    var diagnostics []LocatedDiagnostic = []LocatedDiagnostic{}
    if !derivation.HasTarget {
        diagnostics = InsertLocatedDiagnostic(
            diagnostics,
            LocatedDiagnostic{
                Position: derivation.Position,
                Diagnostic: diagnostic.New(
                    "DERIVATION_TARGET_REQUIRED",
                    "type",
                    derivation.Position.Location,
                    "derive",
                ),
            },
        )
    } else {
        var target model.TypeShape = UnderlyingTypeShape(
            sources,
            source,
            derivation.Target,
            []text{},
        )
        var handle RuntimeHandleSelection = FirstRuntimeHandle(target)
        if handle.Found {
            diagnostics = InsertLocatedDiagnostic(
                diagnostics,
                LocatedDiagnostic{
                    Position: handle.Origin.Position,
                    Diagnostic: diagnostic.New(
                        "DERIVATION_HANDLE_FORBIDDEN",
                        "type",
                        handle.Origin.Position.Location,
                        handle.Origin.Token,
                    ),
                },
            )
        }
    }
    for dependency in derivation.Dependencies {
        diagnostics = InsertLocatedDiagnostic(
            diagnostics,
            DerivationDependencyDiagnostic(dependency),
        )
    }
    return diagnostics
}

func DerivationDependencyDiagnostic(
    dependency model.DerivationDependency,
) LocatedDiagnostic {
    var category text = "DERIVATION_CONTROL_FORBIDDEN"
    if dependency.Kind == model.DerivationDependencyKind.Effect {
        category = "DERIVATION_EFFECT_FORBIDDEN"
    } else if dependency.Kind == model.DerivationDependencyKind.AmbientContext {
        category = "DERIVATION_CONTEXT_FORBIDDEN"
    } else if dependency.Kind == model.DerivationDependencyKind.RuntimeHandle {
        category = "DERIVATION_HANDLE_FORBIDDEN"
    }
    return LocatedDiagnostic{
        Position: dependency.Position,
        Diagnostic: diagnostic.New(
            category,
            "type",
            dependency.Position.Location,
            dependency.Detail,
        ),
    }
}

func ValidateCollections(sources []model.SourceFile) []diagnostic.Diagnostic {
    var located []LocatedDiagnostic = []LocatedDiagnostic{}
    for source in sources {
        for use in source.CollectionTypes {
            var order model.CanonicalOrderIdentity = typecheck.CanonicalOrder(
                sources,
                source,
                use.Member,
            )
            if !order.Stable {
                var category text = "UNSTABLE_MAP_KEY"
                if use.Kind == model.TypeShapeKind.Set {
                    category = "UNSTABLE_SET_ELEMENT"
                }
                located = InsertLocatedDiagnostic(
                    located,
                    LocatedDiagnostic{
                        Position: use.Position,
                        Diagnostic: diagnostic.New(
                            category,
                            "type",
                            use.Position.Location,
                            use.MemberTypeSource,
                        ),
                    },
                )
            }
        }
        for call in source.CollectionCalls {
            located = AppendLocatedDiagnostics(
                located,
                ValidateCollectionCall(sources, source, call),
            )
        }
        for use in source.CollectionIndexes {
            located = AppendLocatedDiagnostics(
                located,
                ValidateCollectionIndex(sources, source, use),
            )
        }
        for use in source.CollectionIterations {
            located = AppendLocatedDiagnostics(
                located,
                ValidateCollectionIteration(sources, source, use),
            )
        }
    }
    return LocatedDiagnostics(located)
}

func ValidateCollectionCall(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
) []LocatedDiagnostic {
    var name text = CallName(call.Target)
    var expectedArity int = CollectionBuiltinArity(name)
    if expectedArity == 0 || len(call.Arguments) != expectedArity {
        return []LocatedDiagnostic{
            CollectionCallDiagnostic(call, "ARGUMENT_ARITY_MISMATCH", name),
        }
    }
    var collection ResolvedType = ResolveArgumentType(sources, source, call.Arguments[0])
    if !collection.Found {
        return []LocatedDiagnostic{
            CollectionCallDiagnostic(call, "ARGUMENT_TYPE_MISMATCH", name),
        }
    }
    var surface model.TypeShape = SurfaceTypeShape(
        sources[collection.SourceIndex],
        collection.Shape,
    )
    var outer model.TypeShape = OuterTypeShape(
        sources,
        sources[collection.SourceIndex],
        collection.Shape,
        []text{},
    )
    var selected typecheck.CollectionSelection = typecheck.SelectCollection(surface, outer)
    var signature typecheck.BuiltinSignature = typecheck.Signature(name, selected)
    if !signature.Found {
        return []LocatedDiagnostic{
            CollectionCallDiagnostic(call, "ARGUMENT_TYPE_MISMATCH", name),
        }
    }
    for index in ArgumentIndexes(call.Arguments) {
        var actual ResolvedType = ResolveArgumentType(sources, source, call.Arguments[index])
        if !actual.Found || !SameType(
            sources[actual.SourceIndex],
            actual.Shape,
            sources[collection.SourceIndex],
            signature.Arguments[index],
        ) {
            return []LocatedDiagnostic{
                CollectionCallDiagnostic(call, "ARGUMENT_TYPE_MISMATCH", name),
            }
        }
    }
    if call.ResultUsed && !CollectionResultMatches(
        sources,
        source,
        call,
        sources[collection.SourceIndex],
        signature.Result,
    ) {
        return []LocatedDiagnostic{
            CollectionCallDiagnostic(call, "RESULT_TYPE_MISMATCH", name),
        }
    }
    return []LocatedDiagnostic{}
}

func ValidateCollectionIndex(
    sources []model.SourceFile,
    source model.SourceFile,
    use model.CollectionIndexUse,
) []LocatedDiagnostic {
    var collection ResolvedType = ResolveArgumentType(sources, source, use.Collection)
    if !collection.Found {
        return []LocatedDiagnostic{CollectionIndexTargetDiagnostic(use)}
    }
    var surface model.TypeShape = SurfaceTypeShape(
        sources[collection.SourceIndex],
        collection.Shape,
    )
    var outer model.TypeShape = OuterTypeShape(
        sources,
        sources[collection.SourceIndex],
        collection.Shape,
        []text{},
    )
    var selected typecheck.CollectionSelection = typecheck.SelectCollection(surface, outer)
    if !selected.Found || selected.Kind == model.TypeShapeKind.Set {
        return []LocatedDiagnostic{CollectionIndexTargetDiagnostic(use)}
    }
    var index ResolvedType = ResolveArgumentType(sources, source, use.Index)
    if !index.Found || !SameType(
        sources[index.SourceIndex],
        index.Shape,
        sources[collection.SourceIndex],
        selected.Key,
    ) {
        return []LocatedDiagnostic{
            LocatedDiagnostic{
                Position: use.Position,
                Diagnostic: diagnostic.New(
                    "TYPE_MISMATCH",
                    "type",
                    use.Index.Location,
                    TypeShapeDetail(selected.Key),
                ),
            },
        }
    }
    if use.ResultUsed && !CollectionIndexResultMatches(
        sources,
        source,
        use,
        sources[collection.SourceIndex],
        selected.Value,
    ) {
        return []LocatedDiagnostic{
            LocatedDiagnostic{
                Position: use.Position,
                Diagnostic: diagnostic.New(
                    "TYPE_MISMATCH",
                    "type",
                    use.Position.Location,
                    TypeShapeDetail(selected.Value),
                ),
            },
        }
    }
    return []LocatedDiagnostic{}
}

func ValidateCollectionIteration(
    sources []model.SourceFile,
    source model.SourceFile,
    use model.CollectionIteration,
) []LocatedDiagnostic {
    var collection ResolvedType = ResolveArgumentType(sources, source, use.Collection)
    if !collection.Found {
        return []LocatedDiagnostic{
            LocatedDiagnostic{
                Position: use.Position,
                Diagnostic: diagnostic.New(
                    "UNSUPPORTED_TYPE",
                    "type",
                    use.Position.Location,
                    use.Collection.TypeSource,
                ),
            },
        }
    }
    var surface model.TypeShape = SurfaceTypeShape(
        sources[collection.SourceIndex],
        collection.Shape,
    )
    var outer model.TypeShape = OuterTypeShape(
        sources,
        sources[collection.SourceIndex],
        collection.Shape,
        []text{},
    )
    var selected typecheck.CollectionSelection = typecheck.SelectCollection(surface, outer)
    if !selected.Found {
        return []LocatedDiagnostic{
            LocatedDiagnostic{
                Position: use.Position,
                Diagnostic: diagnostic.New(
                    "UNSUPPORTED_TYPE",
                    "type",
                    use.Position.Location,
                    use.Collection.TypeSource,
                ),
            },
        }
    }
    var count int = len(use.Bindings)
    if !typecheck.ValidIterationArity(selected, count) {
        var position model.SourcePosition = use.InPosition
        var maximum int = IterationMaximumBindings(selected)
        if count > maximum {
            position = use.Bindings[maximum].Position
        }
        return []LocatedDiagnostic{
            LocatedDiagnostic{
                Position: position,
                Diagnostic: diagnostic.New(
                    "ITERATION_BINDING_ARITY_MISMATCH",
                    "type",
                    position.Location,
                    typecheck.IterationArityDetail(selected, count),
                ),
            },
        }
    }
    var expected []model.TypeShape = typecheck.IterationBindingTypes(selected, count)
    for index in IterationBindingIndexes(use.Bindings) {
        if !SameType(
            source,
            use.Bindings[index].Type,
            sources[collection.SourceIndex],
            expected[index],
        ) {
            return []LocatedDiagnostic{
                LocatedDiagnostic{
                    Position: use.Bindings[index].Position,
                    Diagnostic: diagnostic.New(
                        "TYPE_MISMATCH",
                        "type",
                        use.Bindings[index].Position.Location,
                        TypeShapeDetail(expected[index]),
                    ),
                },
            }
        }
    }
    return []LocatedDiagnostic{}
}

func CollectionBuiltinArity(name text) int {
    if name == "len" {
        return 1
    }
    if name == "has" || name == "add" || name == "remove" {
        return 2
    }
    if name == "put" {
        return 3
    }
    return 0
}

func CollectionCallDiagnostic(
    call model.CallSite,
    category text,
    detail text,
) LocatedDiagnostic {
    return LocatedDiagnostic{
        Position: call.Position,
        Diagnostic: diagnostic.New(category, "type", call.Location, detail),
    }
}

func CollectionIndexTargetDiagnostic(
    use model.CollectionIndexUse,
) LocatedDiagnostic {
    return LocatedDiagnostic{
        Position: use.Position,
        Diagnostic: diagnostic.New(
            "INVALID_INDEX_TARGET",
            "type",
            use.Position.Location,
            use.Collection.TypeSource,
        ),
    }
}

func CollectionResultMatches(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
    resultSource model.SourceFile,
    result model.TypeShape,
) bool {
    if call.HasResultTarget {
        return SameType(resultSource, result, source, call.ResultTarget)
    }
    if call.ResultTargetCallID != "" {
        var target ResolvedType = ResolveCallResult(sources, source, call.ResultTargetCallID)
        return target.Found && SameType(
            resultSource,
            result,
            sources[target.SourceIndex],
            target.Shape,
        )
    }
    return true
}

func CollectionIndexResultMatches(
    sources []model.SourceFile,
    source model.SourceFile,
    use model.CollectionIndexUse,
    resultSource model.SourceFile,
    result model.TypeShape,
) bool {
    if use.HasResultTarget {
        return SameType(resultSource, result, source, use.ResultTarget)
    }
    if use.ResultTargetCallID != "" {
        var target ResolvedType = ResolveCallResult(sources, source, use.ResultTargetCallID)
        return target.Found && SameType(
            resultSource,
            result,
            sources[target.SourceIndex],
            target.Shape,
        )
    }
    return true
}

func IterationMaximumBindings(collection typecheck.CollectionSelection) int {
    if collection.Kind == model.TypeShapeKind.Set {
        return 1
    }
    return 2
}

func IterationBindingIndexes(values []model.IterationBinding) []int {
    return [the integer indexes zero through len of {values} minus one in ascending order]
}

func ValidateDeclarations(sources []model.SourceFile) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    var seen []text = []text{}
    for source in sources {
        for declaration in source.Declarations {
            var key text = DeclarationKey(source.Package, declaration.Name)
            if ContainsText(seen, key) {
                diagnostics = append(
                    diagnostics,
                    diagnostic.New(
                        "DUPLICATE_DECLARATION",
                        "type",
                        declaration.Location,
                        declaration.Name,
                    ),
                )
            } else {
                seen = append(seen, key)
            }
        }
    }
    return diagnostics
}

func ValidateTypeReferences(sources []model.SourceFile) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        for reference in source.TypeReferences {
            var targetPackage text = ReferencePackage(source, reference.Name)
            var targetName text = ReferenceName(reference.Name)
            if !IsBuiltinType(reference.Name) &&
                !HasTypeDeclaration(sources, targetPackage, targetName) {
                diagnostics = append(
                    diagnostics,
                    diagnostic.New("UNKNOWN_TYPE", "type", reference.Location, reference.Name),
                )
            } else if targetPackage != source.Package &&
                !HasExportedType(sources, targetPackage, targetName) {
                diagnostics = append(
                    diagnostics,
                    diagnostic.New("UNEXPORTED_NAME", "type", reference.Location, reference.Name),
                )
            }
        }
    }
    return diagnostics
}

func ValidateCalls(sources []model.SourceFile) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        for call in source.Calls {
            if !IsTaskIntrinsicCall(source, call) {
                var targetPackage text = CallPackage(source, call.Target)
                var targetName text = CallName(call.Target)
                var oiTarget []diagnostic.Diagnostic = ValidateOiTarget(
                    sources,
                    call,
                    targetPackage,
                    targetName,
                )
                if len(oiTarget) != 0 {
                    diagnostics = AppendDiagnostics(diagnostics, oiTarget)
                } else if targetName == "main" {
                    diagnostics = append(
                        diagnostics,
                        diagnostic.New("ENTRY_NOT_CALLABLE", "type", call.Location, call.Target),
                    )
                } else if !HasCallableDeclaration(sources, targetPackage, targetName) {
                    diagnostics = append(
                        diagnostics,
                        diagnostic.New("UNKNOWN_NAME", "type", call.Location, call.Target),
                    )
                } else if targetPackage != source.Package &&
                    !HasExportedCallable(sources, targetPackage, targetName) {
                    diagnostics = append(
                        diagnostics,
                        diagnostic.New("UNEXPORTED_NAME", "type", call.Location, call.Target),
                    )
                } else {
                    diagnostics = AppendDiagnostics(
                        diagnostics,
                        ValidateCallSignature(sources, source, call, targetPackage, targetName),
                    )
                }
            }
        }
    }
    return diagnostics
}

func ValidateOiTarget(
    sources []model.SourceFile,
    call model.CallSite,
    packageName text,
    name text,
) []diagnostic.Diagnostic {
    if !IsOiCall(call) {
        return []diagnostic.Diagnostic{}
    }
    for candidate in sources {
        if candidate.Package == packageName {
            for declaration in candidate.Declarations {
                if declaration.Name == name {
                    if declaration.Kind == model.DeclarationKind.Effect {
                        return []diagnostic.Diagnostic{
                            diagnostic.New(
                                "OI_EFFECT_FORBIDDEN",
                                "type",
                                OiLocation(call),
                                call.Target,
                            ),
                        }
                    }
                    if declaration.Kind != model.DeclarationKind.Function {
                        return []diagnostic.Diagnostic{
                            diagnostic.New(
                                "OI_REQUIRES_NAMED_FUNCTION",
                                "type",
                                OiLocation(call),
                                call.Target,
                            ),
                        }
                    }
                }
            }
        }
    }
    return []diagnostic.Diagnostic{}
}

func IsOiCall(call model.CallSite) bool {
    for transform in call.ResultTransforms {
        if transform.Kind == model.ResultTransformKind.WrapTask {
            return true
        }
    }
    return false
}

func OiLocation(call model.CallSite) text {
    for transform in call.ResultTransforms {
        if transform.Kind == model.ResultTransformKind.WrapTask {
            return transform.Location
        }
    }
    return call.Location
}

func IsTaskIntrinsicCall(source model.SourceFile, call model.CallSite) bool {
    for use in source.TaskIntrinsicUses {
        if use.CallID == call.ID {
            return true
        }
    }
    return false
}

func ValidateTransfers(sources []model.SourceFile) []diagnostic.Diagnostic {
    var located []LocatedDiagnostic = []LocatedDiagnostic{}
    for source in sources {
        for transfer in source.Transfers {
            located = AppendLocatedDiagnostics(
                located,
                ValidateTransfer(sources, source, transfer),
            )
        }
    }
    return LocatedDiagnostics(located)
}

func ValidateTransfer(
    sources []model.SourceFile,
    source model.SourceFile,
    transfer model.TransferUse,
) []LocatedDiagnostic {
    var diagnostics []LocatedDiagnostic = ValidateTransferTarget(sources, source, transfer)
    var crossesOwner bool = TransferCrossesOwner(transfer)
    for argument in transfer.Arguments {
        var resolved ResolvedType = ResolveTransferArgument(sources, source, argument)
        var handle RuntimeHandleSelection = RuntimeHandleSelection{
            Found: false,
            Kind: model.RuntimeHandleKind.Task,
            NodePath: []int{},
            Origin: EmptyTypeNodeOrigin(),
        }
        if resolved.Found {
            var underlying model.TypeShape = UnderlyingTypeShape(
                sources,
                sources[resolved.SourceIndex],
                resolved.Shape,
                []text{},
            )
            handle = FirstRuntimeHandle(underlying)
            if !handle.Found && !DurableTransferType(underlying) {
                diagnostics = InsertLocatedDiagnostic(
                    diagnostics,
                    LocatedDiagnostic{
                        Position: argument.Position,
                        Diagnostic: diagnostic.New(
                            "UNSUPPORTED_TYPE",
                            "type",
                            argument.Position.Location,
                            argument.TypeSource,
                        ),
                    },
                )
            }
        }
        if crossesOwner &&
            (argument.Durability == model.TransferDurability.RuntimeHandle || handle.Found) {
            var position model.SourcePosition = argument.Position
            var detail text = argument.TypeSource
            if argument.HasRuntimeHandleOrigin {
                position = argument.RuntimeHandleOrigin.Position
                detail = argument.RuntimeHandleOrigin.Token
            }
            diagnostics = InsertLocatedDiagnostic(
                diagnostics,
                LocatedDiagnostic{
                    Position: position,
                    Diagnostic: diagnostic.New(
                        "ENDPOINT_SCOPE_ESCAPE",
                        "type",
                        position.Location,
                        detail,
                    ),
                },
            )
        }
    }
    return diagnostics
}

func TransferCrossesOwner(transfer model.TransferUse) bool {
    if transfer.SourceOwner != transfer.Owner {
        return false
    }
    if transfer.Kind == model.TransferKind.Detach {
        return transfer.DestinationKind == model.TransferDestinationKind.HostRegistry &&
            transfer.DestinationOwner == "host/task-registry"
    }
    return transfer.DestinationKind == model.TransferDestinationKind.NamedActivation &&
        transfer.DestinationOwner == transfer.Target
}

func ValidateTransferTarget(
    sources []model.SourceFile,
    source model.SourceFile,
    transfer model.TransferUse,
) []LocatedDiagnostic {
    var diagnostics []LocatedDiagnostic = []LocatedDiagnostic{}
    var packageName text = CallPackage(source, transfer.Target)
    var name text = CallName(transfer.Target)
    for candidate in sources {
        if candidate.Package == packageName {
            for declaration in candidate.Declarations {
                if declaration.Name == name &&
                    transfer.Kind == model.TransferKind.Handoff {
                    if declaration.Kind != model.DeclarationKind.Function {
                        diagnostics = InsertLocatedDiagnostic(
                            diagnostics,
                            TransferTargetDiagnostic(
                                transfer,
                                "OI_REQUIRES_NAMED_FUNCTION",
                            ),
                        )
                    } else if !DeclarationReturnsUnit(sources, candidate, declaration) {
                        diagnostics = InsertLocatedDiagnostic(
                            diagnostics,
                            TransferTargetDiagnostic(transfer, "RESULT_ARITY_MISMATCH"),
                        )
                    }
                }
            }
        }
    }
    return diagnostics
}

func TransferTargetDiagnostic(
    transfer model.TransferUse,
    category text,
) LocatedDiagnostic {
    return LocatedDiagnostic{
        Position: transfer.TargetPosition,
        Diagnostic: diagnostic.New(
            category,
            "type",
            transfer.TargetPosition.Location,
            transfer.Target,
        ),
    }
}

func DeclarationReturnsUnit(
    sources []model.SourceFile,
    source model.SourceFile,
    declaration model.Declaration,
) bool {
    if !declaration.HasResult {
        return false
    }
    var result model.TypeShape = OuterTypeShape(
        sources,
        source,
        declaration.Result,
        []text{},
    )
    return result.Kind == model.TypeShapeKind.Builtin && result.Name == "unit"
}

func ResolveTransferArgument(
    sources []model.SourceFile,
    source model.SourceFile,
    argument model.TransferArgument,
) ResolvedType {
    if argument.Known {
        return ResolvedType{
            Found: true,
            SourceIndex: SourceIndexForPath(sources, source.Path),
            Shape: argument.Type,
        }
    }
    if argument.ProducerCallID != "" {
        return ResolveCallResult(sources, source, argument.ProducerCallID)
    }
    return ResolvedType{Found: false, SourceIndex: 0, Shape: EmptyTypeShape()}
}

func DurableTransferType(shape model.TypeShape) bool {
    if shape.Kind == model.TypeShapeKind.Task ||
        shape.Kind == model.TypeShapeKind.Channel ||
        shape.Kind == model.TypeShapeKind.Sender ||
        shape.Kind == model.TypeShapeKind.Receiver {
        return false
    }
    if shape.Kind != model.TypeShapeKind.Builtin &&
        shape.Kind != model.TypeShapeKind.Named &&
        shape.Kind != model.TypeShapeKind.Slice &&
        shape.Kind != model.TypeShapeKind.Map &&
        shape.Kind != model.TypeShapeKind.Set &&
        shape.Kind != model.TypeShapeKind.Optional &&
        shape.Kind != model.TypeShapeKind.Struct &&
        shape.Kind != model.TypeShapeKind.Enum &&
        shape.Kind != model.TypeShapeKind.Outcome {
        return false
    }
    for element in shape.Elements {
        if !DurableTransferType(element) {
            return false
        }
    }
    return true
}

func ValidateTaskIntrinsics(sources []model.SourceFile) []diagnostic.Diagnostic {
    var located []LocatedDiagnostic = []LocatedDiagnostic{}
    for source in sources {
        for use in source.TaskIntrinsicUses {
            located = AppendLocatedDiagnostics(
                located,
                ValidateTaskIntrinsic(sources, source, use),
            )
        }
    }
    return LocatedDiagnostics(located)
}

func ValidateTaskIntrinsic(
    sources []model.SourceFile,
    source model.SourceFile,
    use model.TaskIntrinsicUse,
) []LocatedDiagnostic {
    var diagnostics []LocatedDiagnostic = []LocatedDiagnostic{}
    for call in source.Calls {
        if call.ID == use.CallID {
            if !TaskIntrinsicTargetValid(source, use) {
                diagnostics = InsertLocatedDiagnostic(
                    diagnostics,
                    TaskIntrinsicDiagnostic(use, "UNKNOWN_NAME", "type"),
                )
            } else if len(call.Arguments) != 1 {
                diagnostics = InsertLocatedDiagnostic(
                    diagnostics,
                    TaskIntrinsicDiagnostic(use, "ARGUMENT_ARITY_MISMATCH", "type"),
                )
            } else {
                var resolved ResolvedType = ResolveArgumentType(
                    sources,
                    source,
                    call.Arguments[0],
                )
                if resolved.Found {
                    var outer model.TypeShape = OuterTypeShape(
                        sources,
                        sources[resolved.SourceIndex],
                        resolved.Shape,
                        []text{},
                    )
                    if outer.Kind != model.TypeShapeKind.Task {
                        diagnostics = InsertLocatedDiagnostic(
                            diagnostics,
                            TaskArgumentTypeMismatch(use),
                        )
                    }
                } else {
                    diagnostics = InsertLocatedDiagnostic(
                        diagnostics,
                        TaskArgumentTypeMismatch(use),
                    )
                }
            }
            var handleOwner OwnerSelection = ResolveTaskHandleOwner(source, use)
            if handleOwner.Found && handleOwner.Owner != use.Owner {
                diagnostics = InsertLocatedDiagnostic(
                    diagnostics,
                    LocatedDiagnostic{
                        Position: use.Position,
                        Diagnostic: diagnostic.New(
                            "INVALID_RUNTIME_HANDLE_PLACEMENT",
                            "type",
                            use.Position.Location,
                            use.SourceHolder,
                        ),
                    },
                )
            }
            var declaration model.Declaration = TaskIntrinsicDeclaration(use)
            var resultDiagnostics []diagnostic.Diagnostic = ValidateCallResult(
                sources,
                source,
                call,
                source,
                declaration,
            )
            for item in resultDiagnostics {
                diagnostics = InsertLocatedDiagnostic(
                    diagnostics,
                    LocatedDiagnostic{Position: use.Position, Diagnostic: item},
                )
            }
        }
    }
    return diagnostics
}

func ResolveTaskHandleOwner(
    source model.SourceFile,
    use model.TaskIntrinsicUse,
) OwnerSelection {
    if use.HandleOwnerKnown {
        return OwnerSelection{Found: true, Owner: use.HandleOwner}
    }
    if use.Argument.ProducerCallID != "" {
        for call in source.Calls {
            if call.ID == use.Argument.ProducerCallID && IsOiCall(call) {
                return OwnerSelection{Found: true, Owner: call.Caller}
            }
        }
    }
    return OwnerSelection{Found: false, Owner: ""}
}

func TaskArgumentTypeMismatch(use model.TaskIntrinsicUse) LocatedDiagnostic {
    return LocatedDiagnostic{
        Position: use.ArgumentPosition,
        Diagnostic: diagnostic.New(
            "TYPE_MISMATCH",
            "type",
            use.Argument.Location,
            "task[T]",
        ),
    }
}

func TaskIntrinsicTargetValid(
    source model.SourceFile,
    use model.TaskIntrinsicUse,
) bool {
    var expected text = "Status"
    if use.Kind == model.TaskIntrinsicKind.Cancel {
        expected = "Cancel"
    }
    return ImportsStandardTask(source) &&
        CallPackage(source, use.Target) == "task" &&
        CallName(use.Target) == expected
}

func ImportsStandardTask(source model.SourceFile) bool {
    for importValue in source.Imports {
        if importValue.Path == "std/task" {
            return true
        }
    }
    return false
}

func TaskIntrinsicDiagnostic(
    use model.TaskIntrinsicUse,
    category text,
    phase text,
) LocatedDiagnostic {
    return LocatedDiagnostic{
        Position: use.Position,
        Diagnostic: diagnostic.New(category, phase, use.Position.Location, use.Target),
    }
}

func TaskIntrinsicDeclaration(use model.TaskIntrinsicUse) model.Declaration {
    var name text = "Status"
    var resultSource text = "task.Info"
    var result model.TypeShape = NamedTypeShape(resultSource)
    if use.Kind == model.TaskIntrinsicKind.Cancel {
        name = "Cancel"
        resultSource = "unit"
        result = BuiltinTypeShape(resultSource)
    }
    return model.Declaration{
        Name: name,
        Kind: model.DeclarationKind.Function,
        Exported: true,
        Location: use.Position.Location,
        Parameters: []model.Parameter{},
        ResultSource: resultSource,
        Result: result,
        HasResult: true,
        TypeSource: none,
        Underlying: EmptyTypeShape(),
        HasUnderlying: false,
    }
}

func ResolveArgumentType(
    sources []model.SourceFile,
    source model.SourceFile,
    argument model.Argument,
) ResolvedType {
    if argument.Known {
        return ResolvedType{
            Found: true,
            SourceIndex: SourceIndexForPath(sources, source.Path),
            Shape: argument.Type,
        }
    }
    if argument.ProducerCallID != "" {
        return ResolveCallResult(sources, source, argument.ProducerCallID)
    }
    return ResolvedType{Found: false, SourceIndex: 0, Shape: EmptyTypeShape()}
}

func ValidateCallSignature(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
    targetPackage text,
    targetName text,
) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for targetSource in sources {
        if targetSource.Package == targetPackage {
            for declaration in targetSource.Declarations {
                if declaration.Name == targetName &&
                    IsCallableDeclaration(declaration) {
                    if len(call.Arguments) != len(declaration.Parameters) {
                        diagnostics = append(
                            diagnostics,
                            diagnostic.New(
                                "ARGUMENT_ARITY_MISMATCH",
                                "type",
                                call.Location,
                                call.Target,
                            ),
                        )
                    } else {
                        diagnostics = AppendDiagnostics(
                            diagnostics,
                            ValidateArguments(
                                sources,
                                source,
                                call.Arguments,
                                targetSource,
                                declaration.Parameters,
                            ),
                        )
                    }
                    diagnostics = AppendDiagnostics(
                        diagnostics,
                        ValidateCallResult(sources, source, call, targetSource, declaration),
                    )
                }
            }
        }
    }
    return diagnostics
}

func ValidateArguments(
    sources []model.SourceFile,
    source model.SourceFile,
    arguments []model.Argument,
    targetSource model.SourceFile,
    parameters []model.Parameter,
) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for index in ArgumentIndexes(arguments) {
        if arguments[index].Known {
            diagnostics = AppendDiagnostics(
                diagnostics,
                ValidateTypeCompatibility(
                    sources,
                    source,
                    arguments[index].Type,
                    targetSource,
                    parameters[index].Type,
                    arguments[index].Location,
                ),
            )
        } else if arguments[index].ProducerCallID != "" {
            diagnostics = AppendDiagnostics(
                diagnostics,
                ValidateProducedArgument(
                    sources,
                    source,
                    arguments[index],
                    targetSource,
                    parameters[index],
                ),
            )
        }
    }
    return diagnostics
}

func ValidateProducedArgument(
    sources []model.SourceFile,
    source model.SourceFile,
    argument model.Argument,
    targetSource model.SourceFile,
    parameter model.Parameter,
) []diagnostic.Diagnostic {
    var producer ResolvedType = ResolveCallResult(sources, source, argument.ProducerCallID)
    if producer.Found {
        return ValidateTypeCompatibility(
            sources,
            sources[producer.SourceIndex],
            producer.Shape,
            targetSource,
            parameter.Type,
            argument.Location,
        )
    }
    return []diagnostic.Diagnostic{}
}

func ValidateCallResult(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
    targetSource model.SourceFile,
    declaration model.Declaration,
) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    var transformed TransformResult = TransformCallResult(
        sources,
        targetSource,
        call,
        declaration,
    )
    diagnostics = AppendDiagnostics(diagnostics, transformed.Diagnostics)
    if call.ResultUsed {
        if !declaration.HasResult {
            diagnostics = append(
                diagnostics,
                diagnostic.New("RESULT_ARITY_MISMATCH", "type", call.Location, call.Target),
            )
        } else if transformed.Valid && call.HasResultTarget {
            diagnostics = AppendDiagnostics(
                diagnostics,
                ValidateTypeCompatibility(
                    sources,
                    targetSource,
                    transformed.Shape,
                    source,
                    call.ResultTarget,
                    call.Location,
                ),
            )
        } else if transformed.Valid && call.ResultTargetCallID != "" {
            var target ResolvedType = ResolveCallResult(
                sources,
                source,
                call.ResultTargetCallID,
            )
            if target.Found {
                diagnostics = AppendDiagnostics(
                    diagnostics,
                    ValidateTypeCompatibility(
                        sources,
                        targetSource,
                        transformed.Shape,
                        sources[target.SourceIndex],
                        target.Shape,
                        call.Location,
                    ),
                )
            }
        }
    }
    return diagnostics
}

func ValidateConversions(sources []model.SourceFile) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        for conversion in source.Conversions {
            if conversion.SourceKnown {
                diagnostics = AppendDiagnostics(
                    diagnostics,
                    ValidateConversion(
                        sources,
                        source,
                        conversion.Source,
                        source,
                        conversion,
                    ),
                )
            } else if conversion.SourceCallID != "" {
                var producer ResolvedType = ResolveCallResult(
                    sources,
                    source,
                    conversion.SourceCallID,
                )
                if producer.Found {
                    diagnostics = AppendDiagnostics(
                        diagnostics,
                        ValidateConversion(
                            sources,
                            sources[producer.SourceIndex],
                            producer.Shape,
                            source,
                            conversion,
                        ),
                    )
                }
            }
        }
    }
    return diagnostics
}

func ValidateConversion(
    sources []model.SourceFile,
    actualSource model.SourceFile,
    actual model.TypeShape,
    targetSource model.SourceFile,
    conversion model.ConversionSite,
) []diagnostic.Diagnostic {
    if SameType(actualSource, actual, targetSource, conversion.Target) {
        return []diagnostic.Diagnostic{}
    }
    var sameUnderlying bool = SameUnderlyingType(
        sources,
        actualSource,
        actual,
        targetSource,
        conversion.Target,
    )
    if !conversion.Explicit && sameUnderlying {
        return []diagnostic.Diagnostic{
            diagnostic.New(
                "IMPLICIT_NAMED_CONVERSION",
                "type",
                conversion.Location,
                conversion.TargetType,
            ),
        }
    }
    if !sameUnderlying {
        return []diagnostic.Diagnostic{
            diagnostic.New(
                "INVALID_CONVERSION",
                "type",
                conversion.Location,
                conversion.TargetType,
            ),
        }
    }
    return []diagnostic.Diagnostic{}
}

func ValidateRuntimeHandles(sources []model.SourceFile) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        for use in source.RuntimeHandleUses {
            var resolved model.TypeShape = UnderlyingTypeShape(
                sources,
                source,
                use.Type,
                []text{},
            )
            if ContainsRuntimeHandle(resolved) &&
                !IsChannelPayloadHandleLocation(sources, use.Location) &&
                !IsTransferHandleLocation(sources, use.Location) &&
                !IsTaskIntrinsicHandleLocation(sources, use.Location) &&
                !RuntimeHandlePositionAllowed(use.Position) {
                diagnostics = append(
                    diagnostics,
                    diagnostic.New(
                        "INVALID_RUNTIME_HANDLE_PLACEMENT",
                        "type",
                        use.Location,
                        use.TypeSource,
                    ),
                )
            }
        }
    }
    return diagnostics
}

func ValidateChannels(sources []model.SourceFile) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        for construction in source.ChannelConstructions {
            diagnostics = AppendDiagnostics(
                diagnostics,
                ValidateChannelConstruction(sources, source, construction),
            )
        }
    }
    return diagnostics
}

func ValidateChannelConstruction(
    sources []model.SourceFile,
    source model.SourceFile,
    construction model.ChannelConstruction,
) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    var payload model.TypeShape = UnderlyingTypeShape(
        sources,
        source,
        construction.Payload,
        []text{},
    )
    var forbidden RuntimeHandleSelection = FirstRuntimeHandle(payload)
    var invalidCapacity bool = !construction.CapacityConstant ||
        construction.CapacityValue <= 0
    if invalidCapacity && forbidden.Found &&
        SourcePositionBefore(construction.CapacityPosition, forbidden.Origin.Position) {
        diagnostics = append(diagnostics, InvalidChannelCapacity(construction))
        diagnostics = append(diagnostics, RuntimeHandlePayload(forbidden))
    } else {
        if forbidden.Found {
            diagnostics = append(diagnostics, RuntimeHandlePayload(forbidden))
        }
        if invalidCapacity {
            diagnostics = append(diagnostics, InvalidChannelCapacity(construction))
        }
    }
    return diagnostics
}

func SourcePositionBefore(left model.SourcePosition, right model.SourcePosition) bool {
    if left.Path != right.Path {
        return left.Path < right.Path
    }
    if left.Line != right.Line {
        return left.Line < right.Line
    }
    if left.Column != right.Column {
        return left.Column < right.Column
    }
    return left.SourceOrder < right.SourceOrder
}

func InvalidChannelCapacity(
    construction model.ChannelConstruction,
) diagnostic.Diagnostic {
    return diagnostic.New(
        "INVALID_CHANNEL_CAPACITY",
        "type",
        construction.CapacityPosition.Location,
        construction.CapacityToken,
    )
}

func RuntimeHandlePayload(selected RuntimeHandleSelection) diagnostic.Diagnostic {
    return diagnostic.New(
        "RUNTIME_HANDLE_PAYLOAD",
        "type",
        selected.Origin.Position.Location,
        selected.Origin.Token,
    )
}

func FirstRuntimeHandle(shape model.TypeShape) RuntimeHandleSelection {
    if shape.Kind == model.TypeShapeKind.Task {
        return RuntimeHandleSelection{
            Found: true,
            Kind: model.RuntimeHandleKind.Task,
            NodePath: shape.NodePath,
            Origin: shape.Origin,
        }
    }
    if shape.Kind == model.TypeShapeKind.Channel {
        return RuntimeHandleSelection{
            Found: true,
            Kind: model.RuntimeHandleKind.Channel,
            NodePath: shape.NodePath,
            Origin: shape.Origin,
        }
    }
    if shape.Kind == model.TypeShapeKind.Sender {
        return RuntimeHandleSelection{
            Found: true,
            Kind: model.RuntimeHandleKind.Sender,
            NodePath: shape.NodePath,
            Origin: shape.Origin,
        }
    }
    if shape.Kind == model.TypeShapeKind.Receiver {
        return RuntimeHandleSelection{
            Found: true,
            Kind: model.RuntimeHandleKind.Receiver,
            NodePath: shape.NodePath,
            Origin: shape.Origin,
        }
    }
    var first RuntimeHandleSelection = RuntimeHandleSelection{
        Found: false,
        Kind: model.RuntimeHandleKind.Task,
        NodePath: []int{},
        Origin: EmptyTypeNodeOrigin(),
    }
    for element in shape.Elements {
        var selected RuntimeHandleSelection = FirstRuntimeHandle(element)
        if selected.Found && (!first.Found ||
            TypeNodePathBefore(selected.NodePath, first.NodePath)) {
            first = selected
        }
    }
    return first
}

func TypeNodePathBefore(left []int, right []int) bool {
    var index int = 0
    for index < len(left) && index < len(right) {
        if left[index] != right[index] {
            return left[index] < right[index]
        }
        index = index + 1
    }
    return len(left) < len(right)
}

func IsChannelPayloadHandleLocation(sources []model.SourceFile, location text) bool {
    for source in sources {
        for construction in source.ChannelConstructions {
            var payload model.TypeShape = UnderlyingTypeShape(
                sources,
                source,
                construction.Payload,
                []text{},
            )
            var selected RuntimeHandleSelection = FirstRuntimeHandle(payload)
            if construction.Payload.Origin.Position.Location == location ||
                (selected.Found && selected.Origin.Position.Location == location) {
                return true
            }
        }
    }
    return false
}

func IsTransferHandleLocation(sources []model.SourceFile, location text) bool {
    for source in sources {
        for transfer in source.Transfers {
            for argument in transfer.Arguments {
                if argument.Position.Location == location ||
                    (argument.HasRuntimeHandleOrigin &&
                        argument.RuntimeHandleOrigin.Position.Location == location) {
                    return true
                }
            }
        }
    }
    return false
}

func IsTaskIntrinsicHandleLocation(sources []model.SourceFile, location text) bool {
    for source in sources {
        for use in source.TaskIntrinsicUses {
            if use.Argument.Location == location ||
                use.ArgumentPosition.Location == location {
                return true
            }
        }
    }
    return false
}

func ValidateReceiverMoves(graph load.Graph) []diagnostic.Diagnostic {
    var violations []ReceiverViolation = []ReceiverViolation{}
    for source in graph.Sources {
        var holders []ReceiverHolderState = []ReceiverHolderState{}
        for use in source.ReceiverUses {
            if use.Kind == model.ReceiverUseKind.Create {
                holders = SetReceiverHolder(
                    holders,
                    use.Owner,
                    use.DestinationHolder,
                    use.ReceiverIdentity,
                    true,
                )
            } else {
                var sourceHolder ReceiverHolderSelection = FindReceiverHolder(
                    holders,
                    use.Owner,
                    use.SourceHolder,
                )
                if !sourceHolder.Found || !sourceHolder.State.Active {
                    violations = InsertReceiverViolation(
                        violations,
                        ReceiverViolation{
                            Path: load.ModuleRelativeSourcePath(graph.Manifest, source.Path),
                            Line: use.Position.Line,
                            Column: use.Position.Column,
                            Diagnostic: diagnostic.New(
                                "RECEIVER_ALREADY_MOVED",
                                "type",
                                use.Position.Location,
                                use.SourceHolder,
                            ),
                        },
                    )
                } else if ReceiverUseMoves(graph.Sources, source, use) {
                    holders = SetReceiverHolder(
                        holders,
                        use.Owner,
                        use.SourceHolder,
                        sourceHolder.State.ReceiverIdentity,
                        false,
                    )
                    holders = SetReceiverHolder(
                        holders,
                        use.Owner,
                        use.DestinationHolder,
                        sourceHolder.State.ReceiverIdentity,
                        true,
                    )
                }
            }
        }
    }
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for violation in violations {
        diagnostics = append(diagnostics, violation.Diagnostic)
    }
    return diagnostics
}

func FindReceiverHolder(
    values []ReceiverHolderState,
    owner text,
    holder text,
) ReceiverHolderSelection {
    var index int = 0
    for value in values {
        if value.Owner == owner && value.Holder == holder {
            return ReceiverHolderSelection{Found: true, Index: index, State: value}
        }
        index = index + 1
    }
    return ReceiverHolderSelection{
        Found: false,
        Index: 0,
        State: ReceiverHolderState{
            Owner: "",
            Holder: "",
            ReceiverIdentity: "",
            Active: false,
        },
    }
}

func SetReceiverHolder(
    values []ReceiverHolderState,
    owner text,
    holder text,
    receiverIdentity text,
    active bool,
) []ReceiverHolderState {
    var result []ReceiverHolderState = values
    var selected ReceiverHolderSelection = FindReceiverHolder(result, owner, holder)
    var replacement ReceiverHolderState = ReceiverHolderState{
        Owner: owner,
        Holder: holder,
        ReceiverIdentity: receiverIdentity,
        Active: active,
    }
    if selected.Found {
        result[selected.Index] = replacement
    } else {
        result = append(result, replacement)
    }
    return result
}

func InsertReceiverViolation(
    values []ReceiverViolation,
    candidate ReceiverViolation,
) []ReceiverViolation {
    var result []ReceiverViolation = []ReceiverViolation{}
    var inserted bool = false
    for value in values {
        if !inserted && ReceiverViolationBefore(candidate, value) {
            result = append(result, candidate)
            inserted = true
        }
        result = append(result, value)
    }
    if !inserted {
        result = append(result, candidate)
    }
    return result
}

func ReceiverViolationBefore(left ReceiverViolation, right ReceiverViolation) bool {
    if left.Path != right.Path {
        return left.Path < right.Path
    }
    if left.Line != right.Line {
        return left.Line < right.Line
    }
    return left.Column < right.Column
}

func ReceiverUseMoves(
    sources []model.SourceFile,
    source model.SourceFile,
    use model.ReceiverUse,
) bool {
    if use.Kind == model.ReceiverUseKind.Assignment {
        return true
    }
    if use.Kind != model.ReceiverUseKind.Argument ||
        (use.ConsumerScope != model.ReceiverConsumerScope.OrdinaryFunction &&
            use.ConsumerScope != model.ReceiverConsumerScope.AttachedOiFunction) {
        return false
    }
    return ConsumerParameterIsReceiver(sources, source, use)
}

func ConsumerParameterIsReceiver(
    sources []model.SourceFile,
    source model.SourceFile,
    use model.ReceiverUse,
) bool {
    var packageName text = CallPackage(source, use.ConsumerTarget)
    var name text = CallName(use.ConsumerTarget)
    for candidate in sources {
        if candidate.Package == packageName {
            for declaration in candidate.Declarations {
                if declaration.Name == name && IsCallableDeclaration(declaration) {
                    var index int = 0
                    for parameter in declaration.Parameters {
                        if index == use.ArgumentIndex {
                            var outer model.TypeShape = OuterTypeShape(
                                sources,
                                candidate,
                                parameter.Type,
                                []text{},
                            )
                            return outer.Kind == model.TypeShapeKind.Receiver
                        }
                        index = index + 1
                    }
                }
            }
        }
    }
    return false
}

func ValidateEntries(graph load.Graph) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    var entries []model.Entry = []model.Entry{}
    for source in graph.Sources {
        if ContainsPath(graph.RootPaths, source.Path) && source.Package == "main" {
            entries = AppendEntries(entries, source.Entries)
        }
    }
    if len(entries) == 0 {
        diagnostics = append(
            diagnostics,
            diagnostic.New("MISSING_ENTRY", "type", RootLocation(graph), "lowercase main"),
        )
    }
    if len(entries) > 1 {
        for index in IndexesAfterFirst(entries) {
            diagnostics = append(
                diagnostics,
                diagnostic.New(
                    "DUPLICATE_ENTRY",
                    "type",
                    entries[index].Location,
                    "lowercase main",
                ),
            )
        }
    }
    for entry in entries {
        if entry.ResultSource != none {
            diagnostics = append(
                diagnostics,
                diagnostic.New(
                    "ENTRY_RESULT_FORBIDDEN",
                    "type",
                    entry.Location,
                    "main result",
                ),
            )
        }
        for location in entry.ValueReturnLocations {
            diagnostics = append(
                diagnostics,
                diagnostic.New("ENTRY_RETURN_VALUE", "type", location, "main value return"),
            )
        }
    }
    return diagnostics
}

func ValidateAuthorityUse(
    graph load.Graph,
    reachable []text,
    available []text,
) []diagnostic.Diagnostic {
    var requirements []AuthorityRequirement = AuthorityRequirements(graph.Sources, reachable)
    var contexts []AuthorityContext = AuthorityContexts(graph, available)
    var located []LocatedDiagnostic = []LocatedDiagnostic{}
    var seen []AuthorityViolationKey = []AuthorityViolationKey{}
    for context in contexts {
        for requirement in requirements {
            if context.Caller == requirement.Caller && !requirement.Optional &&
                !ContainsText(context.Available, requirement.Authority) {
                var key AuthorityViolationKey = AuthorityViolationKey{
                    CallID: requirement.CallID,
                    Authority: requirement.Authority,
                }
                if !ContainsAuthorityViolationKey(seen, key) {
                    seen = append(seen, key)
                    located = InsertLocatedDiagnostic(
                        located,
                        LocatedDiagnostic{
                            Position: requirement.Position,
                            Diagnostic: diagnostic.New(
                                "UNMAPPED_EFFECT",
                                "effect mapping",
                                requirement.Position.Location,
                                requirement.Authority,
                            ),
                        },
                    )
                }
            }
        }
    }
    return LocatedDiagnostics(located)
}

func AuthorityContexts(graph load.Graph, available []text) []AuthorityContext {
    var contexts []AuthorityContext = RootAuthorityContexts(graph, available)
    var changed bool = true
    for changed {
        changed = false
        var additions []AuthorityContext = []AuthorityContext{}
        for context in contexts {
            for source in graph.Sources {
                for call in source.Calls {
                    var caller text = DeclarationKey(source.Package, call.Caller)
                    if caller == context.Caller {
                        var target CallableSelection = ResolveCallableSelection(
                            graph.Sources,
                            source,
                            call,
                        )
                        if target.Found && target.Kind == model.DeclarationKind.Function {
                            var targetKey text = DeclarationKey(
                                graph.Sources[target.SourceIndex].Package,
                                target.Name,
                            )
                            var targetAvailable []text = context.Available
                            if IsOiCall(call) {
                                targetAvailable = OiChildAuthorities(
                                    graph.Sources,
                                    source,
                                    call,
                                    context.Available,
                                )
                            }
                            var candidate AuthorityContext = AuthorityContext{
                                Caller: targetKey,
                                Available: targetAvailable,
                            }
                            if !ContainsAuthorityContext(contexts, candidate) &&
                                !ContainsAuthorityContext(additions, candidate) {
                                additions = append(additions, candidate)
                                changed = true
                            }
                        }
                    }
                }
            }
        }
        contexts = AppendAuthorityContexts(contexts, additions)
    }
    return contexts
}

func RootAuthorityContexts(graph load.Graph, available []text) []AuthorityContext {
    var contexts []AuthorityContext = []AuthorityContext{}
    for source in graph.Sources {
        if ContainsPath(graph.RootPaths, source.Path) && source.Package == "main" &&
            len(source.Entries) != 0 {
            var candidate AuthorityContext = AuthorityContext{
                Caller: DeclarationKey(source.Package, "main"),
                Available: DistinctAuthorities(available),
            }
            if !ContainsAuthorityContext(contexts, candidate) {
                contexts = append(contexts, candidate)
            }
        }
    }
    return contexts
}

func AppendAuthorityContexts(
    values []AuthorityContext,
    more []AuthorityContext,
) []AuthorityContext {
    var result []AuthorityContext = values
    for value in more {
        result = append(result, value)
    }
    return result
}

func ContainsAuthorityContext(values []AuthorityContext, wanted AuthorityContext) bool {
    for value in values {
        if value.Caller == wanted.Caller && SameAuthoritySet(value.Available, wanted.Available) {
            return true
        }
    }
    return false
}

func SameAuthoritySet(left []text, right []text) bool {
    if len(left) != len(right) {
        return false
    }
    for value in left {
        if !ContainsText(right, value) {
            return false
        }
    }
    return true
}

func OiChildAuthorities(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
    parent []text,
) []text {
    var target text = ResolvedCallKey(sources, source, call)
    if target == "" {
        return []text{}
    }
    var reachable []text = ReachableFrom(sources, []text{target})
    var demand []text = Authorities(sources, reachable)
    return IntersectAuthorities(parent, demand)
}

func IntersectAuthorities(available []text, demanded []text) []text {
    var intersection []text = []text{}
    for authority in demanded {
        if ContainsText(available, authority) && !ContainsText(intersection, authority) {
            intersection = append(intersection, authority)
        }
    }
    return intersection
}

func DistinctAuthorities(values []text) []text {
    var result []text = []text{}
    for value in values {
        if !ContainsText(result, value) {
            result = append(result, value)
        }
    }
    return result
}

func AuthorityRequirements(
    sources []model.SourceFile,
    reachable []text,
) []AuthorityRequirement {
    var requirements []AuthorityRequirement = []AuthorityRequirement{}
    for source in sources {
        for call in source.Calls {
            var caller text = DeclarationKey(source.Package, call.Caller)
            if ContainsText(reachable, caller) {
                var target CallableSelection = ResolveCallableSelection(sources, source, call)
                if target.Found && target.Kind == model.DeclarationKind.Effect {
                    var targetSource model.SourceFile = sources[target.SourceIndex]
                    for authorityUse in targetSource.AuthorityUses {
                        if authorityUse.Declaration == target.Name {
                            var requirement AuthorityRequirement = AuthorityRequirement{
                                Caller: caller,
                                CallID: call.ID,
                                Authority: authorityUse.Authority,
                                Optional: DirectCapturedEffectCall(source, call),
                                Position: call.Position,
                            }
                            if !ContainsAuthorityRequirement(requirements, requirement) {
                                requirements = InsertAuthorityRequirement(requirements, requirement)
                            }
                        }
                    }
                }
            }
        }
    }
    return requirements
}

func ContainsAuthorityRequirement(
    values []AuthorityRequirement,
    wanted AuthorityRequirement,
) bool {
    for value in values {
        if value.CallID == wanted.CallID && value.Authority == wanted.Authority {
            return true
        }
    }
    return false
}

func InsertAuthorityRequirement(
    values []AuthorityRequirement,
    candidate AuthorityRequirement,
) []AuthorityRequirement {
    var result []AuthorityRequirement = []AuthorityRequirement{}
    var inserted bool = false
    for value in values {
        if !inserted && AuthorityRequirementBefore(candidate, value) {
            result = append(result, candidate)
            inserted = true
        }
        result = append(result, value)
    }
    if !inserted {
        result = append(result, candidate)
    }
    return result
}

func AuthorityRequirementBefore(
    left AuthorityRequirement,
    right AuthorityRequirement,
) bool {
    if SourcePositionBefore(left.Position, right.Position) {
        return true
    }
    if SourcePositionBefore(right.Position, left.Position) {
        return false
    }
    return left.Authority < right.Authority
}

func DirectCapturedEffectCall(source model.SourceFile, call model.CallSite) bool {
    for boundary in source.OptionalBoundaries {
        if boundary.Kind == model.OptionalBoundaryKind.DirectCapture &&
            boundary.Caller == call.Caller && boundary.OperandCallID == call.ID {
            return true
        }
    }
    return false
}

func ResolveCallableSelection(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
) CallableSelection {
    var packageName text = CallPackage(source, call.Target)
    var name text = CallName(call.Target)
    for index in SourceIndexes(sources) {
        if sources[index].Package == packageName {
            for declaration in sources[index].Declarations {
                if declaration.Name == name && IsCallableDeclaration(declaration) &&
                    (packageName == source.Package || declaration.Exported) {
                    return CallableSelection{
                        Found: true,
                        SourceIndex: index,
                        Name: declaration.Name,
                        Kind: declaration.Kind,
                    }
                }
            }
        }
    }
    return CallableSelection{
        Found: false,
        SourceIndex: 0,
        Name: "",
        Kind: model.DeclarationKind.Function,
    }
}

func ContainsAuthorityViolationKey(
    values []AuthorityViolationKey,
    wanted AuthorityViolationKey,
) bool {
    for value in values {
        if value.CallID == wanted.CallID && value.Authority == wanted.Authority {
            return true
        }
    }
    return false
}

func ValidateShardUse(graph load.Graph, reachable []text) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in graph.Sources {
        for shardUse in source.ShardUses {
            var caller text = DeclarationKey(source.Package, shardUse.Caller)
            if ContainsText(reachable, caller) &&
                !ContainsText(graph.ManifestClosure, shardUse.Path) {
                diagnostics = append(
                    diagnostics,
                    diagnostic.New(
                        "MISSING_RUNTIME_SHARD",
                        "module",
                        shardUse.Location,
                        shardUse.Path,
                    ),
                )
            }
        }
    }
    return diagnostics
}

func ReachableCallers(graph load.Graph) []text {
    var roots []text = []text{}
    for source in graph.Sources {
        if ContainsPath(graph.RootPaths, source.Path) && source.Package == "main" {
            for entry in source.Entries {
                var root text = DeclarationKey(source.Package, "main")
                if !ContainsText(roots, root) {
                    roots = append(roots, root)
                }
            }
        }
    }
    return ReachableFrom(graph.Sources, roots)
}

func ReachableFrom(sources []model.SourceFile, roots []text) []text {
    var reachable []text = roots
    var changed bool = true
    for changed {
        changed = false
        for source in sources {
            for call in source.Calls {
                var caller text = DeclarationKey(source.Package, call.Caller)
                var target text = ResolvedCallKey(sources, source, call)
                if ContainsText(reachable, caller) && target != "" &&
                    !ContainsText(reachable, target) {
                    reachable = append(reachable, target)
                    changed = true
                }
            }
        }
    }
    return reachable
}

func Authorities(sources []model.SourceFile, reachable []text) []text {
    var values []text = []text{}
    var requirements []AuthorityRequirement = AuthorityRequirements(sources, reachable)
    for requirement in requirements {
        if !ContainsText(values, requirement.Authority) {
            values = append(values, requirement.Authority)
        }
    }
    return values
}

func Shards(sources []model.SourceFile, reachable []text) []text {
    var values []text = []text{}
    for source in sources {
        for shardUse in source.ShardUses {
            var caller text = DeclarationKey(source.Package, shardUse.Caller)
            if ContainsText(reachable, caller) && !ContainsText(values, shardUse.Path) {
                values = append(values, shardUse.Path)
            }
        }
    }
    return values
}

func LocalDiagnostics(sources []model.SourceFile, phase text) []diagnostic.Diagnostic {
    var diagnostics []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        for fact in source.StaticFacts {
            if fact.Phase == phase {
                diagnostics = append(
                    diagnostics,
                    diagnostic.New(fact.Category, fact.Phase, fact.Location, fact.Detail),
                )
            }
        }
    }
    return diagnostics
}

func AppendDiagnostics(
    values []diagnostic.Diagnostic,
    more []diagnostic.Diagnostic,
) []diagnostic.Diagnostic {
    var result []diagnostic.Diagnostic = values
    for item in more {
        result = append(result, item)
    }
    return result
}

func AppendLocatedDiagnostics(
    values []LocatedDiagnostic,
    more []LocatedDiagnostic,
) []LocatedDiagnostic {
    var result []LocatedDiagnostic = values
    for item in more {
        result = InsertLocatedDiagnostic(result, item)
    }
    return result
}

func InsertLocatedDiagnostic(
    values []LocatedDiagnostic,
    candidate LocatedDiagnostic,
) []LocatedDiagnostic {
    var result []LocatedDiagnostic = []LocatedDiagnostic{}
    var inserted bool = false
    for value in values {
        if !inserted && LocatedDiagnosticBefore(candidate, value) {
            result = append(result, candidate)
            inserted = true
        }
        result = append(result, value)
    }
    if !inserted {
        result = append(result, candidate)
    }
    return result
}

func LocatedDiagnosticBefore(left LocatedDiagnostic, right LocatedDiagnostic) bool {
    if SourcePositionBefore(left.Position, right.Position) {
        return true
    }
    if SourcePositionBefore(right.Position, left.Position) {
        return false
    }
    return left.Diagnostic.Category < right.Diagnostic.Category
}

func LocatedDiagnostics(values []LocatedDiagnostic) []diagnostic.Diagnostic {
    var result []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for value in values {
        result = append(result, value.Diagnostic)
    }
    return result
}

func AppendSources(
    values []model.SourceFile,
    more []model.SourceFile,
) []model.SourceFile {
    var result []model.SourceFile = values
    for item in more {
        result = append(result, item)
    }
    return result
}

func AppendEntries(values []model.Entry, more []model.Entry) []model.Entry {
    var result []model.Entry = values
    for item in more {
        result = append(result, item)
    }
    return result
}

func ContainsText(values []text, wanted text) bool {
    for value in values {
        if value == wanted {
            return true
        }
    }
    return false
}

func ContainsPath(values []fs.Path, wanted fs.Path) bool {
    for value in values {
        if value == wanted {
            return true
        }
    }
    return false
}

func HasTypeDeclaration(sources []model.SourceFile, packageName text, name text) bool {
    for source in sources {
        if source.Package == packageName {
            for declaration in source.Declarations {
                if declaration.Kind == model.DeclarationKind.Type && declaration.Name == name {
                    return true
                }
            }
        }
    }
    return false
}

func HasExportedType(sources []model.SourceFile, packageName text, name text) bool {
    for source in sources {
        if source.Package == packageName {
            for declaration in source.Declarations {
                if declaration.Kind == model.DeclarationKind.Type && declaration.Name == name &&
                    declaration.Exported {
                    return true
                }
            }
        }
    }
    return false
}

func HasCallableDeclaration(sources []model.SourceFile, packageName text, name text) bool {
    for source in sources {
        if source.Package == packageName {
            for declaration in source.Declarations {
                if declaration.Name == name && IsCallableDeclaration(declaration) {
                    return true
                }
            }
        }
    }
    return false
}

func HasExportedCallable(sources []model.SourceFile, packageName text, name text) bool {
    for source in sources {
        if source.Package == packageName {
            for declaration in source.Declarations {
                if declaration.Name == name && declaration.Exported &&
                    IsCallableDeclaration(declaration) {
                    return true
                }
            }
        }
    }
    return false
}

func IsCallableDeclaration(declaration model.Declaration) bool {
    return declaration.Kind == model.DeclarationKind.Function ||
        declaration.Kind == model.DeclarationKind.Effect
}

func ResolveCallResult(
    sources []model.SourceFile,
    source model.SourceFile,
    callID text,
) ResolvedType {
    for call in source.Calls {
        if call.ID == callID {
            var packageName text = CallPackage(source, call.Target)
            var name text = CallName(call.Target)
            for index in SourceIndexes(sources) {
                if sources[index].Package == packageName {
                    for declaration in sources[index].Declarations {
                        if declaration.Name == name && IsCallableDeclaration(declaration) &&
                            declaration.HasResult &&
                            (packageName == source.Package || declaration.Exported) {
                            var transformed TransformResult = TransformCallResult(
                                sources,
                                sources[index],
                                call,
                                declaration,
                            )
                            if transformed.Valid {
                                return ResolvedType{
                                    Found: true,
                                    SourceIndex: index,
                                    Shape: transformed.Shape,
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    var collection ResolvedType = ResolveCollectionResult(sources, source, callID)
    if collection.Found {
        return collection
    }
    return ResolvedType{
        Found: false,
        SourceIndex: 0,
        Shape: EmptyTypeShape(),
    }
}

func ResolveCollectionResult(
    sources []model.SourceFile,
    source model.SourceFile,
    callID text,
) ResolvedType {
    for call in source.CollectionCalls {
        if call.ID == callID && len(call.Arguments) == CollectionBuiltinArity(CallName(call.Target)) {
            var collection ResolvedType = ResolveArgumentType(sources, source, call.Arguments[0])
            if collection.Found {
                var surface model.TypeShape = SurfaceTypeShape(
                    sources[collection.SourceIndex],
                    collection.Shape,
                )
                var outer model.TypeShape = OuterTypeShape(
                    sources,
                    sources[collection.SourceIndex],
                    collection.Shape,
                    []text{},
                )
                var selected typecheck.CollectionSelection = typecheck.SelectCollection(surface, outer)
                var signature typecheck.BuiltinSignature = typecheck.Signature(
                    CallName(call.Target),
                    selected,
                )
                if signature.Found {
                    return ResolvedType{
                        Found: true,
                        SourceIndex: collection.SourceIndex,
                        Shape: signature.Result,
                    }
                }
            }
        }
    }
    for use in source.CollectionIndexes {
        if use.ID == callID {
            var collection ResolvedType = ResolveArgumentType(sources, source, use.Collection)
            if collection.Found {
                var surface model.TypeShape = SurfaceTypeShape(
                    sources[collection.SourceIndex],
                    collection.Shape,
                )
                var outer model.TypeShape = OuterTypeShape(
                    sources,
                    sources[collection.SourceIndex],
                    collection.Shape,
                    []text{},
                )
                var selected typecheck.CollectionSelection = typecheck.SelectCollection(surface, outer)
                if selected.Found && selected.Kind != model.TypeShapeKind.Set {
                    return ResolvedType{
                        Found: true,
                        SourceIndex: collection.SourceIndex,
                        Shape: selected.Value,
                    }
                }
            }
        }
    }
    return ResolvedType{Found: false, SourceIndex: 0, Shape: EmptyTypeShape()}
}

func ValidateTypeCompatibility(
    sources []model.SourceFile,
    actualSource model.SourceFile,
    actual model.TypeShape,
    targetSource model.SourceFile,
    target model.TypeShape,
    location text,
) []diagnostic.Diagnostic {
    if SameType(actualSource, actual, targetSource, target) {
        return []diagnostic.Diagnostic{}
    }
    if SameUnderlyingType(sources, actualSource, actual, targetSource, target) {
        return []diagnostic.Diagnostic{
            diagnostic.New(
                "IMPLICIT_NAMED_CONVERSION",
                "type",
                location,
                TypeShapeDetail(target),
            ),
        }
    }
    return []diagnostic.Diagnostic{
        diagnostic.New("TYPE_MISMATCH", "type", location, TypeShapeDetail(target)),
    }
}

func SameType(
    leftSource model.SourceFile,
    left model.TypeShape,
    rightSource model.SourceFile,
    right model.TypeShape,
) bool {
    var resolvedLeft model.TypeShape = SurfaceTypeShape(leftSource, left)
    var resolvedRight model.TypeShape = SurfaceTypeShape(rightSource, right)
    return SameTypeShape(resolvedLeft, resolvedRight)
}

func SameUnderlyingType(
    sources []model.SourceFile,
    leftSource model.SourceFile,
    left model.TypeShape,
    rightSource model.SourceFile,
    right model.TypeShape,
) bool {
    var resolvedLeft model.TypeShape = UnderlyingTypeShape(
        sources,
        leftSource,
        left,
        []text{},
    )
    var resolvedRight model.TypeShape = UnderlyingTypeShape(
        sources,
        rightSource,
        right,
        []text{},
    )
    return SameTypeShape(resolvedLeft, resolvedRight)
}

func SurfaceTypeShape(
    source model.SourceFile,
    shape model.TypeShape,
) model.TypeShape {
    var result model.TypeShape = shape
    if shape.Kind == model.TypeShapeKind.Named {
        result.Name = QualifiedTypeName(source, shape.Name)
    }
    result.Elements = []model.TypeShape{}
    for element in shape.Elements {
        result.Elements = append(result.Elements, SurfaceTypeShape(source, element))
    }
    return result
}

func UnderlyingTypeShape(
    sources []model.SourceFile,
    source model.SourceFile,
    shape model.TypeShape,
    visited []text,
) model.TypeShape {
    if shape.Kind == model.TypeShapeKind.Named {
        var key text = QualifiedTypeName(source, shape.Name)
        if ContainsText(visited, key) {
            var circular model.TypeShape = shape
            circular.Name = key
            return circular
        }
        for candidateSource in sources {
            for declaration in candidateSource.Declarations {
                if declaration.Kind == model.DeclarationKind.Type &&
                    DeclarationKey(candidateSource.Package, declaration.Name) == key &&
                    declaration.HasUnderlying {
                    var resolved model.TypeShape = UnderlyingTypeShape(
                        sources,
                        candidateSource,
                        declaration.Underlying,
                        append(visited, key),
                    )
                    return RebaseTypeShape(resolved, shape.NodePath)
                }
            }
        }
        var unresolved model.TypeShape = shape
        unresolved.Name = key
        return unresolved
    }
    var result model.TypeShape = shape
    result.Elements = []model.TypeShape{}
    for element in shape.Elements {
        result.Elements = append(
            result.Elements,
            UnderlyingTypeShape(sources, source, element, visited),
        )
    }
    return result
}

func RebaseTypeShape(shape model.TypeShape, prefix []int) model.TypeShape {
    var result model.TypeShape = shape
    result.NodePath = AppendNodePath(prefix, shape.NodePath)
    result.Elements = []model.TypeShape{}
    for element in shape.Elements {
        result.Elements = append(result.Elements, RebaseTypeShape(element, prefix))
    }
    return result
}

func AppendNodePath(prefix []int, suffix []int) []int {
    var result []int = []int{}
    for value in prefix {
        result = append(result, value)
    }
    for value in suffix {
        result = append(result, value)
    }
    return result
}

func SameTypeShape(
    left model.TypeShape,
    right model.TypeShape,
) bool {
    if left.Kind != right.Kind || left.Name != right.Name ||
        left.ContractSource != right.ContractSource ||
        len(left.Labels) != len(right.Labels) ||
        len(left.Elements) != len(right.Elements) {
        return false
    }
    for index in TextIndexes(left.Labels) {
        if left.Labels[index] != right.Labels[index] {
            return false
        }
    }
    for index in TypeShapeIndexes(left.Elements) {
        if !SameTypeShape(left.Elements[index], right.Elements[index]) {
            return false
        }
    }
    return true
}

func ContainsRuntimeHandle(shape model.TypeShape) bool {
    if shape.Kind == model.TypeShapeKind.Task ||
        shape.Kind == model.TypeShapeKind.Channel ||
        shape.Kind == model.TypeShapeKind.Sender ||
        shape.Kind == model.TypeShapeKind.Receiver {
        return true
    }
    for element in shape.Elements {
        if ContainsRuntimeHandle(element) {
            return true
        }
    }
    return false
}

func OuterTypeShape(
    sources []model.SourceFile,
    source model.SourceFile,
    shape model.TypeShape,
    visited []text,
) model.TypeShape {
    if shape.Kind != model.TypeShapeKind.Named {
        return SurfaceTypeShape(source, shape)
    }
    var key text = QualifiedTypeName(source, shape.Name)
    if ContainsText(visited, key) {
        return NamedTypeShape(key)
    }
    for candidateSource in sources {
        for declaration in candidateSource.Declarations {
            if declaration.Kind == model.DeclarationKind.Type &&
                DeclarationKey(candidateSource.Package, declaration.Name) == key &&
                declaration.HasUnderlying {
                return OuterTypeShape(
                    sources,
                    candidateSource,
                    declaration.Underlying,
                    append(visited, key),
                )
            }
        }
    }
    return NamedTypeShape(key)
}

func TransformCallResult(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
    declaration model.Declaration,
) TransformResult {
    var result TransformResult = TransformResult{
        Shape: declaration.Result,
        Valid: true,
        Diagnostics: []diagnostic.Diagnostic{},
    }
    for transform in call.ResultTransforms {
        if result.Valid && transform.Kind == model.ResultTransformKind.WrapTask {
            if declaration.Kind == model.DeclarationKind.Function {
                result.Shape = UnaryTypeShape(model.TypeShapeKind.Task, result.Shape)
            } else {
                result.Valid = false
                var category text = "OI_REQUIRES_NAMED_FUNCTION"
                if declaration.Kind == model.DeclarationKind.Effect {
                    category = "OI_EFFECT_FORBIDDEN"
                }
                result.Diagnostics = append(
                    result.Diagnostics,
                    diagnostic.New(category, "type", transform.Location, call.Target),
                )
            }
        } else if result.Valid && transform.Kind == model.ResultTransformKind.AwaitTask {
            var outer model.TypeShape = OuterTypeShape(sources, source, result.Shape, []text{})
            if outer.Kind == model.TypeShapeKind.Task && len(outer.Elements) == 1 {
                result.Shape = outer.Elements[0]
            } else {
                result.Valid = false
                result.Diagnostics = append(
                    result.Diagnostics,
                    diagnostic.New("INVALID_AWAIT_TARGET", "type", transform.Location, call.Target),
                )
            }
        } else if result.Valid && transform.Kind == model.ResultTransformKind.WrapOutcome {
            result.Shape = UnaryTypeShape(model.TypeShapeKind.Outcome, result.Shape)
        } else if result.Valid && transform.Kind == model.ResultTransformKind.IndexElement {
            var outer model.TypeShape = OuterTypeShape(sources, source, result.Shape, []text{})
            if outer.Kind == model.TypeShapeKind.Slice && len(outer.Elements) == 1 {
                result.Shape = outer.Elements[0]
            } else {
                result.Valid = false
                result.Diagnostics = append(
                    result.Diagnostics,
                    diagnostic.New("INVALID_INDEX_TARGET", "type", transform.Location, call.Target),
                )
            }
        } else if result.Valid && transform.Kind == model.ResultTransformKind.SelectField {
            var outer model.TypeShape = OuterTypeShape(sources, source, result.Shape, []text{})
            var selected SelectedType = SelectedFieldType(outer, transform.Label)
            if selected.Found {
                result.Shape = selected.Shape
            } else {
                result.Valid = false
                result.Diagnostics = append(
                    result.Diagnostics,
                    diagnostic.New("UNKNOWN_NAME", "type", transform.Location, transform.Label),
                )
            }
        }
    }
    return result
}

func UnaryTypeShape(
    kind model.TypeShapeKind,
    element model.TypeShape,
) model.TypeShape {
    return model.TypeShape{
        Kind: kind,
        Name: "",
        NodePath: []int{},
        Labels: []text{},
        Elements: []model.TypeShape{element},
        ContractSource: "",
        Origin: EmptyTypeNodeOrigin(),
    }
}

func SelectedFieldType(shape model.TypeShape, label text) SelectedType {
    if shape.Kind == model.TypeShapeKind.Struct {
        for index in TextIndexes(shape.Labels) {
            if shape.Labels[index] == label {
                return SelectedType{Shape: shape.Elements[index], Found: true}
            }
        }
    } else if shape.Kind == model.TypeShapeKind.Outcome && len(shape.Elements) == 1 {
        if label == "Ok" {
            return SelectedType{Shape: BuiltinTypeShape("bool"), Found: true}
        }
        if label == "Value" {
            return SelectedType{
                Shape: UnaryTypeShape(model.TypeShapeKind.Optional, shape.Elements[0]),
                Found: true,
            }
        }
        if label == "Failure" {
            return SelectedType{
                Shape: UnaryTypeShape(
                    model.TypeShapeKind.Optional,
                    BuiltinTypeShape("failure"),
                ),
                Found: true,
            }
        }
    } else if shape.Kind == model.TypeShapeKind.Channel && len(shape.Elements) == 1 {
        if label == "Send" {
            return SelectedType{
                Shape: UnaryTypeShape(model.TypeShapeKind.Sender, shape.Elements[0]),
                Found: true,
            }
        }
        if label == "Receive" {
            return SelectedType{
                Shape: UnaryTypeShape(model.TypeShapeKind.Receiver, shape.Elements[0]),
                Found: true,
            }
        }
    } else if shape.Kind == model.TypeShapeKind.Builtin && shape.Name == "failure" {
        if label == "Trace" {
            return SelectedType{
                Shape: UnaryTypeShape(model.TypeShapeKind.Slice, BuiltinTypeShape("text")),
                Found: true,
            }
        }
        if label == "Category" || label == "Phase" || label == "Location" ||
            label == "Detail" {
            return SelectedType{Shape: BuiltinTypeShape("text"), Found: true}
        }
    }
    return SelectedType{Shape: EmptyTypeShape(), Found: false}
}

func BuiltinTypeShape(name text) model.TypeShape {
    return model.TypeShape{
        Kind: model.TypeShapeKind.Builtin,
        Name: name,
        NodePath: []int{},
        Labels: []text{},
        Elements: []model.TypeShape{},
        ContractSource: "",
        Origin: EmptyTypeNodeOrigin(),
    }
}

func NamedTypeShape(name text) model.TypeShape {
    return model.TypeShape{
        Kind: model.TypeShapeKind.Named,
        Name: name,
        NodePath: []int{},
        Labels: []text{},
        Elements: []model.TypeShape{},
        ContractSource: "",
        Origin: EmptyTypeNodeOrigin(),
    }
}

func EmptyTypeNodeOrigin() model.TypeNodeOrigin {
    return model.TypeNodeOrigin{
        Token: "",
        Position: model.SourcePosition{
            Path: "",
            Line: 0,
            Column: 0,
            Location: "",
            SourceOrder: 0,
        },
    }
}

func RuntimeHandlePositionAllowed(position model.RuntimeHandlePosition) bool {
    return position == model.RuntimeHandlePosition.Local ||
        position == model.RuntimeHandlePosition.OrdinaryParameter ||
        position == model.RuntimeHandlePosition.AttachedOiParameter
}

func ArgumentIndexes(arguments []model.Argument) []int {
    return [the integer indexes zero through len of {arguments} minus one in ascending order];
}

func SourceIndexes(values []model.SourceFile) []int {
    return [the integer indexes zero through len of {values} minus one in ascending order];
}

func SourceIndexForPath(values []model.SourceFile, path fs.Path) int {
    var index int = 0
    for value in values {
        if value.Path == path {
            return index
        }
        index = index + 1
    }
    return 0
}

func TextIndexes(values []text) []int {
    return [the integer indexes zero through len of {values} minus one in ascending order];
}

func TypeShapeIndexes(values []model.TypeShape) []int {
    return [the integer indexes zero through len of {values} minus one in ascending order];
}

func EmptyTypeShape() model.TypeShape {
    return BuiltinTypeShape("")
}

func DeclarationKey(packageName text, name text) text {
    return [the unambiguous declaration key for package {packageName} and name {name}];
}

func ResolvedCallKey(
    sources []model.SourceFile,
    source model.SourceFile,
    call model.CallSite,
) text {
    var targetPackage text = CallPackage(source, call.Target)
    var targetName text = CallName(call.Target)
    if targetName == "main" || !HasCallableDeclaration(sources, targetPackage, targetName) {
        return ""
    }
    if targetPackage != source.Package &&
        !HasExportedCallable(sources, targetPackage, targetName) {
        return ""
    }
    return DeclarationKey(targetPackage, targetName)
}

func ReferencePackage(source model.SourceFile, name text) text {
    return [the package selected by raw type reference {name} and {source.Imports}, defaulting to {source.Package}];
}

func ReferenceName(name text) text {
    return [the unqualified identifier in raw type reference {name}];
}

func QualifiedTypeName(source model.SourceFile, name text) text {
    return [the declaration key selected by raw named type {name} and {source.Imports}, defaulting to
        {source.Package} without reading source text or filesystem state];
}

func TypeShapeDetail(shape model.TypeShape) text {
    return [a concise deterministic display of structured {shape} for one diagnostic detail];
}

func CallPackage(source model.SourceFile, target text) text {
    return [the package selected by raw call target {target} and {source.Imports}, defaulting to {source.Package}];
}

func CallName(target text) text {
    return [the unqualified identifier in raw call target {target}];
}

func IsBuiltinType(name text) bool {
    return [whether {name} is a complete core built-in type reference];
}

func IndexesAfterFirst(entries []model.Entry) []int {
    return [the integer indexes 1 through len of {entries} minus one in ascending order];
}

func LanguageVersionText(manifest model.ModuleManifest?) text? {
    return ["0.0.1" when {manifest} is present with Oi0_0_1, "0.0.2" when present with Oi0_0_2,
        otherwise none]
}

func ReportSourceCount(graph load.Graph) int {
    return [len of {graph.SourceIdentities} for a selected Oi0_0_2 manifest, otherwise len of {graph.Sources}]
}

func ManifestModule(manifest model.ModuleManifest?) text? {
    return [the exact Module field when {manifest} is present, otherwise none]
}

func Location(path fs.Path) text {
    return [the normalized module-relative {path} location at line 1 column 1];
}

func RootLocation(graph load.Graph) text {
    if len(graph.RootPaths) == 0 {
        return "main.oi:1:1"
    }
    return Location(graph.RootPaths[0])
}
