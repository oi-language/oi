package load

import "std/diagnostic"
import "std/fs"
import "oi/skills/compile-oi/internal/diagnose"
import "oi/skills/compile-oi/internal/model"
import "oi/skills/compile-oi/internal/parse"

type ModuleProbe struct {
    Manifest model.ModuleManifest?; Diagnostics []diagnostic.Diagnostic
}

type LogicalReadProbe struct {
    Source model.LogicalSource?; Diagnostics []diagnostic.Diagnostic
}

type TargetRead struct {
    Directory fs.Path; Paths []fs.Path; Sources []model.SourceFile
    Diagnostics []diagnostic.Diagnostic
}

type ImportTarget struct {
    Directory fs.Path; Package text; Standard bool; Outside bool
}

type LineBudget struct {
    Found bool; Path fs.Path; Line int; Characters int
}

type Graph struct {
    Manifest model.ModuleManifest?; RootPaths []fs.Path; Sources []model.SourceFile
    SourceIdentities []model.SourceIdentity; SourceCharacters int
    ParseDiagnostics []diagnostic.Diagnostic; ModuleDiagnostics []diagnostic.Diagnostic
    PackageDiagnostics []diagnostic.Diagnostic; VisitedPackages []fs.Path; ManifestClosure []text
}

effect ReadVerifiedSource(root fs.Path, path fs.Path) LogicalReadProbe {
    uses workspace.read
    contract [read {path} beneath {root} once, zero through true EOF; strict-decode UTF-8 and close
        counts plus lowercase SHA-256; return stable LogicalSource, SOURCE_TRUNCATED for
        invalid/incomplete coverage, or SOURCE_CHANGED_DURING_LOAD for drift at {path}:1:1]
}

func LoadGraph(target fs.Path) Graph {
    var targetState fs.Observation = fs.Scan(target)
    var probe ModuleProbe = FindNearestObservedModule(target, targetState)
    if probe.Manifest == none {
        return EmptyGraph(probe.Diagnostics)
    }
    var manifest model.ModuleManifest = PresentManifest(probe.Manifest)
    if manifest.Version == model.LanguageVersion.Oi0_0_1 {
        return LoadLegacyGraph(target, targetState, manifest)
    }
    return LoadManifestGraph(manifest)
}

func FindNearestObservedModule(target fs.Path, state fs.Observation) ModuleProbe {
    var directory fs.Path = parse.TargetDirectory(target, state)
    for candidate in parse.AncestorDirectories(directory) {
        var path fs.Path = parse.Join(candidate, "oi.mod")
        var observation fs.Observation = fs.Scan(path)
        if observation.Kind == fs.Kind.File {
            var parsed parse.ManifestParse = parse.Manifest(fs.Read(path))
            if len(parsed.Diagnostics) != 0 || parsed.Version == none {
                return ModuleProbe{Manifest: none, Diagnostics: parsed.Diagnostics}
            }
            return ModuleProbe{
                Manifest: model.ModuleManifest{
                    Root: candidate, Path: path, Module: parsed.Module,
                    Version: PresentVersion(parsed.Version), Sources: parsed.Sources,
                },
                Diagnostics: []diagnostic.Diagnostic{},
            }
        }
    }
    return ModuleProbe{
        Manifest: none,
        Diagnostics: []diagnostic.Diagnostic{
            diagnostic.New("MISSING_MODULE_FILE", "module", parse.Location(directory), "nearest oi.mod"),
        },
    }
}

func LoadManifestGraph(manifest model.ModuleManifest) Graph {
    var graph Graph = EmptyGraph([]diagnostic.Diagnostic{})
    graph.Manifest = manifest
    graph.VisitedPackages = []fs.Path{manifest.Root}
    var logical []model.LogicalSource = []model.LogicalSource{}
    for directive in manifest.Sources {
        var read LogicalReadProbe = ReadVerifiedSource(manifest.Root, directive.Path)
        graph.ModuleDiagnostics = diagnose.Append(graph.ModuleDiagnostics, read.Diagnostics)
        if read.Source != none {
            var source model.LogicalSource = PresentLogicalSource(read.Source)
            logical = append(logical, source)
            graph.SourceIdentities = append(graph.SourceIdentities, source.Identity)
            graph.SourceCharacters = graph.SourceCharacters + source.Identity.Characters
        }
    }
    if len(graph.ModuleDiagnostics) != 0 {
        return graph
    }
    graph.ModuleDiagnostics = SourceBudgetDiagnostics(logical)
    if len(graph.ModuleDiagnostics) != 0 {
        return graph
    }
    for source in logical {
        var path fs.Path = parse.JoinPath(manifest.Root, source.Identity.Path)
        graph.Sources = append(graph.Sources, parse.Source(path, source.Content, manifest.Version))
        if source.Identity.Path == "main.oi" {
            graph.RootPaths = append(graph.RootPaths, path)
        }
    }
    graph.ParseDiagnostics = diagnose.Local(graph.Sources, "parse")
    if len(graph.ParseDiagnostics) != 0 {
        return graph
    }
    graph.PackageDiagnostics = ValidateManifestPackages(manifest, graph.Sources)
    if len(graph.PackageDiagnostics) == 0 {
        graph.PackageDiagnostics = ValidateManifestImports(manifest, graph.Sources)
    }
    graph.ManifestClosure = ManifestClosure(graph.Sources)
    return graph
}

func SourceBudgetDiagnostics(sources []model.LogicalSource) []diagnostic.Diagnostic {
    var total int = 0
    for source in sources {
        total = total + source.Identity.Characters
        if source.Identity.Characters > 16000 {
            return []diagnostic.Diagnostic{
                diagnostic.New(
                    "SOURCE_FILE_BUDGET", "module", parse.Location(source.Identity.Path),
                    FileBudgetDetail(source.Identity.Characters)),
            }
        }
    }
    if total > 128000 {
        return []diagnostic.Diagnostic{
            diagnostic.New(
                "SOURCE_GRAPH_BUDGET", "module", "oi.mod:1:1", GraphBudgetDetail(total)),
        }
    }
    var line LineBudget = FirstOverlongLine(sources)
    if line.Found {
        return []diagnostic.Diagnostic{
            diagnostic.New(
                "SOURCE_LINE_BUDGET", "module", LineLocation(line.Path, line.Line),
                LineBudgetDetail(line.Characters)),
        }
    }
    return []diagnostic.Diagnostic{}
}

func FirstOverlongLine(sources []model.LogicalSource) LineBudget {
    return derive [in {sources} identity order, find the first physical line above 240 decoded
        characters and return its Path, one-based line, exact character count, and Found true; return
        Found false with empty Path and zero numbers when absent]
}

func FileBudgetDetail(actual int) text {
    return [exact text source characters A exceeds maximum 16000 with A replaced only by canonical
        decimal {actual}]
}

func GraphBudgetDetail(actual int) text {
    return [exact text source graph characters A exceeds maximum 128000 with A replaced only by
        canonical decimal {actual}]
}

func LineBudgetDetail(actual int) text {
    return [exact text source line characters A exceeds maximum 240 with A replaced only by canonical
        decimal {actual}]
}

func LineLocation(path fs.Path, line int) text {
    return [the exact normalized module-relative location for {path}, one-based line {line}, column 241]
}

func LoadLegacyGraph(target fs.Path, targetState fs.Observation, manifest model.ModuleManifest) Graph {
    var root TargetRead = ReadLegacyTarget(target, targetState, manifest.Version)
    var selectedManifest model.ModuleManifest? = manifest
    if len(root.Diagnostics) != 0 {
        selectedManifest = none
    }
    var graph Graph = EmptyGraph([]diagnostic.Diagnostic{})
    graph.Manifest = selectedManifest
    graph.RootPaths = root.Paths
    graph.Sources = root.Sources
    graph.ParseDiagnostics = root.Diagnostics
    graph.VisitedPackages = []fs.Path{root.Directory}
    if len(graph.ParseDiagnostics) != 0 {
        return graph
    }
    graph.PackageDiagnostics = ValidateLegacyRootPackages(graph.RootPaths, graph.Sources)
    if len(graph.PackageDiagnostics) == 0 {
        graph = LoadLegacyImports(graph, root.Sources, []fs.Path{root.Directory})
    }
    graph.ManifestClosure = ManifestClosure(graph.Sources)
    return graph
}

func ReadLegacyTarget(target fs.Path, observation fs.Observation, version model.LanguageVersion) TargetRead {
    var directory fs.Path = parse.TargetDirectory(target, observation)
    var paths []fs.Path = []fs.Path{}
    if observation.Kind == fs.Kind.File && parse.IsOiSource(target) {
        paths = append(paths, target)
    } else {
        paths = PackageSourcePaths(fs.Scan(directory))
    }
    var sources []model.SourceFile = ReadSources(paths, version)
    return TargetRead{Directory: directory, Paths: paths, Sources: sources,
        Diagnostics: diagnose.Local(sources, "parse")}
}

func LoadLegacyImports(graph Graph, sources []model.SourceFile, active []fs.Path) Graph {
    for source in sources {
        for imported in source.Imports {
            var target ImportTarget = ResolveImport(graph.Manifest, imported)
            if target.Outside {
                graph.PackageDiagnostics = append(graph.PackageDiagnostics, diagnostic.New(
                    "IMPORT_OUTSIDE_MODULE", "module", imported.Location, imported.Path))
            } else if ContainsPath(active, target.Directory) {
                graph.PackageDiagnostics = append(graph.PackageDiagnostics, diagnostic.New(
                    "CIRCULAR_IMPORT", "module", imported.Location, imported.Path))
            } else if !ContainsPath(graph.VisitedPackages, target.Directory) {
                graph = LoadLegacyPackage(
                    graph, target, fs.Scan(target.Directory), append(active, target.Directory))
            }
        }
    }
    return graph
}

func LoadLegacyPackage(graph Graph, target ImportTarget, observation fs.Observation, active []fs.Path) Graph {
    graph.VisitedPackages = append(graph.VisitedPackages, target.Directory)
    if observation.Kind != fs.Kind.Directory {
        graph.PackageDiagnostics = append(graph.PackageDiagnostics, diagnostic.New(
            "MISSING_IMPORT", "module", parse.Location(target.Directory), target.Package))
        return graph
    }
    var boundary []diagnostic.Diagnostic = ObserveLegacyBoundary(graph.Manifest, target, observation)
    graph.PackageDiagnostics = diagnose.Append(graph.PackageDiagnostics, boundary)
    if len(boundary) != 0 {
        return graph
    }
    var sources []model.SourceFile = ReadSources(PackageSourcePaths(observation),
        model.LanguageVersion.Oi0_0_1)
    for source in sources {
        graph.Sources = append(graph.Sources, source)
    }
    var parseDiagnostics []diagnostic.Diagnostic = diagnose.Local(sources, "parse")
    graph.ParseDiagnostics = diagnose.Append(graph.ParseDiagnostics, parseDiagnostics)
    if len(parseDiagnostics) != 0 {
        return graph
    }
    var packageDiagnostics []diagnostic.Diagnostic = ValidateLegacyImportedPackage(target.Package, sources)
    graph.PackageDiagnostics = diagnose.Append(graph.PackageDiagnostics, packageDiagnostics)
    if len(packageDiagnostics) == 0 {
        graph = LoadLegacyImports(graph, sources, active)
    }
    return graph
}

func ObserveLegacyBoundary(manifest model.ModuleManifest?, target ImportTarget, observation fs.Observation) []diagnostic.Diagnostic {
    if target.Standard {
        return ValidateStandardBoundary(target, observation)
    }
    var result []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for directory in parse.BoundaryDirectories(manifest, target.Directory) {
        var path fs.Path = parse.Join(directory, "oi.mod")
        if fs.Scan(path).Kind == fs.Kind.File {
            result = diagnose.Append(result, CompareNestedModule(manifest, path, fs.Read(path)))
        }
    }
    return result
}

func ReadSources(paths []fs.Path, version model.LanguageVersion) []model.SourceFile {
    var result []model.SourceFile = []model.SourceFile{}
    for path in paths {
        if fs.Scan(path).Kind == fs.Kind.File {
            result = append(result, parse.Source(path, fs.Read(path), version))
        }
    }
    return result
}

func PackageSourcePaths(observation fs.Observation) []fs.Path {
    var result []fs.Path = []fs.Path{}
    for path in parse.OrderedPaths(observation.Entries) {
        if fs.Scan(path).Kind == fs.Kind.File && parse.IsOiSource(path) {
            result = append(result, path)
        }
    }
    return result
}

func EmptyGraph(diagnostics []diagnostic.Diagnostic) Graph {
    return Graph{
        Manifest: none, RootPaths: []fs.Path{}, Sources: []model.SourceFile{},
        SourceIdentities: []model.SourceIdentity{}, SourceCharacters: 0,
        ParseDiagnostics: []diagnostic.Diagnostic{}, ModuleDiagnostics: diagnostics,
        PackageDiagnostics: []diagnostic.Diagnostic{}, VisitedPackages: []fs.Path{},
        ManifestClosure: []text{},
    }
}

func ValidateManifestPackages(
    manifest model.ModuleManifest,
    sources []model.SourceFile,
) []diagnostic.Diagnostic {
    return derive [from {manifest} and {sources}, emit first SOURCE_PACKAGE_DUPLICATE at a repeated
        directory; only when unique, emit SOURCE_PACKAGE_MISMATCH for invalid main.oi or non-root
        package basename, at exact loaded-rule locations]
}

func ValidateManifestImports(
    manifest model.ModuleManifest,
    sources []model.SourceFile,
) []diagnostic.Diagnostic {
    return derive [from imports in {sources} under {manifest}, emit the first exact module diagnostic,
        including SOURCE_IMPORT_UNDECLARED for unresolved or non-unique manifested packages; preserve
        circular, outside, version, standard, and export rules; unlisted files are absent]
}

func ValidateLegacyRootPackages(rootPaths []fs.Path, sources []model.SourceFile) []diagnostic.Diagnostic {
    var result []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        if ContainsPath(rootPaths, source.Path) && source.Package != "main" {
            result = append(result, diagnostic.New("PACKAGE_MISMATCH", "module",
                parse.Location(source.Path), source.Package))
        }
    }
    return result
}

func ValidateLegacyImportedPackage(expected text, sources []model.SourceFile) []diagnostic.Diagnostic {
    var result []diagnostic.Diagnostic = []diagnostic.Diagnostic{}
    for source in sources {
        if source.Package != expected {
            result = append(result, diagnostic.New("PACKAGE_MISMATCH", "module",
                parse.Location(source.Path), source.Package))
        }
    }
    return result
}

func ManifestClosure(sources []model.SourceFile) []text {
    return derive [the first-encounter distinct RequiredShards paths from {sources}]
}

func PresentVersion(value model.LanguageVersion?) model.LanguageVersion {
    return [the present LanguageVersion in {value}; caller established presence]
}

func PresentManifest(value model.ModuleManifest?) model.ModuleManifest {
    return derive [extract present ModuleManifest from {value}]
}

func PresentLogicalSource(value model.LogicalSource?) model.LogicalSource {
    return derive [extract present LogicalSource from {value}]
}

func ResolveImport(
    manifest model.ModuleManifest?,
    imported model.Import,
) ImportTarget {
    return derive [the unique normalized package directory, package name, standard flag, and
        outside-module flag for {imported} under {manifest}, without claiming filesystem kind]
}

func CompareNestedModule(
    manifest model.ModuleManifest?,
    path fs.Path,
    content text,
) []diagnostic.Diagnostic {
    return derive [the exact VERSION_CONFLICT diagnostics established by nested oi.mod {content} at
        {path} against selected {manifest}, including malformed or non-0.0.1 version evidence]
}

func ValidateStandardBoundary(
    target ImportTarget,
    observation fs.Observation,
) []diagnostic.Diagnostic {
    return derive [the exact VERSION_CONFLICT diagnostics when standard package {target} and
        {observation} are outside the selected Oi 0.0.1 standard-library root]
}

func ContainsPath(values []fs.Path, expected fs.Path) bool {
    for value in values {
        if value == expected {
            return true
        }
    }
    return false
}
