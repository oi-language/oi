package model

import "std/diagnostic"
import "std/fs"

type LanguageVersion enum {
    Oi0_0_1
    Oi0_0_2
}

type TriviaKind enum {
    Blank
    Comment
}

type TriviaLine struct {
    Kind TriviaKind
    Lexeme text
}

type DirectiveTrivia struct {
    Leading []TriviaLine
}

type SourceDirective struct {
    Path fs.Path
    Trivia DirectiveTrivia
}

type Manifest struct {
    Path fs.Path
    Module text
    Version LanguageVersion
    ModuleTrivia DirectiveTrivia
    VersionTrivia DirectiveTrivia
    Sources []SourceDirective
    Trailing []TriviaLine
}

type ManifestAdmission struct {
    Valid bool
    Value Manifest?
    Diagnostics []diagnostic.Diagnostic
}

type ManifestRepair struct {
    Valid bool
    Value Manifest?
    Diagnostics []diagnostic.Diagnostic
}

type TokenKind enum {
    Identifier
    Keyword
    IntegerLiteral
    TextLiteral
    SemanticLiteral
    Comment
    UnaryOperator
    BinaryOperator
    DefinitionOperator
    AssignmentOperator
    ShortDeclarationOperator
    FieldColon
    CaseColon
    Dot
    Comma
    Semicolon
    OpenParen
    CloseParen
    OpenTypeBracket
    CloseTypeBracket
    OpenIndexBracket
    CloseIndexBracket
    OpenStructuralBrace
    CloseStructuralBrace
    OpenCompositeBrace
    CloseCompositeBrace
    OptionalMark
    Whitespace
    LineBreak
    Invalid
}

type Separation enum {
    Tight
    Space
}

type Token struct {
    Kind TokenKind
    Lexeme text
    Location text
}

type Range struct {
    Start int
    End int
}

type Source struct {
    Path fs.Path
    Version LanguageVersion
    Tokens []Token
    SemanticRanges []Range
}

func WordLike(kind TokenKind) bool {
    return kind == TokenKind.Identifier || kind == TokenKind.Keyword || kind == TokenKind.IntegerLiteral || kind == TokenKind.TextLiteral || kind == TokenKind.SemanticLiteral
}

func SpacedOperator(kind TokenKind) bool {
    return kind == TokenKind.BinaryOperator || kind == TokenKind.DefinitionOperator || kind == TokenKind.AssignmentOperator || kind == TokenKind.ShortDeclarationOperator
}

func Adjacency(left TokenKind, right TokenKind) Separation {
    if left == TokenKind.OpenParen || left == TokenKind.OpenTypeBracket || left == TokenKind.OpenIndexBracket || left == TokenKind.Dot || left == TokenKind.UnaryOperator {
        return Separation.Tight
    }
    if right == TokenKind.CloseParen || right == TokenKind.CloseTypeBracket || right == TokenKind.CloseIndexBracket ||
        right == TokenKind.CloseCompositeBrace || right == TokenKind.Dot || right == TokenKind.Comma ||
        right == TokenKind.Semicolon || right == TokenKind.OptionalMark {
        return Separation.Tight
    }
    if left == TokenKind.CloseTypeBracket && WordLike(right) {
        return Separation.Tight
    }
    if right == TokenKind.OpenParen {
        if left == TokenKind.Keyword {
            return Separation.Space
        }
        return Separation.Tight
    }
    if right == TokenKind.OpenTypeBracket || right == TokenKind.OpenIndexBracket || right == TokenKind.OpenCompositeBrace {
        return Separation.Tight
    }
    if left == TokenKind.Comma || left == TokenKind.FieldColon || left == TokenKind.CaseColon || SpacedOperator(left) || SpacedOperator(right) {
        return Separation.Space
    }
    if WordLike(left) && (WordLike(right) || right == TokenKind.UnaryOperator) {
        return Separation.Space
    }
    if (left == TokenKind.CloseParen || left == TokenKind.CloseIndexBracket || left == TokenKind.CloseCompositeBrace) && WordLike(right) {
        return Separation.Space
    }
    return Separation.Tight
}

func ParseManifestForSource(path fs.Path, content text) ManifestAdmission {
    return derive [strictly admit exact UTF-8 oi.mod {content} at {path} under its selected exact snapshot;
        accept exactly one module directive and exact oi 0.0.1 with no source directive, or exact oi 0.0.2 with one or more unique normalized
        module-relative source paths in strict unsigned UTF-8 path-byte order; reject malformed, duplicate, missing, invalid-path, unsupported, or
        unordered directives or trailing text on a physical directive line with exact selected-snapshot module diagnostics; trailing text emits
        exactly Category MALFORMED_MODULE_MANIFEST, Phase module, Location oi.mod:1:1, Detail equal to the first malformed physical directive line's
        exact UTF-8 text excluding its line ending, and empty Trace; otherwise the first unordered source emits exactly Category
        SOURCE_MANIFEST_ORDER, Phase module, Location oi.mod:1:1, Detail equal to that source path, and empty Trace; on success return the same typed
        Manifest and trivia attachment as ParseManifestForRepair; on failure return Valid false, Value none, and ordered Diagnostics]
}

func ParseManifestForRepair(path fs.Path, content text) ManifestRepair {
    return derive [parse exact UTF-8 oi.mod {content} at {path} for explicit manifest repair; accept exactly one module directive and exact oi 0.0.1
        with no source directive, or exact oi 0.0.2 with one or more unique normalized module-relative source paths whose order may be noncanonical;
        reject every other malformed, duplicate, missing, invalid-path, unsupported directive, or trailing text on a directive line with exact
        selected-snapshot module diagnostics; trailing text uses MALFORMED_MODULE_MANIFEST, module, oi.mod:1:1, the first malformed physical directive
        line's exact UTF-8 text excluding its line ending, and empty Trace;
        assign trivia without textual protocols: each exact line-comment Lexeme excludes its physical ending, each physical blank line is one
        TriviaLine Blank with empty Lexeme, and each comment-only line is one TriviaLine Comment with exact Lexeme; the ordered trivia lines since
        the previous directive attach as Leading to the next directive, while trivia after the final directive becomes Trailing; ModuleTrivia and
        VersionTrivia stay with those directives, and every source directive carries its
        own Path and DirectiveTrivia; on success return Valid true and that exact Manifest; on failure return Valid false, Value none, and ordered
        Diagnostics without guessing a version]
}

func PresentManifest(value Manifest?) Manifest {
    return derive [the exact present Manifest in {value}]
}

func ManifestCandidates(target fs.Path) []fs.Path {
    return derive [the duplicate-free nearest-to-farthest lexical sequence of normalized oi.mod paths beginning in the parent directory of {target}
        and ending at its filesystem root; if {target} itself has final segment oi.mod, return only {target}]
}

func IsManifestTarget(target fs.Path) bool {
    return derive [true exactly when the final normalized path segment of {target} is oi.mod]
}

func TargetDirectory(target fs.Path) fs.Path {
    return derive [the normalized parent directory of {target}]
}

func Location(path fs.Path) text {
    return derive [the normalized module-relative {path} location at line 1 column 1]
}

func Parse(path fs.Path, content text, version LanguageVersion) Source {
    return derive [the unique Source from one lexical and grammar parse of exact UTF-8 {content} at {path} under exactly {version};
        Keyword for Oi0_0_1 is exactly package, import, const, type, struct, enum, func, effect, uses, contract, var, if, else, switch, case, default,
        for, in, select, return, break, continue, stop, handoff, oi, await, detach, text, bool, int, unit, task, outcome, channel, sender,
        receiver, failure, true, false, or none; Oi0_0_2 adds derive, map, and set; every other valid name maps to Identifier;
        decimal integers, exact text literals, complete semantic expressions, and line comments map to their matching literal or Comment kind;
        context classifies ! and - as unary; * / % + - == != < <= > >= ~= && || as binary; equals as definition or assignment;
        colon-equals as short declaration; colon as field or case; and classifies
        exact-version type and index brackets, structural and composite braces, including Oi0_0_2 map/set types and literals; remaining punctuation
        maps to Dot, Comma, Semicolon, parens, or OptionalMark; Oi0_0_2 collection builtins remain Identifier call targets, keyed/indexed for bindings
        use Comma, and derive followed by one SemanticLiteral is the exact DeriveExpression token pair;
        maximal ASCII space-tab runs map to Whitespace, each CRLF, CR, or LF maps to one LineBreak, and any otherwise unmapped byte maps to Invalid;
        preserve every exact Lexeme byte; one text literal, semantic expression, or comment excluding its physical line ending is one opaque token;
        Location is path followed by at-sign, zero-based UTF-8 byte offset, one-based line, and one-based UTF-8 byte column separated by colons;
        CRLF is one line ending and lone CR or LF is one line ending; Version is exactly {version}; SemanticRanges are zero-based half-open UTF-8
        byte ranges in source order]
}

func Validate(source Source, available []text) []diagnostic.Diagnostic {
    return derive [all deterministic typed diagnostics decidable from {source} under its exact Version core, in Location order;
        validate the closed token mapping, lexical and grammar structure, terminators, declarations, signatures, statements, semantic boundaries,
        lowercase resultless main shape when present, and declared effect authorities against {available}; use the offending token Location,
        a concrete core category, phase, and detail, and empty Trace; do not resolve imports, execute source, inspect another file, or encode records as text]
}

func Equivalent(before Source, after Source) bool {
    return derive [true exactly when {before} and {after} have the same Path, Version, and grammar-derived typed token sequence after removing Whitespace and LineBreak,
        equating Semicolon with the corresponding inserted terminator and ignoring an optional trailing Comma only in a multiline import, parameter,
        argument, or composite-element list; compare every other TokenKind and Lexeme plus comment attachment and order, but not formatting-derived Location
        or SemanticRanges offsets; require every TextLiteral and SemanticLiteral Lexeme to remain byte-identical]
}

func EquivalentManifest(before Manifest, after Manifest) bool {
    return derive [true exactly when {before} and {after} have the same Path, Module, Version, exact ModuleTrivia, exact VersionTrivia, exact Trailing,
        and the same duplicate-free source path set with exact DirectiveTrivia paired to each path; ignore directive whitespace and source directive
        order, but no directive value, comment byte, blank-line ownership, attachment, or package boundary]
}
