type TaskStateExpectation enum {
    Pending
    Running
    Done
    Failed
    Cancelled
}

type ControlledEffectTerminal enum {
    Completed
    Cancelled
}

type ControlledEffectExpectation struct {
    EffectName text
    TaskID text
    Authority text
    Location text
    Input text
    StartSequence int
    TerminalSequence int
    Terminal ControlledEffectTerminal
    Result text
    HarnessAction text
    InvocationCount int
}

type LifecycleEventKind enum {
    DetachLaunch
    RegistryTransfer
    ParentComplete
    ChildComplete
    Notification
    Status
    CancelRequest
    Cancellation
    AttachedJoin
    HandoffStart
    OriginalTerminal
    TargetStart
    TargetComplete
}

type LifecycleEventExpectation struct {
    Sequence int
    Kind LifecycleEventKind
    TaskID text
    ActivationID text
    Location text
    State TaskStateExpectation?
    Detail text
}

type RegistryExpectation struct {
    TaskID text
    FromOwner text
    ToOwner text
    TransferSequence int
    TerminalState TaskStateExpectation
    NotificationSequence int
    NotificationCount int
    ParentCompletedBeforeNotification bool
    FailureChangesCompletedParent bool
}

type TaskInspectionExpectation struct {
    Sequence int
    ReturnSequence int
    Operation text
    TaskID text
    ObservedState TaskStateExpectation
    ResultState TaskStateExpectation
    WaitsForTerminal bool
    CancellationRecordCount int
}

type HandoffExpectation struct {
    TaskID text
    OriginalActivationID text
    TargetActivationID text
    Target text
    Location text
    AttachedJoinedTaskIDs []text
    DetachedRegistryTaskIDs []text
    Arguments []ArgumentExpectation
    Authorities []text
    EffectMappings []EffectMappingExpectation
    ContextExcludes []text
    OriginalResumed bool
    ReturnsResult bool
}

type LifecycleRuntimeExpectation struct {
    Runtime RuntimeExpectation
    Events []LifecycleEventExpectation
    ControlledEffects []ControlledEffectExpectation
    Registry []RegistryExpectation
    Inspections []TaskInspectionExpectation
    Handoff HandoffExpectation?
    DurableArguments []ArgumentExpectation
    Observations []text
    RunCount int
    JournalReadCount int
}

func LifecycleEvent(
    sequence int,
    kind LifecycleEventKind,
    taskID text,
    activationID text,
    location text,
    state TaskStateExpectation?,
    detail text,
) LifecycleEventExpectation {
    return LifecycleEventExpectation{
        Sequence: sequence,
        Kind: kind,
        TaskID: taskID,
        ActivationID: activationID,
        Location: location,
        State: state,
        Detail: detail,
    }
}

func DetachNotificationRuntime() LifecycleRuntimeExpectation {
    var holdSuccessStart ScheduleEvent = Event(
        4,
        EventKind.Effect,
        "root/0",
        "main.oi:4:13",
        "Hold Started(success value-7)",
    )
    var holdFailureStart ScheduleEvent = Event(
        8,
        EventKind.Effect,
        "root/1",
        "main.oi:4:13",
        "Hold Started(failure value-7)",
    )
    var reply ScheduleEvent = Event(9, EventKind.Reply, "root", "main.oi:24:5", "parent-complete")
    var holdSuccessComplete ScheduleEvent = Event(
        11,
        EventKind.Effect,
        "root/0",
        "main.oi:4:13",
        "Hold Completed(released-success)",
    )
    var holdFailureComplete ScheduleEvent = Event(
        15,
        EventKind.Effect,
        "root/1",
        "main.oi:4:13",
        "Hold Completed(released-failure)",
    )
    var detachedFailure FailureExpectation = FailureExpectation{
        TaskID: "root/1",
        Category: "DETACHED_FAILURE",
        Phase: "runtime",
        Location: "main.oi:6:9",
        Detail: "released-failure",
        Trace: []text{},
        SourceIndex: 1,
    }
    return LifecycleRuntimeExpectation{
        Runtime: RuntimeExpectation{
            HarnessInputs: []ArgumentExpectation{Arg("value", "text", "value-7")},
            ParentEffectMappings: []EffectMappingExpectation{
                Mapping("Hold", "local.hold"),
                Mapping("Reply", "caller.reply"),
            },
            Launches: []LaunchExpectation{
                Launch(
                    "root/0",
                    "root",
                    0,
                    "main.Background",
                    []ArgumentExpectation{
                        Arg("value", "text", "success value-7"),
                        Arg("fail", "bool", "false"),
                    },
                    []text{"local.hold"},
                    []EffectMappingExpectation{Mapping("Hold", "local.hold")},
                ),
                Launch(
                    "root/1",
                    "root",
                    1,
                    "main.Background",
                    []ArgumentExpectation{
                        Arg("value", "text", "failure value-7"),
                        Arg("fail", "bool", "true"),
                    },
                    []text{"local.hold"},
                    []EffectMappingExpectation{Mapping("Hold", "local.hold")},
                ),
            },
            Schedule: []ScheduleEvent{
                Event(3, EventKind.Admit, "root/0", "main.oi:22:5", ""),
                holdSuccessStart,
                Event(7, EventKind.Admit, "root/1", "main.oi:23:5", ""),
                holdFailureStart,
                reply,
                holdSuccessComplete,
                Event(12, EventKind.Semantic, "root/0", "main.oi:8:12", "detached released-success"),
                Event(13, EventKind.Complete, "root/0", "main.oi:8:12", "detached released-success"),
                holdFailureComplete,
                Event(16, EventKind.Complete, "root/1", "main.oi:6:9", "DETACHED_FAILURE"),
            },
            ReplyTrace: []ScheduleEvent{reply},
            EffectTrace: []ScheduleEvent{
                holdSuccessStart,
                holdFailureStart,
                holdSuccessComplete,
                holdFailureComplete,
            },
            ContextExcludes: []text{},
            TraceExcludes: []text{},
            JournalExcludes: []text{},
            Completions: []CompletionExpectation{
                Completion("root/0", "success", "detached released-success", "none", "main.oi:8:12", 0),
                Completion("root/1", "failure", "", "DETACHED_FAILURE", "main.oi:6:9", 1),
            },
            Failures: []FailureExpectation{detachedFailure},
            SelectedFailure: none,
            CancelledTaskIDs: []text{},
            Policy: none,
            JournalReadCount: 1,
        },
        Events: []LifecycleEventExpectation{
            LifecycleEvent(1, LifecycleEventKind.DetachLaunch, "root/0", "root/0/a0", "main.oi:22:5", TaskStateExpectation.Pending, "launch committed"),
            LifecycleEvent(2, LifecycleEventKind.RegistryTransfer, "root/0", "root/0/a0", "main.oi:22:5", TaskStateExpectation.Pending, "root -> host/task-registry"),
            LifecycleEvent(5, LifecycleEventKind.DetachLaunch, "root/1", "root/1/a0", "main.oi:23:5", TaskStateExpectation.Pending, "launch committed"),
            LifecycleEvent(6, LifecycleEventKind.RegistryTransfer, "root/1", "root/1/a0", "main.oi:23:5", TaskStateExpectation.Pending, "root -> host/task-registry"),
            LifecycleEvent(10, LifecycleEventKind.ParentComplete, "root", "root/a0", "main.oi:25:1", TaskStateExpectation.Done, "parent-complete"),
            LifecycleEvent(13, LifecycleEventKind.ChildComplete, "root/0", "root/0/a0", "main.oi:8:12", TaskStateExpectation.Done, "detached released-success"),
            LifecycleEvent(14, LifecycleEventKind.Notification, "root/0", "root/0/a0", "main.oi:8:12", TaskStateExpectation.Done, "detached released-success"),
            LifecycleEvent(16, LifecycleEventKind.ChildComplete, "root/1", "root/1/a0", "main.oi:6:9", TaskStateExpectation.Failed, "DETACHED_FAILURE:released-failure"),
            LifecycleEvent(17, LifecycleEventKind.Notification, "root/1", "root/1/a0", "main.oi:6:9", TaskStateExpectation.Failed, "DETACHED_FAILURE:released-failure"),
        },
        ControlledEffects: []ControlledEffectExpectation{
            ControlledEffectExpectation{
                EffectName: "Hold",
                TaskID: "root/0",
                Authority: "local.hold",
                Location: "main.oi:4:13",
                Input: "success value-7",
                StartSequence: 4,
                TerminalSequence: 11,
                Terminal: ControlledEffectTerminal.Completed,
                Result: "released-success",
                HarnessAction: "complete after parent terminal",
                InvocationCount: 1,
            },
            ControlledEffectExpectation{
                EffectName: "Hold",
                TaskID: "root/1",
                Authority: "local.hold",
                Location: "main.oi:4:13",
                Input: "failure value-7",
                StartSequence: 8,
                TerminalSequence: 15,
                Terminal: ControlledEffectTerminal.Completed,
                Result: "released-failure",
                HarnessAction: "complete after parent terminal",
                InvocationCount: 1,
            },
        },
        Registry: []RegistryExpectation{
            RegistryExpectation{
                TaskID: "root/0",
                FromOwner: "root",
                ToOwner: "host/task-registry",
                TransferSequence: 2,
                TerminalState: TaskStateExpectation.Done,
                NotificationSequence: 14,
                NotificationCount: 1,
                ParentCompletedBeforeNotification: true,
                FailureChangesCompletedParent: false,
            },
            RegistryExpectation{
                TaskID: "root/1",
                FromOwner: "root",
                ToOwner: "host/task-registry",
                TransferSequence: 6,
                TerminalState: TaskStateExpectation.Failed,
                NotificationSequence: 17,
