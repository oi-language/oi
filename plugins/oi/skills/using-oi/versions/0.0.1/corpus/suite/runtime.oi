            CancelledTaskIDs: []text{},
            Policy: none,
            JournalReadCount: 1,
        },
        Events: []LifecycleEventExpectation{
            LifecycleEvent(4, LifecycleEventKind.AttachedJoin, "root/0", "root/0/a0", "main.oi:18:5", TaskStateExpectation.Done, "joined before handoff"),
            LifecycleEvent(5, LifecycleEventKind.HandoffStart, "root", "root/a0", "main.oi:18:5", TaskStateExpectation.Running, "main.Continue"),
            LifecycleEvent(6, LifecycleEventKind.OriginalTerminal, "root", "root/a0", "main.oi:18:5", TaskStateExpectation.Done, "never resumes"),
            LifecycleEvent(7, LifecycleEventKind.TargetStart, "root", "root/a1", "main.oi:12:1", TaskStateExpectation.Running, "main.Continue"),
            LifecycleEvent(9, LifecycleEventKind.TargetComplete, "root", "root/a1", "main.oi:14:1", TaskStateExpectation.Done, "unit"),
        },
        ControlledEffects: []ControlledEffectExpectation{},
        Registry: []RegistryExpectation{},
        Inspections: []TaskInspectionExpectation{},
        Handoff: HandoffExpectation{
            TaskID: "root",
            OriginalActivationID: "root/a0",
            TargetActivationID: "root/a1",
            Target: "main.Continue",
            Location: "main.oi:18:5",
            AttachedJoinedTaskIDs: []text{"root/0"},
            DetachedRegistryTaskIDs: []text{},
            Arguments: []ArgumentExpectation{Arg("value", "text", "value-7")},
            Authorities: []text{"caller.reply"},
            EffectMappings: []EffectMappingExpectation{Mapping("Reply", "caller.reply")},
            ContextExcludes: []text{"conversation", "locals", "tool-output", "memory", "parent-journal"},
            OriginalResumed: false,
            ReturnsResult: false,
        },
        DurableArguments: []ArgumentExpectation{Arg("value", "text", "value-7")},
        Observations: []text{"joined root/0", "continued after value-7", "root/a0 never resumed"},
        RunCount: 1,
        JournalReadCount: 1,
    }
}

func TaskStatusCancelRuntime() LifecycleRuntimeExpectation {
    var holdStart ScheduleEvent = Event(
        2,
        EventKind.Effect,
        "root/0",
        "main.oi:6:13",
        "Hold Started(cancel-7)",
    )
    var holdCancelled ScheduleEvent = Event(
        5,
        EventKind.Effect,
        "root/0",
        "main.oi:6:13",
        "Hold Cancelled",
    )
    var cancellation FailureExpectation = FailureExpectation{
        TaskID: "root/0",
        Category: "TASK_CANCELLED",
        Phase: "runtime",
        Location: "main.oi:21:15",
        Detail: "cancelled by root",
        Trace: []text{"cancel@main.oi:23:5"},
        SourceIndex: 0,
    }
    var reply ScheduleEvent = Event(8, EventKind.Reply, "root", "main.oi:25:5", "[Running,Cancelled]")
    return LifecycleRuntimeExpectation{
        Runtime: RuntimeExpectation{
            HarnessInputs: []ArgumentExpectation{},
            ParentEffectMappings: []EffectMappingExpectation{
                Mapping("Hold", "local.hold"),
                Mapping("Reply", "caller.reply"),
            },
            Launches: []LaunchExpectation{
                Launch(
                    "root/0",
                    "root",
                    0,
                    "main.Slow",
                    []ArgumentExpectation{Arg("value", "text", "cancel-7")},
                    []text{"local.hold"},
                    []EffectMappingExpectation{Mapping("Hold", "local.hold")},
                ),
            },
            Schedule: []ScheduleEvent{
                Event(1, EventKind.Admit, "root/0", "main.oi:21:15", ""),
                holdStart,
                holdCancelled,
                Event(6, EventKind.Cancel, "root/0", "main.oi:21:15", "TASK_CANCELLED"),
                reply,
            },
            ReplyTrace: []ScheduleEvent{reply},
            EffectTrace: []ScheduleEvent{holdStart, holdCancelled},
            ContextExcludes: []text{},
            TraceExcludes: []text{},
            JournalExcludes: []text{},
            Completions: []CompletionExpectation{
                Completion("root/0", "cancelled", "", "TASK_CANCELLED", "main.oi:21:15", 0),
            },
            Failures: []FailureExpectation{cancellation},
            SelectedFailure: none,
            CancelledTaskIDs: []text{"root/0"},
            Policy: none,
            JournalReadCount: 1,
        },
        Events: []LifecycleEventExpectation{
            LifecycleEvent(3, LifecycleEventKind.Status, "root/0", "root/0/a0", "main.oi:22:15", TaskStateExpectation.Running, "Hold Started; main.Slow suspended"),
            LifecycleEvent(4, LifecycleEventKind.CancelRequest, "root/0", "root/0/a0", "main.oi:23:5", TaskStateExpectation.Running, "root requests recursive cancellation"),
            LifecycleEvent(6, LifecycleEventKind.Cancellation, "root/0", "root/0/a0", "main.oi:21:15", TaskStateExpectation.Cancelled, "TASK_CANCELLED after Hold Cancelled"),
            LifecycleEvent(7, LifecycleEventKind.Status, "root/0", "root/0/a0", "main.oi:24:14", TaskStateExpectation.Cancelled, "main.Slow attached"),
        },
        ControlledEffects: []ControlledEffectExpectation{
            ControlledEffectExpectation{
                EffectName: "Hold",
                TaskID: "root/0",
                Authority: "local.hold",
                Location: "main.oi:6:13",
                Input: "cancel-7",
                StartSequence: 2,
                TerminalSequence: 5,
                Terminal: ControlledEffectTerminal.Cancelled,
                Result: "",
                HarnessAction: "acknowledge cancellation",
                InvocationCount: 1,
            },
        },
        Registry: []RegistryExpectation{},
        Inspections: []TaskInspectionExpectation{
            TaskInspectionExpectation{
                Sequence: 3,
                ReturnSequence: 3,
                Operation: "task.Status",
                TaskID: "root/0",
                ObservedState: TaskStateExpectation.Running,
                ResultState: TaskStateExpectation.Running,
                WaitsForTerminal: false,
                CancellationRecordCount: 0,
            },
            TaskInspectionExpectation{
                Sequence: 4,
                ReturnSequence: 6,
                Operation: "task.Cancel",
                TaskID: "root/0",
                ObservedState: TaskStateExpectation.Running,
                ResultState: TaskStateExpectation.Cancelled,
                WaitsForTerminal: true,
                CancellationRecordCount: 1,
            },
            TaskInspectionExpectation{
                Sequence: 7,
                ReturnSequence: 7,
                Operation: "task.Status",
                TaskID: "root/0",
                ObservedState: TaskStateExpectation.Cancelled,
                ResultState: TaskStateExpectation.Cancelled,
                WaitsForTerminal: false,
                CancellationRecordCount: 1,
            },
        },
        Handoff: none,
        DurableArguments: []ArgumentExpectation{},
        Observations: []text{"Running", "Cancelled", "TASK_CANCELLED count=1", "parent completes"},
        RunCount: 1,
        JournalReadCount: 1,
    }
}

type HostEffectEventKind enum {
    Attempt
    Started
    Suspend
    Complete
    Resume
    Launch
    Admit
    Queue
    CaptureFailure
    Reply
    StaticFailure
}

type HostEffectCallExpectation struct {
    EffectName text
    Authority text
    Location text
    AttemptCount int
    HostInvocationCount int
    CompletionCount int
    SuspensionCount int
    ResumeCount int
}

type HostEffectEventExpectation struct {
    Sequence int
    Kind HostEffectEventKind
    TaskID text
    Location text
    Value text
}

type HostEffectRuntimeExpectation struct {
    HarnessInputs []ArgumentExpectation
    EffectMappings []EffectMappingExpectation
    Calls []HostEffectCallExpectation
    Events []HostEffectEventExpectation
    ParentAuthorities []text
    ChildReachableDemand []text
    ChildAuthorities []text
    DirectCapture bool
    CaptureOK bool
    CapturedCategory text?
    FallbackValue text?
    Suspends bool
    ActiveSlotReleased bool
    OccupiesSubagent bool
    QuestionCount int
    AuthorityExpanded bool
    StaticCategory text?
    StaticPhase text?
    StaticLocation text?
    Observations []text
}

func HostCall(
    effectName text,
    authority text,
    location text,
    attemptCount int,
    hostInvocationCount int,
    completionCount int,
    suspensionCount int,
    resumeCount int,
) HostEffectCallExpectation {
    return HostEffectCallExpectation{
        EffectName: effectName,
        Authority: authority,
        Location: location,
        AttemptCount: attemptCount,
        HostInvocationCount: hostInvocationCount,
        CompletionCount: completionCount,
        SuspensionCount: suspensionCount,
        ResumeCount: resumeCount,
    }
}

func HostEvent(
    sequence int,
    kind HostEffectEventKind,
    taskID text,
    location text,
    value text,
) HostEffectEventExpectation {
    return HostEffectEventExpectation{
        Sequence: sequence,
        Kind: kind,
        TaskID: taskID,
        Location: location,
        Value: value,
    }
}

func CaptureFallbackHostEffects() HostEffectRuntimeExpectation {
    return HostEffectRuntimeExpectation{
        HarnessInputs: []ArgumentExpectation{
            Arg("url", "text", "https://example.invalid/value-7"),
            Arg("cached", "text", "cached-7"),
