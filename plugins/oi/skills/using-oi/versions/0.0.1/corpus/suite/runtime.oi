        Schedule: []ScheduleEvent{
            Event(1, EventKind.Admit, "root/0", "main.oi:14:21", ""),
            Event(2, EventKind.Suspend, "root", "main.oi:14:15", "root-excluded"),
            Event(3, EventKind.Semantic, "root/0", "main.oi:4:12", "child-safe"),
            Event(4, EventKind.Complete, "root/0", "main.oi:4:12", "child-safe"),
            Event(5, EventKind.Resume, "root", "main.oi:14:15", "root-excluded"),
            reply,
        },
        ReplyTrace: []ScheduleEvent{reply},
        EffectTrace: []ScheduleEvent{},
        ContextExcludes: []text{
            "PARENT-ONLY-7F3A",
            "parent-conversation",
            "parent-locals",
            "parent-tool-output",
            "implicit-memory",
            "parent-trace",
            "parent-journal",
        },
        TraceExcludes: []text{
            "PARENT-ONLY-7F3A",
            "parent-conversation",
            "parent-locals",
            "parent-tool-output",
            "implicit-memory",
            "parent-trace",
            "parent-journal",
        },
        JournalExcludes: []text{"PARENT-ONLY-7F3A"},
        Completions: []CompletionExpectation{
            Completion("root/0", "success", "child-safe", "none", "main.oi:4:12", 0),
        },
        Failures: []FailureExpectation{},
        SelectedFailure: none,
        CancelledTaskIDs: []text{},
        Policy: none,
        JournalReadCount: 1,
    }
}

func TaskPolicyRuntime() RuntimeExpectation {
    return RuntimeExpectation{
        HarnessInputs: []ArgumentExpectation{},
        ParentEffectMappings: []EffectMappingExpectation{},
        Launches: []LaunchExpectation{
            Launch(
                "root/0",
                "root",
                0,
                "main.Recurse",
                []ArgumentExpectation{Arg("level", "int", "0")},
                []text{},
                []EffectMappingExpectation{},
            ),
            Launch(
                "root/0/0",
                "root/0",
                0,
                "main.Recurse",
                []ArgumentExpectation{Arg("level", "int", "1")},
                []text{},
                []EffectMappingExpectation{},
            ),
        },
        Schedule: []ScheduleEvent{
            Event(1, EventKind.Admit, "root/0", "main.oi:9:11", "depth=1"),
            Event(2, EventKind.Suspend, "root", "main.oi:9:5", "root-excluded"),
            Event(3, EventKind.Admit, "root/0/0", "main.oi:4:14", "depth=2"),
            Event(4, EventKind.Suspend, "root/0", "main.oi:5:5", "release-slot"),
            Event(5, EventKind.Complete, "root/0/0", "main.oi:4:14", "TASK_DEPTH_LIMIT depth=3"),
            Event(6, EventKind.Queue, "root/0", "main.oi:5:5", "resume-ready"),
            Event(7, EventKind.Resume, "root/0", "main.oi:5:5", "TASK_DEPTH_LIMIT"),
            Event(8, EventKind.Complete, "root/0", "main.oi:4:14", "TASK_DEPTH_LIMIT depth=3"),
            Event(9, EventKind.Resume, "root", "main.oi:9:5", "root-excluded"),
        },
        ReplyTrace: []ScheduleEvent{},
        EffectTrace: []ScheduleEvent{},
        ContextExcludes: []text{},
        TraceExcludes: []text{},
        JournalExcludes: []text{},
        Completions: []CompletionExpectation{
            Completion("root/0/0", "failure", "", "TASK_DEPTH_LIMIT", "main.oi:4:14", 0),
            Completion("root/0", "failure", "", "TASK_DEPTH_LIMIT", "main.oi:4:14", 0),
        },
        Failures: []FailureExpectation{
            FailureExpectation{
                TaskID: "root/0/0",
                Category: "TASK_DEPTH_LIMIT",
                Phase: "runtime",
                Location: "main.oi:4:14",
                Detail: "child depth 3 exceeds maximum 2",
                Trace: []text{},
                SourceIndex: 0,
            },
            FailureExpectation{
                TaskID: "root/0",
                Category: "TASK_DEPTH_LIMIT",
                Phase: "runtime",
                Location: "main.oi:4:14",
                Detail: "child depth 3 exceeds maximum 2",
                Trace: []text{"await@main.oi:5:5"},
                SourceIndex: 0,
            },
        },
        SelectedFailure: FailureExpectation{
            TaskID: "root/0/0",
            Category: "TASK_DEPTH_LIMIT",
            Phase: "runtime",
            Location: "main.oi:4:14",
            Detail: "child depth 3 exceeds maximum 2",
            Trace: []text{"await@main.oi:5:5", "await@main.oi:9:5"},
            SourceIndex: 0,
        },
        CancelledTaskIDs: []text{},
        Policy: PolicyExpectation{
            RootDepth: 0,
            MaxDepth: 2,
            MaxConcurrency: 2,
            ExpectedActivePeak: 2,
            AdmissionOrder: "TaskID UTF-8 bytes, ParentID UTF-8 bytes, SourceIndex, launch before resume",
            RunCount: 2,
            RejectedParentID: "root/0/0",
            RejectedSourceIndex: 0,
            RejectedDepth: 3,
            Category: "TASK_DEPTH_LIMIT",
            Location: "main.oi:4:14",
        },
        JournalReadCount: 2,
    }
}

