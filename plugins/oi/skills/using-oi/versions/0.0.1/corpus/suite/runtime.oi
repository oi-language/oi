            Event(7, EventKind.Complete, "root/0/0", "main.oi:4:12", "grandchild-pressure-7"),
            Event(8, EventKind.Queue, "root/0", "main.oi:9:12", "resume-ready"),
            Event(9, EventKind.Resume, "root/0", "main.oi:9:12", "admitted"),
            Event(10, EventKind.Complete, "root/0", "main.oi:9:12", "grandchild-pressure-7"),
