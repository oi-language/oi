        JournalReadCount: 2,
    }
}

type ChannelEventKind enum {
    Create
    SenderCopy
    ReceiverMove
    Send
    Receive
    SendBlocked
    CancelWake
    End
}

type SelectChoiceKind enum {
    Send
    Receive
    Await
    Default
}

type ChannelExpectation struct {
    ChannelID text
    OwnerScope text
    PayloadShape text
    Capacity int
    SenderIDs []text
    ReceiverID text
    EndsAtOwnerScope bool
}

type ChannelEventExpectation struct {
    Sequence int
    Kind ChannelEventKind
    ChannelID text
    TaskID text
    EndpointID text
    MessageID text
    Location text
    Value text
}

type SelectExpectation struct {
    Sequence int
    SelectID text
    Location text
    ChosenCase int
    Kind SelectChoiceKind
    ReferenceID text
    ReadySequence int
    PersistedBeforeBranch bool
    RecordCount int
    ReplayReadCount int
}

type DeadlockExpectation struct {
    Category text
    Phase text
    Location text
    Detail text
    BlockedTaskIDs []text
    BlockedOperations []text
    RunnableTaskCount int
    ExternalWakeCount int
}

type ChannelRuntimeExpectation struct {
    Runtime RuntimeExpectation
    Channels []ChannelExpectation
    ChannelEvents []ChannelEventExpectation
    Selects []SelectExpectation
    Observations []text
    RunCount int
    ReplayCount int
    InterruptAfterSequence int?
    Deadlock DeadlockExpectation?
}

func ChannelSpec(
    channelID text,
    ownerScope text,
    payloadShape text,
    capacity int,
    senderIDs []text,
    receiverID text,
) ChannelExpectation {
    return ChannelExpectation{
        ChannelID: channelID,
        OwnerScope: ownerScope,
        PayloadShape: payloadShape,
        Capacity: capacity,
        SenderIDs: senderIDs,
        ReceiverID: receiverID,
        EndsAtOwnerScope: true,
    }
}

func ChannelEvent(
    sequence int,
    kind ChannelEventKind,
    channelID text,
    taskID text,
    endpointID text,
    messageID text,
    location text,
    value text,
) ChannelEventExpectation {
    return ChannelEventExpectation{
        Sequence: sequence,
        Kind: kind,
        ChannelID: channelID,
        TaskID: taskID,
        EndpointID: endpointID,
        MessageID: messageID,
        Location: location,
        Value: value,
    }
}

func SelectRecord(
    sequence int,
    selectID text,
    location text,
    chosenCase int,
    kind SelectChoiceKind,
    referenceID text,
    readySequence int,
    replayReadCount int,
) SelectExpectation {
    return SelectExpectation{
        Sequence: sequence,
        SelectID: selectID,
        Location: location,
        ChosenCase: chosenCase,
        Kind: kind,
        ReferenceID: referenceID,
        ReadySequence: readySequence,
        PersistedBeforeBranch: true,
        RecordCount: 1,
        ReplayReadCount: replayReadCount,
    }
}

