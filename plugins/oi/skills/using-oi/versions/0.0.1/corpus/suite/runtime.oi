        Observations: []text{
            "parent-complete",
            "host:root/0:Done:detached released-success",
            "host:root/1:Failed:DETACHED_FAILURE:released-failure",
            "parent remains Done",
        },
        RunCount: 1,
        JournalReadCount: 1,
    }
}

func HandoffRuntime() LifecycleRuntimeExpectation {
    var reply ScheduleEvent = Event(8, EventKind.Reply, "root", "main.oi:13:5", "continued after value-7")
    return LifecycleRuntimeExpectation{
        Runtime: RuntimeExpectation{
            HarnessInputs: []ArgumentExpectation{Arg("value", "text", "value-7")},
