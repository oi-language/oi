        QuestionCount: 1,
        AuthorityExpanded: false,
        StaticCategory: none,
        StaticPhase: none,
        StaticLocation: none,
        Observations: []text{
            "MaxConcurrency=1; root excluded from Active",
            "Ask Started before suspension",
            "Probe admitted and completed before Answer completion",
            "ActiveSlotReleased=true",
            "Answer completion count=1",
            "Ask queue count=1; resume count=1; question repeat count=0",
            "Reply count=1",
        },
    }
}

