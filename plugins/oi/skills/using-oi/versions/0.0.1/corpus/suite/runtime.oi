            HostEvent(8, HostEffectEventKind.Complete, "root/0", "main.oi:6:12", "user.Answer{Value:approved}; resume-ready"),
            HostEvent(9, HostEffectEventKind.Queue, "root/0", "main.oi:6:12", "resume-ready count=1"),
            HostEvent(10, HostEffectEventKind.Resume, "root/0", "main.oi:6:12", "active=1/1; resume count=1"),
            HostEvent(11, HostEffectEventKind.Complete, "root/0", "main.oi:6:5", "user.Answer{Value:approved}; active=0/1"),
            HostEvent(12, HostEffectEventKind.Reply, "root", "main.oi:23:5", "answer approved after probe-complete"),
        },
        ParentAuthorities: []text{"user.interact", "caller.reply"},
        ChildReachableDemand: []text{"user.interact"},
