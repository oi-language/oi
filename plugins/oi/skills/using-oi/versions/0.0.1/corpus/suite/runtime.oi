func FailureOrderRuntime() RuntimeExpectation {
    return RuntimeExpectation{
        HarnessInputs: []ArgumentExpectation{Arg("change", "text", "change-7")},
        ParentEffectMappings: []EffectMappingExpectation{},
        Launches: []LaunchExpectation{
            Launch(
                "root/0",
                "root",
                0,
                "main.SlowFailure",
                []ArgumentExpectation{Arg("change", "text", "change-7")},
                []text{},
                []EffectMappingExpectation{},
            ),
            Launch(
                "root/1",
                "root",
                1,
                "main.FastFailure",
                []ArgumentExpectation{Arg("change", "text", "change-7")},
                []text{},
                []EffectMappingExpectation{},
            ),
        },
        Schedule: []ScheduleEvent{
            Event(1, EventKind.Admit, "root/0", "main.oi:14:5", ""),
            Event(2, EventKind.Admit, "root/1", "main.oi:15:5", ""),
            Event(3, EventKind.Complete, "root/1", "main.oi:10:5", "HIGHER_SOURCE_FAILURE"),
            Event(4, EventKind.Semantic, "root/0", "main.oi:4:25", "prepared-7"),
            Event(5, EventKind.Semantic, "root/0", "main.oi:5:24", "checked-7"),
            Event(6, EventKind.Complete, "root/0", "main.oi:6:5", "LOWER_SOURCE_FAILURE"),
        },
        ReplyTrace: []ScheduleEvent{},
        EffectTrace: []ScheduleEvent{},
        ContextExcludes: []text{},
        TraceExcludes: []text{},
        JournalExcludes: []text{},
        Completions: []CompletionExpectation{
            Completion("root/1", "failure", "", "HIGHER_SOURCE_FAILURE", "main.oi:10:5", 1),
            Completion("root/0", "failure", "", "LOWER_SOURCE_FAILURE", "main.oi:6:5", 0),
        },
        Failures: []FailureExpectation{
            FailureExpectation{
                TaskID: "root/1",
                Category: "HIGHER_SOURCE_FAILURE",
                Phase: "runtime",
                Location: "main.oi:10:5",
                Detail: "change-7",
                Trace: []text{},
                SourceIndex: 1,
            },
            FailureExpectation{
                TaskID: "root/0",
                Category: "LOWER_SOURCE_FAILURE",
                Phase: "runtime",
                Location: "main.oi:6:5",
                Detail: "checked-7",
                Trace: []text{},
                SourceIndex: 0,
            },
        },
        SelectedFailure: FailureExpectation{
            TaskID: "root/0",
            Category: "LOWER_SOURCE_FAILURE",
            Phase: "runtime",
            Location: "main.oi:6:5",
            Detail: "checked-7",
            Trace: []text{"implicit-join@main.oi:16:1"},
            SourceIndex: 0,
        },
        CancelledTaskIDs: []text{},
        Policy: none,
        JournalReadCount: 2,
    }
}

func CancellationRuntime() RuntimeExpectation {
    return RuntimeExpectation{
        HarnessInputs: []ArgumentExpectation{Arg("change", "text", "change-7")},
        ParentEffectMappings: []EffectMappingExpectation{},
        Launches: []LaunchExpectation{
            Launch(
                "root/0",
                "root",
                0,
                "main.ImmediateFailure",
                []ArgumentExpectation{Arg("change", "text", "change-7")},
                []text{},
                []EffectMappingExpectation{},
            ),
            Launch(
                "root/1",
                "root",
                1,
                "main.SlowWork",
                []ArgumentExpectation{Arg("change", "text", "change-7")},
                []text{},
                []EffectMappingExpectation{},
            ),
        },
        Schedule: []ScheduleEvent{
            Event(1, EventKind.Admit, "root/0", "main.oi:14:5", ""),
            Event(2, EventKind.Admit, "root/1", "main.oi:15:5", ""),
            Event(3, EventKind.Complete, "root/0", "main.oi:4:5", "CANCEL_SOURCE_FAILURE"),
            Event(4, EventKind.Cancel, "root/1", "main.oi:15:5", "TASK_CANCELLED"),
        },
        ReplyTrace: []ScheduleEvent{},
        EffectTrace: []ScheduleEvent{},
        ContextExcludes: []text{},
        TraceExcludes: []text{},
        JournalExcludes: []text{},
        Completions: []CompletionExpectation{
            Completion("root/0", "failure", "", "CANCEL_SOURCE_FAILURE", "main.oi:4:5", 0),
            Completion("root/1", "cancelled", "", "TASK_CANCELLED", "main.oi:15:5", 1),
        },
        Failures: []FailureExpectation{
            FailureExpectation{
                TaskID: "root/0",
                Category: "CANCEL_SOURCE_FAILURE",
                Phase: "runtime",
                Location: "main.oi:4:5",
                Detail: "change-7",
                Trace: []text{},
                SourceIndex: 0,
            },
            FailureExpectation{
                TaskID: "root/1",
                Category: "TASK_CANCELLED",
                Phase: "runtime",
                Location: "main.oi:15:5",
                Detail: "cancelled by root",
                Trace: []text{"cancel@main.oi:16:1"},
                SourceIndex: 1,
            },
        },
        SelectedFailure: FailureExpectation{
            TaskID: "root/0",
            Category: "CANCEL_SOURCE_FAILURE",
            Phase: "runtime",
            Location: "main.oi:4:5",
            Detail: "change-7",
            Trace: []text{"implicit-join@main.oi:16:1"},
            SourceIndex: 0,
        },
        CancelledTaskIDs: []text{"root/1"},
        Policy: none,
        JournalReadCount: 1,
    }
}

