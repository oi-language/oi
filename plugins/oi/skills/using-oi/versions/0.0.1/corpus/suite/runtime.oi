        Calls: []HostEffectCallExpectation{
            HostCall("Fetch", "network.fetch", "main.oi:14:24", 1, 0, 0, 0, 0),
            HostCall("Reply", "caller.reply", "main.oi:23:5", 1, 1, 1, 0, 0),
        },
        Events: []HostEffectEventExpectation{
            HostEvent(1, HostEffectEventKind.Attempt, "root", "main.oi:14:24", "network.fetch mapping absent"),
            HostEvent(2, HostEffectEventKind.CaptureFailure, "root", "main.oi:14:24", "UNMAPPED_EFFECT"),
            HostEvent(3, HostEffectEventKind.Reply, "root", "main.oi:23:5", "cached-7"),
        },
        ParentAuthorities: []text{"caller.reply"},
        ChildReachableDemand: []text{},
        ChildAuthorities: []text{},
        DirectCapture: true,
        CaptureOK: false,
        CapturedCategory: "UNMAPPED_EFFECT",
        FallbackValue: "cached-7",
        Suspends: false,
        ActiveSlotReleased: false,
        OccupiesSubagent: false,
        QuestionCount: 0,
        AuthorityExpanded: false,
        StaticCategory: none,
        StaticPhase: none,
        StaticLocation: none,
        Observations: []text{"capture.Ok=false", "capture.Failure.Category=UNMAPPED_EFFECT", "reply=cached-7"},
    }
}

