package main

type ArgumentExpectation struct {
    Name text
    Shape text
    Value text
}

type EffectMappingExpectation struct {
    EffectName text
    Authority text
}

type LaunchExpectation struct {
    TaskID text
    ParentID text
    SourceIndex int
    Target text
    Arguments []ArgumentExpectation
    Authorities []text
    EffectMappings []EffectMappingExpectation
}

type EventKind enum {
    Admit
    Queue
    Suspend
    Resume
    Semantic
    Complete
    Cancel
    Effect
    Reply
}

type ScheduleEvent struct {
    Sequence int
    Kind EventKind
    TaskID text
    Location text
    Value text
}

type CompletionExpectation struct {
    TaskID text
    State text
    Result text
    Category text
    Location text
    SourceIndex int
}

type FailureExpectation struct {
    TaskID text
    Category text
    Phase text
    Location text
    Detail text
    Trace []text
    SourceIndex int
}

type PolicyExpectation struct {
    RootDepth int
    MaxDepth int
    MaxConcurrency int
    ExpectedActivePeak int
    AdmissionOrder text
    RunCount int
    RejectedParentID text
    RejectedSourceIndex int
    RejectedDepth int
    Category text
    Location text
}

type RuntimeExpectation struct {
    HarnessInputs []ArgumentExpectation
    ParentEffectMappings []EffectMappingExpectation
    Launches []LaunchExpectation
    Schedule []ScheduleEvent
    ReplyTrace []ScheduleEvent
    EffectTrace []ScheduleEvent
    ContextExcludes []text
    TraceExcludes []text
    JournalExcludes []text
    Completions []CompletionExpectation
    Failures []FailureExpectation
    SelectedFailure FailureExpectation?
    CancelledTaskIDs []text
    Policy PolicyExpectation?
    JournalReadCount int
}

func Arg(name text, shape text, value text) ArgumentExpectation {
    return ArgumentExpectation{Name: name, Shape: shape, Value: value}
}

func Mapping(effectName text, authority text) EffectMappingExpectation {
    return EffectMappingExpectation{EffectName: effectName, Authority: authority}
}

func Launch(
    taskID text,
    parentID text,
    sourceIndex int,
    target text,
    arguments []ArgumentExpectation,
    authorities []text,
    mappings []EffectMappingExpectation,
) LaunchExpectation {
    return LaunchExpectation{
        TaskID: taskID,
        ParentID: parentID,
        SourceIndex: sourceIndex,
        Target: target,
        Arguments: arguments,
        Authorities: authorities,
        EffectMappings: mappings,
    }
}

func Event(
    sequence int,
    kind EventKind,
    taskID text,
    location text,
    value text,
) ScheduleEvent {
    return ScheduleEvent{
        Sequence: sequence,
        Kind: kind,
        TaskID: taskID,
        Location: location,
        Value: value,
    }
}

func Completion(
    taskID text,
    state text,
    result text,
    category text,
    location text,
    sourceIndex int,
) CompletionExpectation {
    return CompletionExpectation{
        TaskID: taskID,
        State: state,
        Result: result,
        Category: category,
        Location: location,
        SourceIndex: sourceIndex,
    }
}

func OiContinueRuntime() RuntimeExpectation {
    var reply ScheduleEvent = Event(6, EventKind.Reply, "root", "main.oi:20:5", "combined-7")
    return RuntimeExpectation{
        HarnessInputs: []ArgumentExpectation{
            Arg("change", "text", "change-7"),
            Arg("document", "text", "document-7"),
        },
        ParentEffectMappings: []EffectMappingExpectation{Mapping("Reply", "caller.reply")},
        Launches: []LaunchExpectation{
            Launch(
                "root/0",
                "root",
                0,
                "main.Review",
                []ArgumentExpectation{Arg("change", "text", "change-7")},
                []text{},
                []EffectMappingExpectation{},
            ),
        },
        Schedule: []ScheduleEvent{
            Event(1, EventKind.Admit, "root/0", "main.oi:17:15", ""),
            Event(2, EventKind.Semantic, "root", "main.oi:18:24", "summary-7"),
            Event(3, EventKind.Semantic, "root/0", "main.oi:8:12", "review-7"),
            Event(4, EventKind.Complete, "root/0", "main.oi:8:12", "review-7"),
            Event(5, EventKind.Semantic, "root", "main.oi:4:12", "combined-7"),
            reply,
        },
        ReplyTrace: []ScheduleEvent{reply},
        EffectTrace: []ScheduleEvent{},
        ContextExcludes: []text{},
        TraceExcludes: []text{},
        JournalExcludes: []text{},
        Completions: []CompletionExpectation{
            Completion("root/0", "success", "review-7", "none", "main.oi:8:12", 0),
        },
        Failures: []FailureExpectation{},
        SelectedFailure: none,
        CancelledTaskIDs: []text{},
        Policy: none,
        JournalReadCount: 1,
    }
}

func OiDiscardRuntime() RuntimeExpectation {
    var parentTrace ScheduleEvent = Event(
        2,
        EventKind.Effect,
        "root",
        "main.oi:20:5",
        "ParentTrace:parent",
    )
    var childTrace ScheduleEvent = Event(
        3,
        EventKind.Effect,
        "root/0",
        "main.oi:14:5",
        "ChildTrace:change-7",
    )
    return RuntimeExpectation{
        HarnessInputs: []ArgumentExpectation{Arg("change", "text", "change-7")},
        ParentEffectMappings: []EffectMappingExpectation{
            Mapping("ChildTrace", "caller.child-trace"),
            Mapping("ParentTrace", "caller.parent-trace"),
        },
        Launches: []LaunchExpectation{
            Launch(
                "root/0",
                "root",
                0,
                "main.Review",
                []ArgumentExpectation{Arg("change", "text", "change-7")},
                []text{"caller.child-trace"},
                []EffectMappingExpectation{Mapping("ChildTrace", "caller.child-trace")},
            ),
        },
        Schedule: []ScheduleEvent{
            Event(1, EventKind.Admit, "root/0", "main.oi:19:5", ""),
            parentTrace,
            childTrace,
            Event(4, EventKind.Semantic, "root/0", "main.oi:15:12", "review-7"),
            Event(5, EventKind.Complete, "root/0", "main.oi:15:12", "review-7"),
        },
        ReplyTrace: []ScheduleEvent{},
        EffectTrace: []ScheduleEvent{parentTrace, childTrace},
        ContextExcludes: []text{"ParentTrace", "caller.parent-trace"},
        TraceExcludes: []text{},
        JournalExcludes: []text{},
        Completions: []CompletionExpectation{
            Completion("root/0", "success", "review-7", "none", "main.oi:15:12", 0),
        },
        Failures: []FailureExpectation{},
        SelectedFailure: none,
        CancelledTaskIDs: []text{},
        Policy: none,
        JournalReadCount: 1,
    }
}

