func ActualInvocationProofCase() model.Case {
    operations := []model.OperationExpectation{
        Operation(execution.OperationKind.Allocation, execution.OperationStatus.Completed, "main.oi:14:5"),
        Operation(execution.OperationKind.Reply, execution.OperationStatus.Started, "main.oi:14:5"),
        Operation(execution.OperationKind.Reply, execution.OperationStatus.Completed, "main.oi:14:5"),
    }
    reply := Reply(
        "main.InvocationReply",
        "4659481977f915fd774d9453f8557556b29fc93e19a7e480010b00dcf4086652",
        "InvocationReply{Challenge: \"proof-002\", Answer: \"invoked\"}",
    )
    return RuntimeCaseAt(
        "actual-invocation-proof",
        "docs/language/cases/0.0.2/actual-invocation-proof",
        model.Status.Pass,
        "none",
        reply,
        Receipt(execution.TerminalStatus.Completed, none, operations),
    )
}

func Cases(
    runtimeCases []model.Case,
) []model.Case {
    cases := CompileCases()
    cases = append(cases, HelloCase())
    for item in runtimeCases {
        cases = append(cases, item)
    }
    cases = append(cases, RegistryAnalysisCase())
    cases = append(cases, MultiRootBootstrapCase())
    cases = append(cases, ActualInvocationProofCase())
    return cases
}
