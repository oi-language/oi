package catalog

import "std/execution"
import "oi/corpus/0.0.2/suite/model"

func CompileCase(id text, target text, status model.Status, category text) model.Case {
    return model.Case{
        ID: id,
        Target: target,
        Phase: model.Phase.Compile,
        Status: status,
        Category: category,
        Reply: none,
        Receipt: none,
    }
}

func Operation(
    kind execution.OperationKind,
    status execution.OperationStatus,
    location text,
) model.OperationExpectation {
    return model.OperationExpectation{
        Kind: kind,
        Status: status,
        Location: location,
    }
}

func Reply(typeName text, digest text, value text) model.ReplyIdentity {
    return model.ReplyIdentity{
        Type: typeName,
        Digest: digest,
        Value: value,
    }
}

func Receipt(
    terminal execution.TerminalStatus,
    failureCategory text?,
    operations []model.OperationExpectation,
) model.ReceiptExpectation {
    return model.ReceiptExpectation{
        Terminal: terminal,
        FailureCategory: failureCategory,
        Operations: operations,
    }
}

func RuntimeCase(
    id text,
    target text,
    status model.Status,
    category text,
    reply model.ReplyIdentity?,
    receipt model.ReceiptExpectation,
) model.Case {
    return model.Case{
        ID: id,
        Target: target,
        Phase: model.Phase.Runtime,
        Status: status,
        Category: category,
        Reply: reply,
        Receipt: receipt,
    }
}

func CompileCases() []model.Case {
    return []model.Case{
        CompileCase("types", "corpus/valid/types", model.Status.Pass, "none"),
        CompileCase("semantic", "corpus/valid/semantic", model.Status.Pass, "none"),
        CompileCase("import", "corpus/valid/import", model.Status.Pass, "none"),
        CompileCase("entry-effect", "corpus/valid/entry-effect", model.Status.Pass, "none"),
        CompileCase("core-standard", "corpus/valid/core-standard", model.Status.Pass, "none"),
        CompileCase("control", "corpus/valid/control", model.Status.Pass, "none"),
        CompileCase("oi-effect", "corpus/invalid/oi-effect", model.Status.StaticFail, "OI_EFFECT_FORBIDDEN"),
        CompileCase("oi-anonymous", "corpus/invalid/oi-anonymous", model.Status.StaticFail, "OI_REQUIRES_NAMED_FUNCTION"),
        CompileCase("nested-semantic", "corpus/invalid/nested-semantic", model.Status.StaticFail, "NESTED_SEMANTIC_EXPRESSION"),
        CompileCase("implicit-named-conversion", "corpus/invalid/implicit-named-conversion", model.Status.StaticFail, "IMPLICIT_NAMED_CONVERSION"),
        CompileCase("imperative-semantic", "corpus/invalid/imperative-semantic", model.Status.StaticFail, "IMPERATIVE_SEMANTIC_BLOCK"),
        CompileCase("detach-endpoint", "corpus/invalid/detach-endpoint", model.Status.StaticFail, "ENDPOINT_SCOPE_ESCAPE"),
        CompileCase("handoff-endpoint", "corpus/invalid/handoff-endpoint", model.Status.StaticFail, "ENDPOINT_SCOPE_ESCAPE"),
        CompileCase("channel-handle-payload", "corpus/invalid/channel-handle-payload", model.Status.StaticFail, "RUNTIME_HANDLE_PAYLOAD"),
        CompileCase("multiple-receivers", "corpus/invalid/multiple-receivers", model.Status.StaticFail, "RECEIVER_ALREADY_MOVED"),
        CompileCase("channel-zero", "corpus/invalid/channel-zero", model.Status.StaticFail, "INVALID_CHANNEL_CAPACITY"),
        CompileCase("entry-return-value", "corpus/invalid/entry-return-value", model.Status.StaticFail, "ENTRY_RETURN_VALUE"),
        CompileCase("missing-semantic-type", "corpus/invalid/missing-semantic-type", model.Status.StaticFail, "MISSING_SEMANTIC_TYPE"),
        CompileCase("entry-result", "corpus/invalid/entry-result", model.Status.StaticFail, "ENTRY_RESULT_FORBIDDEN"),
        CompileCase("entry-call", "corpus/invalid/entry-call", model.Status.StaticFail, "ENTRY_NOT_CALLABLE"),
        CompileCase("missing-entry", "corpus/invalid/missing-entry", model.Status.StaticFail, "MISSING_ENTRY"),
        CompileCase("hidden-optional-effect", "corpus/invalid/hidden-optional-effect", model.Status.StaticFail, "UNMAPPED_EFFECT"),
    }
}

func HelloCase() model.Case {
    operations := []model.OperationExpectation{
        Operation(execution.OperationKind.Allocation, execution.OperationStatus.Completed, "main.oi:4:20"),
        Operation(execution.OperationKind.Judgment, execution.OperationStatus.Started, "main.oi:4:20"),
        Operation(execution.OperationKind.Judgment, execution.OperationStatus.Completed, "main.oi:4:20"),
        Operation(execution.OperationKind.Allocation, execution.OperationStatus.Completed, "main.oi:13:5"),
        Operation(execution.OperationKind.Reply, execution.OperationStatus.Started, "main.oi:13:5"),
        Operation(execution.OperationKind.Reply, execution.OperationStatus.Completed, "main.oi:13:5"),
    }
    reply := Reply(
        "main.Greeting",
        "d9383c2cbeb28641ae48bc1fa61bd78704faa387491411bb7f457c4fd7e62d60",
        "Greeting(\"Hello, Oi!\")",
    )
    return RuntimeCase(
        "hello-world",
        "examples/hello-world",
        model.Status.Pass,
        "none",
        reply,
        Receipt(execution.TerminalStatus.Completed, none, operations),
    )
}

func Cases(
    runtimeCases []model.Case,
) []model.Case {
    cases := CompileCases()
    cases = append(cases, HelloCase())
    for item in runtimeCases {
        cases = append(cases, item)
    }
    return cases
}
