        Operation(execution.OperationKind.Iteration, execution.OperationStatus.Started, "main.oi:20:5"),
        Operation(execution.OperationKind.Iteration, execution.OperationStatus.Completed, "main.oi:20:5"),
        Operation(execution.OperationKind.Allocation, execution.OperationStatus.Completed, "main.oi:24:5"),
        Operation(execution.OperationKind.Iteration, execution.OperationStatus.Started, "main.oi:24:5"),
        Operation(execution.OperationKind.Iteration, execution.OperationStatus.Completed, "main.oi:24:5"),
        Operation(execution.OperationKind.Allocation, execution.OperationStatus.Completed, "main.oi:42:5"),
        Operation(execution.OperationKind.Reply, execution.OperationStatus.Started, "main.oi:42:5"),
        Operation(execution.OperationKind.Reply, execution.OperationStatus.Completed, "main.oi:42:5"),
    }
    reply := Reply(
        "main.BootstrapReply",
        "0ae4f3bb645b9b17b01caf6792433d89c5c42ab5d8d1a4690a5a498594c89a09",
