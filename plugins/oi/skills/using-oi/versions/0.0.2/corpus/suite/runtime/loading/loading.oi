package loading

import "std/diagnostic"
import "std/execution"
import "oi/corpus/0.0.2/suite/catalog"
import "oi/corpus/0.0.2/suite/model"
import "oi/corpus/0.0.2/suite/runtime/legacy"

func PresentText(value text?) text {
    return [the exact present text in {value}]
}

func CompileSourcesMatch(actual model.CompileObservation, evidence model.TargetEvidence) bool {
    if actual.LanguageVersion == none || actual.Module == none || actual.SourceCount != len(actual.Sources) ||
        evidence.SourceCount != len(evidence.Sources) || actual.SourceCount != evidence.SourceCount ||
        actual.SourceCharacters != evidence.SourceCharacters || PresentText(actual.LanguageVersion) != "0.0.2" ||
        evidence.LanguageVersion != "Oi 0.0.2" ||
        PresentText(actual.Module) != evidence.Module {
        return false
    }
    var characters int = 0
    for index, source in actual.Sources {
        var observed execution.ArtifactIdentity = evidence.Sources[index]
        characters = characters + source.Characters
        if text(source.Path) != observed.Path || source.Bytes != observed.Bytes || source.Characters != observed.Characters ||
            source.SHA256 != observed.SHA256 {
            return false
        }
    }
    return characters == actual.SourceCharacters
}

func Integrity(caseValue model.Case, compileValue model.CompileObservation, observation model.RuntimeObservation) bool {
    return [true exactly when {compileValue} is the trusted direct loader/compiler report for {caseValue.Target} and its exact language, module, source count/characters,
        and ordered Source identities are cross-bound to {observation.Evidence}; {caseValue.Target}, {observation.Target}, and {observation.Evidence.Target} are the same normalized version-root-relative target;
        {observation.Evidence} verifies structured entry, manifest order, ordered artifacts, and ordered decoded project source identities,
        and its ManifestDigest and SourceDigest are recomputed from those protected materials by frozen runtime/execution.md framing;
        {observation.Receipt} has those exact language, module, entry, manifest, artifact, input, mapping, authority, policy, and character fields;
        every source-ordered input evidence has exact position/name and a protected canonical typed value that projects to the same-index public receipt input;
        every structured mapping frames effect module/path/name, ordered signature parameters and result with exact canonical Type frames,
        authorities, and host mapping, then recomputes its public Identity fields and Digest;
        authorities are canonical and recompute AuthoritiesIdentity; optional policy frames exact mode and ordered named limits around its protected canonical value;
        InputsDigest, MappingsDigest, authority identity, and policy identity are recomputed exactly, including optional presence;
        budgets are name-byte-ordered with exact nonnegative actual/limit values and bind the public loaded/project character fields;
        {observation.ReceiptCanonical} is the exact frozen receipt frame recomputed from those materials, budgets, and public receipt fields;
        {observation.Journal}.Policy equals the protected evidence policy value and public operations equal journal entries in order;
        every operation input, result, failure, and present Reply digest is recomputed from the journal's protected canonical typed values;
        direct-ID creation is limited to TaskLaunch, ChannelCreate, MessageCommit, and Select; every allocated oN has one leading Allocation record and then one fixed boundary Kind;
        TaskCompletion and DetachNotification use owner/registry oN allocations, all other first operation IDs obey their frozen rules, and Started transitions have exactly one later terminal transition with
        unchanged kind, location, and inputs despite permitted interleaving, and no terminal transition is followed by the same ID;
        Indeterminate is only an external Effect; Cancelled is only an already-Started Effect's host-controlled cancellation acknowledgement on that ID
        or a cancellable task, detach, or lifecycle boundary; ordinary Effect failure remains Failed,
        Completed receipt terminal has no Failure; any causal root-ending Failed, Indeterminate, or Cancelled operation projects Failed with its exact Failure;
        direct program execution never projects Stopped; all operation outputs and failures match their states;
        present or absent Reply fields match {observation.Reply} exactly, including its protected canonical typed value]
}

func AttachedCancellation() model.Case {
    operations := legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:14:5")
    operations = legacy.Append(operations, legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:15:5"))
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.Join, "main.oi:16:1"))
    operations = legacy.Append(operations, legacy.Terminate(execution.OperationKind.TaskCompletion, execution.OperationStatus.Failed, "main.oi:4:5"))
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.TaskCancel, "main.oi:15:5"))
    operations = legacy.Append(operations, legacy.Terminate(execution.OperationKind.TaskCompletion, execution.OperationStatus.Cancelled, "main.oi:15:5"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.TaskCancel, execution.OperationStatus.Completed, "main.oi:15:5"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.Join, execution.OperationStatus.Failed, "main.oi:16:1"))
    return legacy.Failure("attached-cancellation", "CANCEL_SOURCE_FAILURE", operations)
}

func AttachedFailureOrder() model.Case {
    operations := legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:14:5")
    operations = legacy.Append(operations, legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:15:5"))
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.Join, "main.oi:16:1"))
    operations = legacy.Append(operations, legacy.Terminate(execution.OperationKind.TaskCompletion, execution.OperationStatus.Failed, "main.oi:10:5"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Judgment, "main.oi:4:25"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Judgment, "main.oi:5:24"))
    operations = legacy.Append(operations, legacy.Terminate(execution.OperationKind.TaskCompletion, execution.OperationStatus.Failed, "main.oi:6:5"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.Join, execution.OperationStatus.Failed, "main.oi:16:1"))
    return legacy.Failure("attached-failure-order", "LOWER_SOURCE_FAILURE", operations)
}

func CapacityPressure() model.Case {
    operations := legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:18:21")
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.Await, "main.oi:18:15"))
    operations = legacy.Append(operations, legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:8:19"))
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.Await, "main.oi:9:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Judgment, "main.oi:4:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.TaskCompletion, "main.oi:4:12"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.Await, execution.OperationStatus.Completed, "main.oi:9:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.TaskCompletion, "main.oi:9:12"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.Await, execution.OperationStatus.Completed, "main.oi:18:15"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Reply, "main.oi:19:5"))
    reply := catalog.Reply("text", "6eab34715fb3f3403e037004aed0241c97852d48e9a1d614745f37fdaa7839b1", "grandchild-pressure-7")
    return legacy.Pass("capacity-pressure", reply, operations)
}

func DetachNotification() model.Case {
    operations := legacy.Complete(execution.OperationKind.Judgment, "main.oi:22:26")
    operations = legacy.Append(operations, legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:22:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Detach, "main.oi:22:5"))
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.Effect, "main.oi:4:13"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Judgment, "main.oi:23:26"))
    operations = legacy.Append(operations, legacy.Atomic(execution.OperationKind.TaskLaunch, "main.oi:23:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Detach, "main.oi:23:5"))
    operations = legacy.Append(operations, legacy.Begin(execution.OperationKind.Effect, "main.oi:4:13"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Reply, "main.oi:24:5"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.Effect, execution.OperationStatus.Completed, "main.oi:4:13"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.Judgment, "main.oi:8:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.TaskCompletion, "main.oi:8:12"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.DetachNotification, "main.oi:8:12"))
    operations = legacy.Append(operations, legacy.End(execution.OperationKind.Effect, execution.OperationStatus.Completed, "main.oi:4:13"))
    operations = legacy.Append(operations, legacy.Terminate(execution.OperationKind.TaskCompletion, execution.OperationStatus.Failed, "main.oi:6:9"))
    operations = legacy.Append(operations, legacy.Complete(execution.OperationKind.DetachNotification, "main.oi:6:9"))
    reply := catalog.Reply("text", "7edcd100360c832ea3452faf4a4219201432282ee0b8a84d4af8d3cddec955c6", "parent-complete")
    return legacy.Pass("detach-notification", reply, operations)
}

func Cases() []model.Case {
    return []model.Case{
        catalog.CompileCase("manifest", "corpus/valid/manifest", model.Status.Pass, "none", []diagnostic.Diagnostic{}),
        catalog.CompileCase(
            "missing-source-manifest",
            "corpus/invalid/missing-source-manifest",
            model.Status.StaticFail,
            "MISSING_SOURCE_MANIFEST",
            []diagnostic.Diagnostic{
                catalog.Diagnostic("MISSING_SOURCE_MANIFEST", "module", "oi.mod:1:1", "source manifest required"),
            },
        ),
        catalog.CompileCase(
            "unsorted-source-manifest",
            "corpus/invalid/unsorted-source-manifest",
            model.Status.StaticFail,
            "SOURCE_MANIFEST_ORDER",
            []diagnostic.Diagnostic{
                catalog.Diagnostic("SOURCE_MANIFEST_ORDER", "module", "oi.mod:1:1", "auxiliary/auxiliary.oi"),
            },
        ),
        AttachedCancellation(),
        AttachedFailureOrder(),
        CapacityPressure(),
        DetachNotification(),
    }
}
