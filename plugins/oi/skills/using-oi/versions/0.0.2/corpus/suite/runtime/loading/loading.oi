func Cases() []model.Case {
    return []model.Case{
        catalog.CompileCase("manifest", "corpus/valid/manifest", model.Status.Pass, "none"),
        catalog.CompileCase(
            "missing-source-manifest",
            "corpus/invalid/missing-source-manifest",
            model.Status.StaticFail,
            "MISSING_SOURCE_MANIFEST",
        ),
        catalog.CompileCase(
            "unsorted-source-manifest",
            "corpus/invalid/unsorted-source-manifest",
            model.Status.StaticFail,
            "SOURCE_MANIFEST_ORDER",
        ),
        AttachedCancellation(),
        AttachedFailureOrder(),
        CapacityPressure(),
        DetachNotification(),
    }
}
